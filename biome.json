{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "extends": ["./packages/biome-config/biome.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/.astro",
      "!**/node_modules",
      "!packages/contracts/openapi",
      "!video",
      "!.codegraph",
      "!.impeccable"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
