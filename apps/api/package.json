{
  "name": "@ancla/api",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "private": true,
  "scripts": {
    "test": "bun test",
    "check-types": "tsc --noEmit -p tsconfig.json",
