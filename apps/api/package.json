    "better-auth": "1.7.25",
    "hono": "4.13.19",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/nodemailer": "8.0.2",
    "dotenv": "^16.6.1",
    "typescript": "5.7.3"
  }
}
