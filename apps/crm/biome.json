{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!desing", "!.agents"]
  },
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true,
      "correctness": "off",
      "performance": "warn",
      "style": "warn",
      "security": {
        "recommended": true,
        "noSecrets": "off"
      },
      "suspicious": {
        "recommended": true,
        "noArrayIndexKey": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["components/ui/**"],
      "linter": {
        "rules": {
          "a11y": "off",
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "parser": {
      "jsxEverywhere": false
    }
  },
  "css": {
    "parser": {
      "allowWrongLineComments": true,
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "plugins": ["./biome-plugins/no-long-inline-classname.grit"]
}
