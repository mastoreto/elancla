---
import AnchorMark from 'src/components/AnchorMark.astro';
import Button from 'src/components/ui/Button.astro';
import {
  embedUrl,
  getLiveStream,
  getSermons,
  getSeries,
  watchUrl,
} from 'src/data/youtube';
import type { Locale } from 'src/i18n/config';
import { getHtmlLang, localizePath } from 'src/i18n/utils';
import { getMessages } from 'src/i18n/messages';
import Layout from 'src/layouts/Layout.astro';
import { getSiteConfig } from '@ancla/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getMessages(locale).sermonsPage;
const site = Astro.locals.site ?? (await getSiteConfig());
const path = localizePath('/sermones', locale);

// ?serie=<playlistId> filters the list; only ids of the channel's own playlists are accepted.
const [live, latestList, series] = await Promise.all([getLiveStream(), getSermons(), getSeries()]);
const selected = series.find((serie) => serie.id === Astro.url.searchParams.get('serie'));
const sermons = selected ? await getSermons(selected.id) : latestList;
const latest = latestList[0];

const dateFormat = new Intl.DateTimeFormat(getHtmlLang(locale), {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Montevideo',
});
const metaOf = (sermon: { publishedAt: string; duration: string }) =>
  `${dateFormat.format(new Date(sermon.publishedAt)).replace(/\./g, '')} · ${sermon.duration}`;

const initialId = live?.id ?? latest?.id;
const initialTitle = live?.title ?? latest?.title ?? copy.player.emptyTitle;
const PAGE_SIZE = 9;
const subscribeUrl = `${site.social.youtube ?? 'https://youtube.com'}?sub_confirmation=1`;
const chips = [
  { label: copy.list.all, href: `${path}#sermones`, on: !selected },
  ...series.map((serie) => ({
    label: serie.title,
    href: `${path}?serie=${serie.id}#sermones`,
    on: serie.id === selected?.id,
  })),
];
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  keywords={copy.seo.keywords}
  breadcrumbs={[
    { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
    { name: copy.breadcrumbs.current, url: path },
  ]}
  locale={locale}
>
  <div class="ln sm">
    <section
      class="sm-hero sm-pad"
      data-sermons-hero
      data-live={live ? 'true' : 'false'}
      data-latest-id={latest?.id ?? ''}
      data-latest-title={latest?.title ?? ''}
      data-latest-meta={latest ? metaOf(latest) : ''}
      data-live-meta={copy.player.liveMeta}
      data-playing-chip={copy.player.playingChip}
      data-latest-chip={copy.player.latestChip}
    >
      <div class="sm-hero__text">
        <div class="sm-hero__block" data-live-only>
          <span class="sm-badge sm-rise"><i class="sm-dot" aria-hidden="true"></i>{copy.hero.live.badge}</span>
          <h1 class="ln-h sm-hero__title sm-rise" style="--d: .15s">{copy.hero.live.titleBefore}<em>{copy.hero.live.titleEmphasis}</em></h1>
          <p class="sm-lead sm-rise" style="--d: .3s">{copy.hero.live.body}</p>
          <div class="sm-hero__cta sm-rise" style="--d: .45s">
            <Button href={live ? watchUrl(live.id) : site.social.youtube} arrow target="_blank" rel="noopener" data-live-link>{copy.hero.live.primaryCta}</Button>
            <Button href="#sermones" variant="ghost">{copy.hero.live.secondaryCta}</Button>
          </div>
        </div>
        <div class="sm-hero__block" data-idle-only>
          <span class="ln-eyebrow sm-rise">{copy.hero.idle.eyebrow}</span>
          <h1 class="ln-h sm-hero__title sm-rise" style="--d: .15s">{copy.hero.idle.titleBefore}<em>{copy.hero.idle.titleEmphasis}</em>{copy.hero.idle.titleAfter}</h1>
          <p class="sm-lead sm-rise" style="--d: .3s">{copy.hero.idle.body}</p>
          <div class="sm-hero__cta sm-rise" style="--d: .45s">
            <Button href="#sermones" arrow>{copy.hero.idle.primaryCta}</Button>
            <Button href={subscribeUrl} variant="ghost" target="_blank" rel="noopener">{copy.hero.idle.secondaryCta}</Button>
          </div>
        </div>
      </div>

      <div class="sm-player sm-rise" style="--d: .5s" id="vivo">
        <div class="sm-screen" id="reproductor">
          {
            initialId ? (
              <iframe
                data-player
                src={embedUrl(initialId)}
                title={copy.player.iframeTitle}
                loading="lazy"
                allow="accelerometer; encrypted-media; picture-in-picture; fullscreen"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            ) : (
              <div class="sm-screen__empty">
                <AnchorMark id="sm-empty" outline={false} class="sm-screen__anchor" />
                <b>{copy.player.emptyTitle}</b>
                <span>{copy.player.emptyBody}</span>
              </div>
            )
          }
          <span class="sm-chip sm-chip--live" data-live-only><i class="sm-dot" aria-hidden="true"></i>{copy.player.liveChip}</span>
          <span class="sm-chip" data-idle-only data-player-chip>{copy.player.latestChip}</span>
        </div>
        {
          initialId && (
            <div class="sm-player__info">
              <span class="sm-player__eyebrow" data-player-eyebrow>{live || !latest ? copy.player.liveMeta : metaOf(latest)}</span>
              <b data-player-title>{initialTitle}</b>
              <span class="sm-next" data-idle-only>{copy.player.nextService}</span>
            </div>
          )
        }
      </div>
    </section>

    <section id="sermones" class="sm-section sm-pad" data-sermons-list data-page-size={PAGE_SIZE}>
      <span class="ln-eyebrow">{copy.list.eyebrow}</span>
      <h2 class="ln-h sm-title">{copy.list.title}<em>{copy.list.emphasis}</em></h2>
      <div class="sm-tools">
        {
          chips.length > 1 && (
            <div class="sm-chips">
              {chips.map((chip) => (
                <a href={chip.href} class="ln-chip" data-on={chip.on} aria-current={chip.on ? 'page' : undefined}>{chip.label}</a>
              ))}
            </div>
          )
        }
        <label class="sm-search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4 4"></path></svg>
          <span class="sr-only">{copy.list.searchLabel}</span>
          <input type="search" placeholder={copy.list.searchPlaceholder} data-sermons-search />
        </label>
      </div>

      {sermons.length === 0 && <p class="sm-empty">{copy.list.empty}</p>}
      <p class="sm-empty" data-sermons-empty hidden>{copy.list.noResults}</p>
      <div class="sm-grid">
        {
          sermons.map((sermon, index) => (
            <a
              href={watchUrl(sermon.id)}
              class="sm-card"
              target="_blank"
              rel="noopener"
              hidden={index >= PAGE_SIZE}
              data-sermon-card
              data-video-id={sermon.id}
              data-title={sermon.title}
              data-meta={metaOf(sermon)}
            >
              <div class="sm-card__art">
                <img class="ln-photo" src={`https://i.ytimg.com/vi/${sermon.id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />
                <span class="sm-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg></span>
                <span class="sm-card__dur">{sermon.duration}</span>
              </div>
              <div class="sm-card__body">
                <span class="sm-card__meta">{dateFormat.format(new Date(sermon.publishedAt)).replace(/\./g, '')}</span>
                <h3 class="sm-card__title">{sermon.title}</h3>
                <span class="sm-card__by">{copy.list.watch} ↗</span>
              </div>
            </a>
          ))
        }
      </div>
      {
        sermons.length > PAGE_SIZE && (
          <div class="sm-more">
            <Button variant="ghost" data-sermons-more>{copy.list.more}</Button>
          </div>
        )
      }
    </section>

    {
      series.length > 0 && (
        <section class="sm-section sm-pad">
          <div class="sm-series">
            <div class="sm-series__head">
              <div>
                <span class="ln-eyebrow">{copy.series.eyebrow}</span>
                <h3 class="ln-h sm-series__title">{copy.series.title}<em>{copy.series.emphasis}</em></h3>
              </div>
              <p>{copy.series.body}</p>
            </div>
            <div class="sm-series__grid">
              {series.map((serie) => (
                <a href={`${path}?serie=${serie.id}#sermones`} class="sm-serie">
                  <small>{serie.count === 1 ? copy.series.countOne : copy.series.count.replace('{n}', String(serie.count))}</small>
                  <b>{serie.title}</b>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="sm-section sm-pad">
      <div class="sm-cta">
        <AnchorMark id="sm-cta" outline={false} class="sm-cta__anchor" />
        <div class="sm-cta__text">
          <span class="ln-eyebrow">{copy.cta.eyebrow}</span>
          <h3 class="ln-h sm-cta__title">{copy.cta.title}</h3>
          <p>{copy.cta.body}</p>
        </div>
        <div class="sm-cta__actions">
          <Button href={subscribeUrl} variant="dark" target="_blank" rel="noopener">{copy.cta.subscribe}</Button>
        </div>
      </div>
    </section>
    <div class="sm-end"></div>
  </div>
</Layout>

<script>
  import { initSermons } from 'src/scripts/sermons';
  document.addEventListener('astro:page-load', initSermons);
</script>
