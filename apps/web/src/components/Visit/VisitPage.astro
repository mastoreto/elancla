---
import Button from 'src/components/ui/Button';
import { getSiteConfig } from '@ancla/content';
import type { Locale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { getHtmlLang, localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout.astro';
import { buildFaqLd, buildServiceEventLd, mapLink } from 'src/utils/seo';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getMessages(locale).visit;
const sunday = getMessages(locale).landing.sunday;
const site = Astro.locals.site ?? (await getSiteConfig());
const path = localizePath('/visitanos', locale);
const coords = `${site.geo.latitude},${site.geo.longitude}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${coords}`;
const embedUrl = `https://www.google.com/maps?ll=${coords}&z=17&output=embed`;

const faqLd = buildFaqLd(copy.faq.items);
const jsonLd = [
  ...(faqLd ? [faqLd] : []),
  buildServiceEventLd({
    name: copy.schema.eventName,
    description: copy.schema.eventDescription,
    url: new URL(path, site.url).toString(),
    site,
    language: getHtmlLang(locale),
  }),
];
const WRAP = 'mx-auto max-w-275 px-gutter';
const SECTION = `${WRAP} flex flex-col gap-5 pt-[clamp(3rem,7vw,5.5rem)]`;
const H2 = 'ln-h max-w-[22ch] text-[clamp(1.8rem,4vw,3rem)] text-balance';
const LEAD = 'm-0 max-w-[56ch] text-[1.125rem] leading-[1.6] text-obra-ink-soft';
const ACTIONS = 'flex flex-wrap items-center gap-x-4 gap-y-3';
const ITEM_TITLE = 'mx-0 mt-0 mb-1 font-obra-sans-bold text-[1.125rem]';
const ITEM_TEXT = 'm-0 leading-[1.55] text-obra-ink-soft';
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  keywords={copy.seo.keywords}
  breadcrumbs={[
    { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
    { name: copy.breadcrumbs.current, url: path },
  ]}
  jsonLd={jsonLd}
  locale={locale}
>
  <div class="ln bg-obra-paper pt-[clamp(6rem,12vw,9rem)] pb-[clamp(3rem,8vw,6rem)]">
    <section class:list={[WRAP, 'flex flex-col items-start gap-5']}>
      <nav class="flex gap-2 text-[0.875rem] text-obra-ink-soft" aria-label="Breadcrumb">
        <a class="text-inherit" href={localizePath('/', locale)}>{copy.breadcrumbs.home}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{copy.breadcrumbs.current}</span>
      </nav>
      <span class="ln-eyebrow">{copy.hero.eyebrow}</span>
      <h1 class="ln-h text-[clamp(2.6rem,7vw,5rem)]">{copy.hero.title}</h1>
      <p class={LEAD}>{copy.hero.body}</p>
      <div class={ACTIONS}>
        <Button href={directionsUrl} arrow target="_blank" rel="noopener">{copy.hero.cta}</Button>
      </div>
    </section>

    <section class={SECTION} aria-labelledby="vs-when">
      <span class="ln-eyebrow">{copy.when.eyebrow}</span>
      <h2 id="vs-when" class={H2}>{copy.when.title}</h2>
      <ol class="m-0 flex max-w-180 list-none flex-col gap-2 p-0">
        {sunday.rows.map((row) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-4 border-t border-obra-mist py-4 max-[800px]:grid-cols-[4.25rem_1fr]">
            <b class="font-obra-serif text-[2rem] leading-none text-obra-red">{row.time}</b>
            <div>
              <h3 class={ITEM_TITLE}>{row.title}</h3>
              <p class={ITEM_TEXT}>{row.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section
      class:list={[
        WRAP,
        'grid grid-cols-[1fr_1fr] flex-col items-stretch gap-[clamp(1.5rem,4vw,3rem)] pt-[clamp(3rem,7vw,5.5rem)] max-[800px]:grid-cols-[1fr]',
      ]}
      aria-labelledby="vs-where"
    >
      <div class="flex min-w-0 flex-col gap-5">
        <span class="ln-eyebrow">{copy.where.eyebrow}</span>
        <h2 id="vs-where" class={H2}>{copy.where.title}</h2>
        <p class={LEAD}>{site.address.street}, {site.address.city} {site.address.postalCode}. {copy.where.body}</p>
        <div class={ACTIONS}>
          <Button href={directionsUrl} arrow target="_blank" rel="noopener">{copy.where.cta}</Button>
          <a href={mapLink(site)} class="font-obra-sans-bold text-obra-ink" target="_blank" rel="noopener">Google Maps</a>
        </div>
      </div>
      <iframe
        class="h-full min-h-80 w-full rounded-3xl border-0 bg-obra-mist" src={embedUrl} title={copy.where.mapLabel} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>

    <section class={SECTION} aria-labelledby="vs-expect">
      <span class="ln-eyebrow">{copy.expect.eyebrow}</span>
      <h2 id="vs-expect" class={H2}>{copy.expect.title}</h2>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-4 p-0">
        {copy.expect.items.map((item) => (
          <li class="rounded-[20px] bg-obra-white p-5">
            <h3 class={ITEM_TITLE}>{item.title}</h3>
            <p class={ITEM_TEXT}>{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class={SECTION} aria-labelledby="vs-faq">
      <span class="ln-eyebrow">{copy.faq.eyebrow}</span>
      <h2 id="vs-faq" class={H2}>{copy.faq.title}</h2>
      <div class="flex max-w-190 flex-col">
        {copy.faq.items.map((item) => (
          <details class="border-t border-obra-mist py-4">
            <summary class="cursor-pointer font-obra-sans-bold text-[1.0625rem]">{item.q}</summary>
            <p class="mx-0 mt-3 mb-0 max-w-[62ch] leading-[1.6] text-obra-ink-soft">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class={SECTION}>
      <h2 class={H2}>{copy.cta.title}</h2>
      <div class={ACTIONS}>
        <Button href={localizePath('/nosotros', locale)} variant="ghost">{copy.cta.about}</Button>
        <Button href={localizePath('/confesion-de-fe', locale)} variant="ghost">{copy.cta.confession}</Button>
        <Button href={localizePath('/sermones', locale)} variant="ghost">{copy.cta.sermons}</Button>
      </div>
    </section>
  </div>
</Layout>
