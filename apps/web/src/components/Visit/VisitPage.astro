---
import { getSiteConfig } from '@ancla/content';
import type { Locale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { getHtmlLang, localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout.astro';
import { buildFaqLd, buildServiceEventLd, mapLink } from 'src/utils/seo';
import 'src/styles/Visit.css';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getMessages(locale).visit;
const sunday = getMessages(locale).landing.sunday;
const site = Astro.locals.site ?? (await getSiteConfig());
const path = localizePath('/visitanos', locale);
const coords = `${site.geo.latitude},${site.geo.longitude}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${coords}`;
const embedUrl = `https://www.google.com/maps?ll=${coords}&z=17&output=embed`;

const faqLd = buildFaqLd(copy.faq.items);
const jsonLd = [
  ...(faqLd ? [faqLd] : []),
  buildServiceEventLd({
    name: copy.schema.eventName,
    description: copy.schema.eventDescription,
    url: new URL(path, site.url).toString(),
    site,
    language: getHtmlLang(locale),
  }),
];
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  keywords={copy.seo.keywords}
  breadcrumbs={[
    { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
    { name: copy.breadcrumbs.current, url: path },
  ]}
  jsonLd={jsonLd}
  locale={locale}
>
  <div class="ln vs">
    <section class="vs-wrap vs-hero">
      <nav class="vs-crumbs" aria-label="Breadcrumb">
        <a href={localizePath('/', locale)}>{copy.breadcrumbs.home}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{copy.breadcrumbs.current}</span>
      </nav>
      <span class="ln-eyebrow">{copy.hero.eyebrow}</span>
      <h1 class="ln-h vs-title">{copy.hero.title}</h1>
      <p class="vs-lead">{copy.hero.body}</p>
      <div class="vs-actions">
        <a href={directionsUrl} class="ln-btn" target="_blank" rel="noopener">
          {copy.hero.cta}<span class="ln-btn__dot" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="vs-wrap vs-section" aria-labelledby="vs-when">
      <span class="ln-eyebrow">{copy.when.eyebrow}</span>
      <h2 id="vs-when" class="ln-h vs-h2">{copy.when.title}</h2>
      <ol class="vs-times">
        {sunday.rows.map((row) => (
          <li>
            <b class="vs-time">{row.time}</b>
            <div>
              <h3>{row.title}</h3>
              <p>{row.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="vs-wrap vs-section vs-where" aria-labelledby="vs-where">
      <div>
        <span class="ln-eyebrow">{copy.where.eyebrow}</span>
        <h2 id="vs-where" class="ln-h vs-h2">{copy.where.title}</h2>
        <p class="vs-lead">{site.address.street}, {site.address.city} {site.address.postalCode}. {copy.where.body}</p>
        <div class="vs-actions">
          <a href={directionsUrl} class="ln-btn" target="_blank" rel="noopener">
            {copy.where.cta}<span class="ln-btn__dot" aria-hidden="true">→</span>
          </a>
          <a href={mapLink(site)} class="vs-link" target="_blank" rel="noopener">Google Maps</a>
        </div>
      </div>
      <iframe class="vs-map" src={embedUrl} title={copy.where.mapLabel} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>

    <section class="vs-wrap vs-section" aria-labelledby="vs-expect">
      <span class="ln-eyebrow">{copy.expect.eyebrow}</span>
      <h2 id="vs-expect" class="ln-h vs-h2">{copy.expect.title}</h2>
      <ul class="vs-expect">
        {copy.expect.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="vs-wrap vs-section" aria-labelledby="vs-faq">
      <span class="ln-eyebrow">{copy.faq.eyebrow}</span>
      <h2 id="vs-faq" class="ln-h vs-h2">{copy.faq.title}</h2>
      <div class="vs-faq">
        {copy.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="vs-wrap vs-section vs-more">
      <h2 class="ln-h vs-h2">{copy.cta.title}</h2>
      <div class="vs-actions">
        <a href={localizePath('/nosotros', locale)} class="ln-btn ln-btn--ghost">{copy.cta.about}</a>
        <a href={localizePath('/confesion-de-fe', locale)} class="ln-btn ln-btn--ghost">{copy.cta.confession}</a>
        <a href={localizePath('/sermones', locale)} class="ln-btn ln-btn--ghost">{copy.cta.sermons}</a>
      </div>
    </section>
  </div>
</Layout>
