---
import { ULINK } from 'src/styles/classes';
import cn from '../utils/cn.ts';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import LogoText from './LogoText.astro';
import { getMessages } from 'src/i18n/messages';

interface Props {
  locale: Locale;
  /** `dark` sits under the red closing of the landing instead of being red itself. */
  variant?: 'red' | 'dark';
  social?: { youtube?: string; instagram?: string; facebook?: string };
}

const { locale, variant = 'red', social = {} } = Astro.props;
// Link targets, in the same order as the labels in footer.json.
const churchHrefs = ['/nosotros#identidad', '/nosotros#historia', '/#doctrinas', '/confesion-de-fe', '/visitanos'];
const socialHrefs = [social.youtube, social.instagram, social.facebook];
const copy = getMessages(locale).footer;

const footer = {
  footer: cn(
    'relative text-white overflow-hidden',
    // Dark: overlaps the red closing by its corner radius so the corners show red, not the page.
    variant === 'dark' ? 'bg-[#151515] -mt-10 rounded-t-[40px] z-10 pt-24 pb-20' : 'bg-primary py-20'
  ),
  watermark: cn(
    'absolute bottom-[-4vw] left-0 right-0 pointer-events-none select-none'
  ),
  watermarkText: cn(
    'font-display italic font-light text-[28vw] leading-[0.8]',
    'text-white/10 tracking-tighter text-center'
  ),
  container: cn('relative mx-auto max-w-[1600px] px-6 md:px-10'),
  topGrid: cn('grid grid-cols-1 md:grid-cols-12 gap-10 pb-14'),
  colBrand: cn('md:col-span-4'),
  brandRow: cn('flex items-center gap-3'),
  brandTagline: cn('mt-6 font-ui text-[14px] leading-relaxed opacity-85 max-w-xs'),
  colLinks: cn('md:col-span-2'),
  colMinis: cn('md:col-span-3'),
  colSocial: cn('md:col-span-3'),
  colLabel: cn('font-ui text-[10px] tracking-[0.25em] uppercase opacity-70 mb-4'),
  linkList: cn('space-y-2 font-ui text-[13.5px]'),
  minisGrid: cn('grid grid-cols-2 gap-y-2 font-ui text-[13.5px]'),
  bottom: cn(
    'border-t border-white/20 pt-6',
    'flex flex-col md:flex-row md:items-center md:justify-between gap-3',
    'font-ui text-[12px] opacity-85'
  ),
  image: cn('w-10 h-10 object-contain'),
  logoText: cn('text-2xl'),
  verse: cn('opacity-60'),
  churchLink: cn(ULINK),
  ministryLink: cn(ULINK),
  socialLink: cn(ULINK),
};

const year = new Date().getFullYear();
---

<!-- FOOTER -->
<footer class={footer.footer}>
  <div class={footer.watermark}>
    <div class={footer.watermarkText}>El Ancla</div>
  </div>

  <div class={footer.container}>
    <div class={footer.topGrid}>
      <!-- brand -->
      <div class={footer.colBrand}>
        <div class={footer.brandRow}>
          <img src="/images/anclablanco.png" alt="" class={footer.image} />
          <LogoText label={copy.brandLabel} name={copy.brandName} class={footer.logoText} />
        </div>
        <p class={footer.brandTagline}>
          {copy.tagline}
          <span class={footer.verse}>{copy.verse}</span>
        </p>
      </div>

      <!-- iglesia -->
      <div class={footer.colLinks}>
        <div class={footer.colLabel}>{copy.churchLabel}</div>
        <ul class={footer.linkList}>
          {copy.churchLinks.map((l, i) => (
            <li><a href={localizePath(churchHrefs[i] ?? '/', locale)} class={footer.churchLink}>{l}</a></li>
          ))}
        </ul>
      </div>

      <!-- ministerios -->
      <div class={footer.colMinis}>
        <div class={footer.colLabel}>{copy.ministryLabel}</div>
        <ul class={footer.minisGrid}>
          {copy.ministryLinks.map((l) => (
            <li><a href={localizePath('/#juntos', locale)} class={footer.ministryLink}>{l}</a></li>
          ))}
        </ul>
      </div>

      <!-- redes -->
      <div class={footer.colSocial}>
        <div class={footer.colLabel}>{copy.socialLabel}</div>
        <ul class={footer.linkList}>
          {copy.socialLinks.map((l, i) => (
            <li><a href={socialHrefs[i] ?? '#'} class={footer.socialLink} target="_blank" rel="noopener">{l}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class={footer.bottom}>
      <div>{copy.address}</div>
      <div>© <span id="year">{year}</span> {copy.copyright}</div>
    </div>
  </div>
</footer>
