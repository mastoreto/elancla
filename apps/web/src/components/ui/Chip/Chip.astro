---
// Filter / category chip. Renders an <a> when `href` is given, a <button> otherwise; `data-on="true"`
// marks the selected one (scripts may flip it).
import cn from 'src/utils/cn';

interface Props {
  href?: string;
  class?: string;
  [attr: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;

const CHIP = [
  'inline-flex min-h-11 cursor-pointer items-center rounded-full border-0 bg-obra-mist px-5 font-obra-sans-bold text-[0.9375rem] text-obra-ink no-underline',
  '[transition:transform_0.5s_var(--ease-obra),background-color_0.4s,color_0.4s] hover:[transform:translateY(-2px)] hover:bg-obra-white',
  'data-[on=true]:bg-obra-ink data-[on=true]:text-white',
];
const Tag = href ? 'a' : 'button';

const chip = {
  container: cn(CHIP, className),
};
---

<Tag href={href} type={href ? undefined : 'button'} class={chip.container} {...rest}><slot /></Tag>
