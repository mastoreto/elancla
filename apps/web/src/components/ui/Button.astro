---
// Pill button of the "obra" system (styles live in LandingObra.css, scope `.ln`).
// Renders an <a> when `href` is given, a <button> otherwise. `arrow` adds the white dot with →.
interface Props {
  href?: string;
  /** Render a <span> that only looks like a button (for use inside another link). */
  as?: 'span';
  variant?: 'primary' | 'ghost' | 'dark' | 'light';
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [attr: string]: unknown;
}

const { as, href, variant = 'primary', arrow = false, type = 'button', class: className, ...rest } = Astro.props;
const classes = ['ln-btn', variant !== 'primary' && `ln-btn--${variant}`, className];
const Tag = href ? 'a' : as ?? 'button';
---

<Tag href={href} type={href || as ? undefined : type} class:list={classes} {...rest}>
  <slot />
  {arrow && <span class="ln-btn__dot" aria-hidden="true">→</span>}
</Tag>
