---
import { CTA_ARROW, CTA_FILL } from 'src/styles/classes';
import type { ContentCta } from 'src/data/contentPages';
import InlineText from './InlineText.astro';
import cn from 'src/utils/cn';

interface Props {
  cta: ContentCta;
}

const { cta } = Astro.props;

const contentCTA = {
  container: cn('relative py-24 bg-white border-y border-ink/10', 'md:py-32'),
  panel: cn('mx-auto max-w-[1280px] px-6', 'md:px-10'),
  grid: cn('grid grid-cols-1 gap-10 items-center', 'lg:grid-cols-12'),
  copy: cn('lg:col-span-7'),
  eyebrow: cn('font-mono text-[11px] tracking-[0.2em] uppercase text-primary mb-4'),
  title: cn(
    'font-display text-[clamp(2.2rem,6vw,4.6rem)] leading-[0.96] tracking-tight font-light',
  ),
  body: cn('mt-6 font-ui text-[16px] leading-relaxed text-ink/70 max-w-xl', 'md:text-[17px]'),
  actions: cn('flex flex-col gap-3', 'lg:col-span-5'),
  primary: cn(
    CTA_FILL,
    'inline-flex items-center justify-between gap-3 rounded-full bg-ink text-paper px-7 py-5',
    'font-ui text-[13px] font-semibold tracking-wide uppercase',
  ),
  primaryArrow: cn(CTA_ARROW),
  secondary: cn(
    'inline-flex items-center justify-between gap-3 rounded-full border border-ink/20 px-7',
    'py-5 font-ui text-[13px] font-semibold tracking-wide uppercase transition-colors',
    'hover:bg-ink hover:text-paper',
  ),
};
---

<section class={contentCTA.container}>
  <div class={contentCTA.panel}>
    <div class={contentCTA.grid}>
      <div class={contentCTA.copy}>
        <div class={contentCTA.eyebrow}>{cta.eyebrow}</div>
        <h2 class={contentCTA.title}>
          <InlineText value={cta.title} />
        </h2>
        <p class={contentCTA.body}>
          {cta.body}
        </p>
      </div>
      <div class={contentCTA.actions}>
        <a href={cta.primary.href} class={contentCTA.primary}>
          {cta.primary.label}
          <svg class={contentCTA.primaryArrow} width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </a>
        {
          cta.secondary && (
            <a href={cta.secondary.href} class={contentCTA.secondary}>
              {cta.secondary.label}
              <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6H10M10 6L6 2M10 6L6 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
