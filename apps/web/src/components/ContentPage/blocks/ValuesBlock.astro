---
import type { ContentValuesBlock } from 'src/data/contentPages';

interface Props {
  block: ContentValuesBlock;
}

const { block } = Astro.props;
---

<div class="mt-10">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    {
      block.values.map((value) => (
        <div class="relative border border-charcoal/10 bg-(--paper) px-7 py-9 [transition:background_0.4s_ease,translate_0.4s_ease] hover:-translate-y-0.75 hover:bg-obra-white">
          <div class="mb-3 font-label-mono text-[10px] tracking-[0.22em] font-semibold text-(--primary)">{value.number}</div>
          <h3 class="font-display text-2xl mb-3 font-medium">{value.title}</h3>
          <p class="font-ui text-[14px] leading-relaxed text-ink/70">{value.description}</p>
        </div>
      ))
    }
  </div>

  {
    block.note && (
      <div class="relative mt-10 border border-dashed border-charcoal/20 bg-sandstone px-6.5 py-5.5">
        <span class="absolute -top-3 left-5.5 bg-(--paper) px-2.5 py-0.75 font-label-mono text-[10px] tracking-[0.22em] font-semibold text-(--primary) uppercase">{block.note.label}</span>
        <p class="font-ui text-[15px] leading-relaxed text-ink/80 [&_a]:font-semibold [&_a]:text-(--ink) [&_a:hover]:text-(--primary) [&_a]:underline [&_a]:decoration-primary/60 [&_a]:underline-offset-2"
          set:html={block.note.html} />
      </div>
    )
  }
</div>
