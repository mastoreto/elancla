---
import type { ContentVerseBlock } from 'src/data/contentPages';

interface Props {
  block: ContentVerseBlock;
}

const { block } = Astro.props;
---

<blockquote class="relative mt-10 border-l-3 border-(--primary) bg-obra-white px-8 py-7">
  <span class="mb-3 block font-label-mono text-[11px] font-semibold tracking-[0.2em] text-(--primary) uppercase">{block.reference}</span>
  <p class="font-display text-[clamp(1.15rem,1.5vw,1.4rem)] leading-[1.45] font-light text-(--ink) italic">{block.text}</p>
</blockquote>
