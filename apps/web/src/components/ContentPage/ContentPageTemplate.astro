---
import type { ContentPage } from 'src/data/contentPages';
import ContentHero from './ContentHero.astro';
import ContentFigure from './ContentFigure.astro';
import StickyToc from './StickyToc.astro';
import ContentSection from './ContentSection.astro';
import ContentCTA from './ContentCTA.astro';
import cn from 'src/utils/cn';

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;

const contentPageTemplate = {
  container: cn('bg-(--paper) text-(--ink)'),
  hero: cn('relative'),
  heroInner: cn('mx-auto max-w-[1600px] px-6', 'md:px-10'),
  body: cn('relative py-20', 'md:py-28'),
  bodyInner: cn('mx-auto max-w-[1280px] px-6', 'md:px-10'),
  grid: cn('grid grid-cols-1 gap-12', 'lg:grid-cols-12 lg:gap-16'),
  sections: cn('order-1 flex flex-col gap-24', 'lg:col-span-9 lg:order-2 md:gap-32'),
};
---

<article class={contentPageTemplate.container}>
  <ContentHero hero={page.hero} />

  {
    page.featuredImage && (
      <section class={contentPageTemplate.hero}>
        <div class={contentPageTemplate.heroInner}>
          <ContentFigure figure={page.featuredImage} />
        </div>
      </section>
    )
  }

  <section class={contentPageTemplate.body}>
    <div class={contentPageTemplate.bodyInner}>
      <div class={contentPageTemplate.grid}>
        <StickyToc sections={page.sections} shortcuts={page.shortcuts} />
        <div class={contentPageTemplate.sections}>
          {page.sections.map((section) => <ContentSection section={section} />)}
        </div>
      </div>
    </div>
  </section>

  {page.cta && <ContentCTA cta={page.cta} />}
</article>

<script>
  import { initContentPage } from 'src/scripts/contentPage';
  initContentPage();
</script>
