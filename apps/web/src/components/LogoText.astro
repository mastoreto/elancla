---
// BRAND RULE: the wordmark must look the same everywhere the logo appears.
// "IGLESIA BAUTISTA" is uppercase, regular weight (not bold) and justified to span exactly
// the width of "EL ANCLA" (first letter to last letter); "EL ANCLA" is the bold futura name.
// Size it by setting the font-size of the wrapper (the label scales with it).
import cn from '../utils/cn.ts';

interface Props {
  label: string;
  name: string;
  class?: string;
}

const { label, name, class: className } = Astro.props;
---

<div class={cn('inline-flex flex-col leading-none', className)}>
  <div
    class="w-full text-[0.4em] tracking-[0.22em] font-futura font-normal uppercase opacity-60 [text-align-last:justify]"
  >
    {label}
  </div>
  <div class="font-display tracking-tight font-futura-bold font-semibold leading-none uppercase whitespace-nowrap">
    {name}
  </div>
</div>
