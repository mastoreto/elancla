---
import { CAPTION } from './styles';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['confession']['quote'];
}

const { copy } = Astro.props;
---

<section class="px-gutter-sm pt-[clamp(3.5rem,6.7vw,6rem)] text-center">
  <blockquote class="mx-auto my-0 flex max-w-250 flex-col items-center gap-6">
    <p class="m-0 font-obra-serif text-[clamp(1.875rem,4.2vw,3.75rem)] leading-[1.08] tracking-[-0.02em]">
      {copy.textBefore} <span class="text-obra-red">{copy.emphasis},</span> {copy.textAfter}
    </p>
    <cite class:list={[CAPTION, 'text-obra-muted']}>{copy.reference}</cite>
  </blockquote>
</section>
