---
import { CAPTION } from './styles';
import type { Messages } from 'src/i18n/messages';
import cn from 'src/utils/cn';

interface Props {
  copy: Messages['confession']['quote'];
}

const { copy } = Astro.props;

const confesionQuote = {
  container: cn('px-gutter-sm pt-[clamp(3.5rem,6.7vw,6rem)] text-center'),
  quote: cn('mx-auto my-0 flex max-w-250 flex-col items-center gap-6'),
  textBefore: cn(
    'm-0 font-obra-serif text-[clamp(1.875rem,4.2vw,3.75rem)] leading-[1.08]',
    'tracking-[-0.02em]',
  ),
  emphasis: cn('text-obra-red'),
  reference: cn(CAPTION, 'text-obra-muted'),
};
---

<section class={confesionQuote.container}>
  <blockquote class={confesionQuote.quote}>
    <p class={confesionQuote.textBefore}>
      {copy.textBefore} <span class={confesionQuote.emphasis}>{copy.emphasis},</span> {copy.textAfter}
    </p>
    <cite class={confesionQuote.reference}>{copy.reference}</cite>
  </blockquote>
</section>
