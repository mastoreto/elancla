---
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['confession']['quote'];
}

const { copy } = Astro.props;
---

<section class="cf-quote">
  <blockquote>
    <p class="cf-quote__text">
      {copy.textBefore} <span class="cf-accent">{copy.emphasis},</span> {copy.textAfter}
    </p>
    <cite class="cf-cap">{copy.reference}</cite>
  </blockquote>
</section>
