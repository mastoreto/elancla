---
import AnchorMark from 'src/components/AnchorMark.astro';
import { localizePath } from 'src/i18n/utils';
import type { Locale } from 'src/i18n/config';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['confession']['hero'];
  locale: Locale;
}

const { copy, locale } = Astro.props;
// "We believe doctrine matters." with the emphasised word picked out in red.
const [titleBefore, titleAfter = ''] = copy.titleLines.join(' ').split(copy.emphasis);
---

<section class="cf-hero">
  <nav class="cf-crumb" aria-label={copy.breadcrumbCurrent}>
    <a href={localizePath('/', locale)} class="ulink">{copy.breadcrumbHome}</a>
    <span aria-hidden="true">/</span>
    <span class="cf-crumb__now" aria-current="page">{copy.breadcrumbCurrent}</span>
  </nav>

  <div class="cf-hero__row">
    <div class="cf-hero__text">
      <span class="ln-eyebrow cf-rise">{copy.counter} · {copy.meta}</span>
      <h1 class="ln-h cf-hero__title cf-rise" style="--d: 0.15s">
        {titleBefore}<span class="cf-accent">{copy.emphasis}</span>{titleAfter}
      </h1>
      <p class="cf-hero__lead cf-rise" style="--d: 0.3s">{copy.body}</p>
      <div class="cf-hero__cta cf-rise" style="--d: 0.45s">
        <a href="#doctrinas" class="ln-btn">
          {copy.primaryCta}<span class="ln-btn__dot" aria-hidden="true">→</span>
        </a>
        <button type="button" id="expandAll" class="ln-btn ln-btn--ghost">
          <span id="expandAllLabel" data-collapsed-label={copy.expandAll} data-expanded-label={copy.collapseAll}>{copy.expandAll}</span>
        </button>
      </div>
    </div>

    <div class="cf-seal" aria-hidden="true">
      <svg class="cf-seal__ring" viewBox="0 0 300 300">
        <defs>
          <path id="cf-seal-path" d="M150 150 m-118 0 a118 118 0 1 1 236 0 a118 118 0 1 1 -236 0" />
        </defs>
        <text font-size="19" fill="currentColor"><textPath href="#cf-seal-path" textLength="736" lengthAdjust="spacing">{copy.sealText}</textPath></text>
      </svg>
      <AnchorMark id="cf-seal" color="#a8141b" outline={false} class="cf-seal__anchor" />
    </div>
  </div>
</section>
