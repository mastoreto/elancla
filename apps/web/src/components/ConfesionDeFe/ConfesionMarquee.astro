---
interface Props {
  solas: string[];
}

const { solas } = Astro.props;
// Two identical groups: the track slides by exactly one group (-50%) for a seamless loop.
const group = [...solas, ...solas, ...solas];
---

<div class="cf-marquee">
  <div class="cf-marquee__track">
    <ul class="cf-marquee__group">
      {group.map((s) => <li class="cf-marquee__item">{s}</li>)}
    </ul>
    <ul class="cf-marquee__group" aria-hidden="true">
      {group.map((s) => <li class="cf-marquee__item">{s}</li>)}
    </ul>
  </div>
</div>
