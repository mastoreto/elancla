---
import { CAPTION } from './styles';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['confession']['christus'];
}

const { copy } = Astro.props;
---

<section class="px-gutter-sm pt-[clamp(3.5rem,6.7vw,6rem)]">
  <div class="relative flex flex-col gap-5.5 overflow-hidden rounded-[clamp(2rem,3.3vw,3rem)] bg-obra-red px-[clamp(1.5rem,5vw,4.5rem)] py-[clamp(2rem,5vw,4.5rem)] text-white">
    <span
      class="pointer-events-none absolute top-5 right-5 font-obra-brand text-[clamp(5.625rem,13.9vw,12.5rem)] leading-none font-black text-obra-white/8 uppercase"
      aria-hidden="true"
    >{copy.sideLabel}</span>
    <span class="relative font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-blush uppercase">{copy.counter} · {copy.eyebrow}</span>
    <h2 class="ln-h relative max-w-224 text-[clamp(2.25rem,5.3vw,4.75rem)] leading-[0.98] tracking-[-0.03em]">{copy.headlineBefore}{copy.headlineEmphasis}</h2>
    <p class="relative m-0 max-w-160 text-[clamp(1rem,1.3vw,1.1875rem)] leading-[1.55]">{copy.body}</p>
    <blockquote class="relative m-0 max-w-160 border-l-3 border-white pl-5">
      <p class="mx-0 mt-0 mb-2 font-obra-serif text-[clamp(1.375rem,2vw,1.75rem)] leading-[1.2]">«{copy.verse}»</p>
      <cite class:list={[CAPTION, 'text-obra-blush']}>{copy.reference}</cite>
    </blockquote>
    <div class="relative">
      <a
        href="#doctrine-jesucristo"
        data-open-doctrine="jesucristo"
        class="ln-btn bg-obra-white px-6.5 text-obra-red hover:shadow-[0_14px_28px_-14px_rgba(21,21,21,0.45)]"
      >{copy.cta}</a>
    </div>
  </div>
</section>
