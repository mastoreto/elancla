---
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['confession']['christus'];
}

const { copy } = Astro.props;
---

<section class="cf-christus">
  <div class="cf-christus__card">
    <span class="cf-christus__mark" aria-hidden="true">{copy.sideLabel}</span>
    <span class="cf-christus__eyebrow">{copy.counter} · {copy.eyebrow}</span>
    <h2 class="ln-h cf-christus__title">{copy.headlineBefore}{copy.headlineEmphasis}</h2>
    <p class="cf-christus__text">{copy.body}</p>
    <blockquote class="cf-christus__verse">
      <p>«{copy.verse}»</p>
      <cite class="cf-cap">{copy.reference}</cite>
    </blockquote>
    <div>
      <a href="#doctrine-jesucristo" data-open-doctrine="jesucristo" class="ln-btn cf-btn--white">{copy.cta}</a>
    </div>
  </div>
</section>
