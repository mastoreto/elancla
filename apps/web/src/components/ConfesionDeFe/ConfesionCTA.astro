---
import { localizePath } from 'src/i18n/utils';
import type { Locale } from 'src/i18n/config';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['confession']['cta'];
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

<section class="flex flex-col items-center gap-[1.4rem] px-gutter-sm pt-[clamp(3.5rem,6.7vw,6rem)] text-center">
  <h2 class="ln-h max-w-224 text-[clamp(2.375rem,5vw,4.5rem)] leading-none tracking-[-0.03em]">
    {copy.headlineBefore}<span class="text-obra-red">{copy.headlineEmphasis}</span>{copy.headlineAfter}
  </h2>
  <p class="m-0 max-w-140 text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55] text-obra-ink-soft">{copy.body}</p>
  <div class="flex flex-wrap justify-center gap-3">
    <a href={localizePath('/#visitanos', locale)} class="ln-btn">
      {copy.primary}<span class="ln-btn__dot" aria-hidden="true">→</span>
    </a>
    <a href={localizePath('/#domingo', locale)} class="ln-btn ln-btn--ghost">{copy.secondary}</a>
  </div>
</section>
