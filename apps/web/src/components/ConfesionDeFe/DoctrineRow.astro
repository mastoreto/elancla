---
import { doctrineIcons } from 'src/data/doctrineIcons';
import type { Doctrine } from 'src/data/doctrines';
import type { Messages } from 'src/i18n/messages';

interface Props {
  doctrine: Doctrine;
  index: number;
  copy: Messages['confession']['doctrineList'];
}

const { doctrine: d, index, copy } = Astro.props;
const panelId = `doctrine-panel-${d.id}`;
---

<article id={`doctrine-${d.id}`} class="cf-card" data-id={d.id}>
  <button type="button" class="cf-card__head" aria-expanded="false" aria-controls={panelId}>
    <span class="cf-card__num">{d.number}</span>
    <span class="cf-card__icon">
      <svg viewBox="0 0 120 120" fill="currentColor" stroke="currentColor" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
        {doctrineIcons[index].map((s) => s.circle
          ? <circle cx={s.circle[0]} cy={s.circle[1]} r={s.circle[2]} />
          : <path d={s.d} fill={s.cut ? 'var(--ln-warm)' : undefined} stroke={s.cut ? 'none' : undefined} />)}
      </svg>
    </span>
    <span class="cf-card__title">
      <b>{d.title}</b>
      <span>{d.subtitle}</span>
    </span>
    <span class="cf-card__tag">{d.tag}</span>
    <span class="cf-card__plus" aria-hidden="true"></span>
    <span class="sr-only">{copy.expand}</span>
  </button>

  <p class="cf-card__lead">{d.summary}</p>

  <div id={panelId} class="cf-card__panel" role="region" aria-label={d.title}>
    <div class="cf-card__inner">
      <p class="cf-card__summary">{d.summary}</p>

      <blockquote class="cf-card__verse">
        <p>«{d.verse}»</p>
        <cite class="cf-cap">{d.verseRef}</cite>
      </blockquote>

      <div class="cf-card__sections">
        {d.sections.map((section) => (
          <div class="cf-card__section">
            <span class="cf-cap">{section.h}</span>
            <div class="cf-body" set:html={section.body} />
          </div>
        ))}
      </div>

      <div class="cf-card__refs">
        <span class="cf-cap">{copy.references}</span>
        {d.refs.map((ref) => <span class="cf-chip">{ref}</span>)}
      </div>
    </div>
  </div>
</article>
