---
import type { Doctrine } from 'src/data/doctrines';
import type { Messages } from 'src/i18n/messages';
import DoctrineRow from './DoctrineRow.astro';

interface Props {
  doctrines: Doctrine[];
  copy: Messages['confession']['doctrineList'];
}

const { doctrines, copy } = Astro.props;
---

<section id="doctrinas" class="cf-doc">
  <div class="cf-doc__main">
    <header class="cf-doc__head">
      <span class="ln-eyebrow">{copy.counter}</span>
      <span class="cf-doc__hint">{copy.hint}</span>
    </header>
    <div class="cf-doc__list">
      {doctrines.map((d, i) => <DoctrineRow doctrine={d} index={i} copy={copy} />)}
    </div>
  </div>

  <aside class="cf-doc__aside">
    <div class="cf-aside__group">
      <span class="cf-cap">{copy.index}</span>
      {doctrines.map((d) => (
        <a href={`#doctrine-${d.id}`} class="cf-idx ulink" data-id={d.id}>
          <span>{d.number}</span><span>{d.title}</span>
        </a>
      ))}
    </div>
    <div class="cf-aside__group">
      <span class="cf-cap">{copy.resources}</span>
      {copy.resourceLinks.map((label: string) => (
        <a href="#" class="ulink cf-res">{label} →</a>
      ))}
    </div>
  </aside>
</section>
