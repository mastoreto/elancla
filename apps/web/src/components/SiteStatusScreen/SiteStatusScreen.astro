---
// Replaces the whole page while the site is in maintenance ("obra" design, palette B) or closed.
// Maintenance: forged red anchor, link to the service times below, email contact.
// Closed (offline): grey anchor hanging from a rope, a retry link, frozen photo wall.
import type { SiteStatus } from '@ancla/content';
import { cn } from '@ancla/utils';
import Button from 'src/components/ui/Button';
import type { Locale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { RISE_IN } from 'src/utils/riseIn';
import StatusAnchor from './components/StatusAnchor';
import StatusFact from './components/StatusFact';
import StatusPhotoWall from './components/StatusPhotoWall';
import { formatServiceTimes } from './utils/formatServiceTimes';

interface Props {
  status: Exclude<SiteStatus, 'online'>;
  locale: Locale;
  contactEmail?: string;
  /** `SiteConfig.serviceTimes`, e.g. "Su 11:15-13:00". */
  serviceTimes: string;
  /** Street line of the church, shown on the offline screen. */
  street: string;
}

const { status, locale, contactEmail, serviceTimes, street } = Astro.props;
const messages = getMessages(locale).siteStatus;
const isMaintenance = status === 'maintenance';
const copy = messages[status];
const services = formatServiceTimes(serviceTimes, locale);
// The title ends with the emphasized word, picked out in red (same trick as the 404 page).
const titleBefore = copy.title.slice(
  0,
  copy.title.lastIndexOf(copy.titleEmphasis)
);

// Reload for real (no client router): the point of retrying is a fresh server render.
const retryHref = `${Astro.url.pathname}${Astro.url.search}`;

const SERVICES_ID = 'horarios';

const siteStatusScreen = {
  container: cn(
    'ln relative isolate flex min-h-svh flex-col justify-end gap-4 overflow-hidden bg-obra-mist',
    'px-5 pt-[24rem] pb-7',
    'md:justify-between md:gap-10 md:px-[5%] md:pt-[clamp(7rem,19svh,10.5rem)] md:pb-14'
  ),
  copy: cn(
    'relative z-7 flex flex-col items-start gap-4 md:w-[min(35rem,38vw)] md:gap-6'
  ),
  kicker: cn(
    'inline-flex items-center gap-2.5 font-obra-sans-bold text-[0.75rem] tracking-[0.16em] uppercase',
    'md:text-[0.8125rem]',
    isMaintenance ? 'text-obra-red' : 'text-obra-muted',
    RISE_IN
  ),
  dot: cn(
    'size-2 flex-none rounded-full',
    isMaintenance ? 'bg-obra-red' : 'bg-obra-stone'
  ),
  title: cn(
    'ln-h text-[2.625rem] leading-none tracking-[-0.025em] text-obra-ink',
    'md:text-[clamp(2.6rem,5vw,4.5rem)]',
    RISE_IN
  ),
  titleEmphasis: cn('text-obra-red'),
  description: cn(
    'm-0 max-w-[27rem] text-[1rem] leading-normal text-obra-ink-soft',
    'md:text-[1.1875rem] md:leading-[1.55]',
    RISE_IN
  ),
  actions: cn('flex flex-wrap items-center gap-2.5 md:gap-3', RISE_IN),
  secondary: cn('bg-obra-paper/70'),
  facts: cn('relative z-7 flex flex-wrap gap-2.5', RISE_IN),
  factTarget: cn(
    'scroll-mt-24 transition-shadow duration-500 target:ring-2 target:ring-obra-red',
    'motion-reduce:transition-none'
  ),
  statusDot: cn('size-2 flex-none rounded-full bg-obra-live'),
};
---

<section class={siteStatusScreen.container} data-site-status={status}>
  <StatusPhotoWall paused={!isMaintenance} />
  <StatusAnchor variant={isMaintenance ? 'forged' : 'adrift'} tag={copy.tag} />

  <div class={siteStatusScreen.copy}>
    <span class={siteStatusScreen.kicker} style="--d: 0.1s">
      <span class={siteStatusScreen.dot} aria-hidden="true"></span>{copy.kicker}
    </span>
    <h1 class={siteStatusScreen.title} style="--d: 0.25s">
      {titleBefore}<span class={siteStatusScreen.titleEmphasis}>{copy.titleEmphasis}.</span>
    </h1>
    <p class={siteStatusScreen.description} style="--d: 0.45s">{copy.description}</p>
    <div class={siteStatusScreen.actions} style="--d: 0.6s">
      {isMaintenance ? (
        <>
          <Button href={`#${SERVICES_ID}`} arrow data-status-action="services">
            {messages.maintenance.servicesCta}
          </Button>
          {contactEmail && (
            <Button
              href={`mailto:${contactEmail}`}
              variant="ghost"
              class={siteStatusScreen.secondary}
              data-status-action="contact"
            >
              {messages.maintenance.contactCta}
            </Button>
          )}
        </>
      ) : (
        <Button
          href={retryHref}
          arrow
          arrowGlyph="↻"
          data-astro-reload
          data-status-action="retry"
        >
          {messages.closed.retryCta}
        </Button>
      )}
    </div>
  </div>

  <div class={siteStatusScreen.facts} style="--d: 1s">
    {isMaintenance && (
      <StatusFact label={messages.facts.status}>
        <span class={siteStatusScreen.statusDot} aria-hidden="true"></span>
        {messages.maintenance.statusValue}
      </StatusFact>
    )}
    <StatusFact
      id={SERVICES_ID}
      label={services.label ?? messages.facts.services}
      display
      class={siteStatusScreen.factTarget}
    >
      {services.value}
    </StatusFact>
    {!isMaintenance && <StatusFact label={messages.facts.where}>{street}</StatusFact>}
  </div>
</section>
