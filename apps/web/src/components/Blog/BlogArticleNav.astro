---
import type { BlogArticle } from 'src/data/blog';
import { getBlogArticlePath } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';

interface Props {
  previous: BlogArticle | null;
  next: BlogArticle | null;
  copy: any;
  locale: Locale;
}

const { previous, next, copy, locale } = Astro.props;
// With no neighbour the card falls back to the blog index / the newsletter.
const prev = previous
  ? { href: getBlogArticlePath(previous), label: `← ${copy.previous}`, title: previous.title }
  : { href: '/blog', label: `← ${copy.back}`, title: copy.allArticles };
const nxt = next
  ? { href: getBlogArticlePath(next), label: `${copy.next} →`, title: next.title }
  : { href: '/blog#newsletter', label: `${copy.next} →`, title: copy.nextDelivery };
---

<section class="bl-prevnext bl-pad">
  <a href={localizePath(prev.href, locale)} class="bl-pn"><small>{prev.label}</small><b>{prev.title}</b></a>
  <a href={localizePath(nxt.href, locale)} class="bl-pn bl-pn--next"><small>{nxt.label}</small><b>{nxt.title}</b></a>
</section>
