---
import type { BlogArticle } from 'src/data/blog';
import { getBlogArticlePath } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import Pill from '../ui/Pill.astro';
import BlogCover from './BlogCover.astro';

interface Props {
  article: BlogArticle;
  by: string;
  locale: Locale;
}

const { article, by, locale } = Astro.props;
const href = localizePath(getBlogArticlePath(article), locale);
---

<a href={href} class="bl-card reveal" data-blog-article-card data-blog-filter={article.filter}>
  <BlogCover tint={article.tint}><Pill>{article.category}</Pill></BlogCover>
  <div class="bl-card__body">
    <span class="bl-card__meta">{article.compactDate} · {article.readTime}</span>
    <h3 class="bl-card__title">{article.title}</h3>
    <span class="bl-card__excerpt">{article.excerpt}</span>
    <span class="bl-card__by">{by} {article.author.name}</span>
  </div>
</a>
