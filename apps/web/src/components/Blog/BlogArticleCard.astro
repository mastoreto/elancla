---
import { REVEAL_STATE } from 'src/styles/classes';
import type { BlogArticle } from 'src/data/blog';
import { getBlogArticlePath } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import Pill from '../ui/Pill.astro';
import BlogCover from './BlogCover.astro';

interface Props {
  article: BlogArticle;
  by: string;
  locale: Locale;
}

const { article, by, locale } = Astro.props;
const href = localizePath(getBlogArticlePath(article), locale);
---

<a
  href={href}
  class:list={[
    // Its own transition replaces the reveal one; the `.in` hover keeps the lift once revealed.
    REVEAL_STATE,
    'flex flex-col gap-4 rounded-[32px] bg-obra-mist px-4 pt-4 pb-6 text-inherit no-underline [transition:transform_0.5s_var(--ease-obra),box-shadow_0.5s,background-color_0.4s] hover:[transform:translateY(-4px)] hover:[&.in]:[transform:translateY(-4px)] hover:bg-obra-white hover:shadow-obra-lift',
  ]}
  data-reveal
  data-blog-article-card
  data-blog-filter={article.filter}
>
  <BlogCover tint={article.tint} class="h-47.5 max-sm:h-37.5"><Pill>{article.category}</Pill></BlogCover>
  <div class="flex flex-col gap-2.5 px-2">
    <span class="font-obra-sans-bold text-[0.75rem] tracking-[0.12em] text-obra-muted">{article.compactDate} · {article.readTime}</span>
    <h3 class="m-0 font-obra-serif text-[1.5625rem] leading-[1.1] font-bold max-sm:text-[1.375rem]">{article.title}</h3>
    <span class="text-[0.9375rem] leading-normal text-obra-ink-soft">{article.excerpt}</span>
    <span class="font-obra-sans-bold text-[0.8125rem] text-obra-red">{by} {article.author.name}</span>
  </div>
</a>
