---
// Cover placeholder shared by cards, featured and article: tinted block + faint anchor.
// Slot = pills shown top-left. (Swap for a real <img class="ln-photo"> once articles carry a photo.)
import AnchorMark from '../AnchorMark.astro';

interface Props {
  tint: string;
  size?: 'sm' | 'lg';
  class?: string;
}

const { tint, size = 'sm', class: className } = Astro.props;
---

<div class:list={['bl-art', size === 'lg' && 'bl-art--lg', className]} style={`--tint: ${tint}`}>
  <span class="bl-art__pill"><slot /></span>
  <span class="bl-anchor-ghost"><AnchorMark id="blog-cover" outline={false} /></span>
</div>
