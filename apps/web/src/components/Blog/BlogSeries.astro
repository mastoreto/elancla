---
import type { BlogSeriesItem } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';

interface Props {
  series: BlogSeriesItem[];
  copy: any;
  locale: Locale;
}

const { series, copy, locale } = Astro.props;
const statusLabel = { published: copy.published, current: copy.current, next: copy.upcoming };
---

<section class="bl-section bl-pad">
  <div class="bl-series">
    <div class="bl-series__head">
      <div>
        <span class="ln-eyebrow">{copy.counter} · {copy.eyebrow}</span>
        <h3 class="ln-h bl-series__title">{copy.headlineBefore}<em>{copy.headlineEmphasis}</em></h3>
      </div>
      <p>{copy.body}</p>
    </div>
    {
      series.map((item) => {
        const Tag = item.status === 'next' ? 'div' : 'a';
        return (
          <Tag
            href={item.status === 'next' ? undefined : localizePath(item.href, locale)}
            class:list={['bl-serie', `bl-serie--${item.status}`]}
          >
            <span class="bl-serie__n">{item.number}</span>
            <b class="bl-serie__t">{item.title}</b>
            <span class="bl-serie__m">{item.reference}</span>
            <span class="bl-serie__m">{item.date}</span>
            <span class="bl-serie__s">{statusLabel[item.status]}</span>
          </Tag>
        );
      })
    }
  </div>
</section>
