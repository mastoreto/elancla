---
import type { BlogArticle } from 'src/data/blog';
import { getArticleToc } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import NewsletterCard from '../ui/NewsletterCard.astro';
import BlogArticleBody from './BlogArticleBody.astro';
import BlogArticleHero from './BlogArticleHero.astro';
import BlogArticleNav from './BlogArticleNav.astro';
import BlogRelated from './BlogRelated.astro';

interface Props {
  article: BlogArticle;
  related: BlogArticle[];
  previous: BlogArticle | null;
  next: BlogArticle | null;
  copy: any;
  locale: Locale;
}

const { article, related, previous, next, copy, locale } = Astro.props;
const toc = getArticleToc(article);
---

<div class="ln overflow-x-clip bg-obra-paper">
  <BlogArticleHero article={article} copy={copy.article} locale={locale} />

  <section class="flex justify-center gap-16 px-gutter pt-[clamp(2.5rem,5vw,4.5rem)] max-lg:gap-0">
    <aside class="sticky top-28 flex flex-[0_0_260px] flex-col gap-4.5 self-start max-lg:hidden">
      <span class="font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] uppercase text-obra-muted">{copy.article.toc}</span>
      <nav class="flex flex-col gap-3">
        {
          toc.map((item) => (
            <a
              href={`#${item.id}`}
              class="flex gap-3 font-obra-sans-bold text-[0.9375rem] text-obra-muted no-underline [transition:color_0.3s] hover:text-obra-red [&.active]:text-obra-red"
              data-toc-link
              data-target={item.id}
            >
              <span>{item.number}</span>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="mt-3 flex flex-col gap-2.5 rounded-3xl bg-obra-mist p-5">
        <span class="flex size-12 flex-none items-center justify-center rounded-full bg-obra-red font-obra-sans-bold text-white" aria-hidden="true">{article.author.initials}</span>
        <b>{article.author.name}</b>
        <p class="m-0 text-[0.875rem] leading-[1.45] text-obra-ink-soft">{article.author.bio.split('. ')[0]}.</p>
      </div>
    </aside>
    <BlogArticleBody article={article} locale={locale} />
  </section>

  <BlogArticleNav previous={previous} next={next} copy={copy.article} locale={locale} />
  <BlogRelated articles={related} copy={copy.article} by={copy.articles.by} locale={locale} />
  <NewsletterCard copy={copy.newsletter} />
  <div class="h-[clamp(4rem,8vw,6rem)]"></div>
</div>
