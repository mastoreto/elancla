---
import type { BlogArticle } from 'src/data/blog';
import { getArticleToc } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import NewsletterCard from '../ui/NewsletterCard.astro';
import BlogArticleBody from './BlogArticleBody.astro';
import BlogArticleHero from './BlogArticleHero.astro';
import BlogArticleNav from './BlogArticleNav.astro';
import BlogRelated from './BlogRelated.astro';
import cn from 'src/utils/cn';

interface Props {
  article: BlogArticle;
  related: BlogArticle[];
  previous: BlogArticle | null;
  next: BlogArticle | null;
  copy: any;
  locale: Locale;
}

const { article, related, previous, next, copy, locale } = Astro.props;
const toc = getArticleToc(article);

const blogArticleTemplate = {
  container: cn('ln overflow-x-clip bg-obra-paper'),
  section: cn('flex justify-center gap-16 px-gutter pt-[clamp(2.5rem,5vw,4.5rem)]', 'max-lg:gap-0'),
  aside: cn('sticky top-28 flex flex-[0_0_260px] flex-col gap-4.5 self-start', 'max-lg:hidden'),
  toc: cn('font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] uppercase text-obra-muted'),
  asideToc: cn('flex flex-col gap-3'),
  tocLink: cn(
    'flex gap-3 font-obra-sans-bold text-[0.9375rem] text-obra-muted no-underline',
    '[transition:color_0.3s] hover:text-obra-red [&.active]:text-obra-red',
  ),
  stack: cn('mt-3 flex flex-col gap-2.5 rounded-3xl bg-obra-mist p-5'),
  initials: cn(
    'flex size-12 flex-none items-center justify-center rounded-full bg-obra-red',
    'font-obra-sans-bold text-white',
  ),
  text: cn('m-0 text-[0.875rem] leading-[1.45] text-obra-ink-soft'),
  wrapper: cn('h-[clamp(4rem,8vw,6rem)]'),
};
---

<div class={blogArticleTemplate.container}>
  <BlogArticleHero article={article} copy={copy.article} locale={locale} />

  <section class={blogArticleTemplate.section}>
    <aside class={blogArticleTemplate.aside}>
      <span class={blogArticleTemplate.toc}>{copy.article.toc}</span>
      <nav class={blogArticleTemplate.asideToc}>
        {
          toc.map((item) => (
            <a
              href={`#${item.id}`}
              class={blogArticleTemplate.tocLink}
              data-toc-link
              data-target={item.id}
            >
              <span>{item.number}</span>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class={blogArticleTemplate.stack}>
        <span class={blogArticleTemplate.initials} aria-hidden="true">{article.author.initials}</span>
        <b>{article.author.name}</b>
        <p class={blogArticleTemplate.text}>{article.author.bio.split('. ')[0]}.</p>
      </div>
    </aside>
    <BlogArticleBody article={article} locale={locale} />
  </section>

  <BlogArticleNav previous={previous} next={next} copy={copy.article} locale={locale} />
  <BlogRelated articles={related} copy={copy.article} by={copy.articles.by} locale={locale} />
  <NewsletterCard copy={copy.newsletter} />
  <div class={blogArticleTemplate.wrapper}></div>
</div>
