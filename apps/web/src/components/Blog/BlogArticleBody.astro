---
import Chip from 'src/components/ui/Chip';
import type { BlogArticle, BlogArticleBodyBlock } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import AnchorMark from '../AnchorMark.astro';
import cn from 'src/utils/cn';

interface Props {
  article: BlogArticle;
  locale: Locale;
}

const { article, locale } = Astro.props;
type FigureAspect = NonNullable<Extract<BlogArticleBodyBlock, { type: 'figure' }>['aspect']>;

// Running text size shared by paragraphs, list items, pull quotes and captions.
const BODY_TEXT = 'm-0 text-[clamp(1.0625rem,1.4vw,1.25rem)] leading-[1.7]';
const DROP_CAP =
  'first-letter:float-left first-letter:pt-1.5 first-letter:pr-3 first-letter:font-obra-serif first-letter:text-[5.75rem] first-letter:leading-[0.8] first-letter:font-bold first-letter:text-obra-red';
const BLOCK_LABEL = 'font-obra-sans-bold text-[0.8125rem] not-italic';
const FIGURE_HEIGHT: Record<FigureAspect, string> = {
  landscape: 'h-85',
  wide: 'h-70',
  square: 'aspect-square h-auto',
};

const blogArticleBody = {
  container: cn(
    'flex max-w-180 min-w-0 flex-1 flex-col gap-6.5 text-obra-body',
    '[&_a]:text-obra-red [&_a]:underline [&_a]:underline-offset-3',
  ),
  paragraph: cn(BODY_TEXT),
  h2Group: cn('mt-5 flex scroll-mt-24 flex-col gap-2.5'),
  eyebrow: cn('ln-eyebrow'),
  h2: cn(
    'm-0 font-obra-serif text-[clamp(1.875rem,3.2vw,2.75rem)] leading-[1.02] font-bold',
    'tracking-[-0.02em] text-obra-ink',
  ),
  h3: cn('mx-0 mt-2 mb-0 font-obra-serif text-[1.75rem] leading-[1.1] text-obra-ink'),
  verse: cn(
    'mx-0 my-2 flex flex-col gap-3.5 rounded-[36px] bg-obra-red p-[clamp(1.5rem,3vw,2.5rem)]',
    'text-white',
  ),
  verseText: cn(
    'm-0 font-obra-serif text-[clamp(1.375rem,2.2vw,2rem)] leading-[1.2] font-bold',
  ),
  reference: cn(BLOCK_LABEL, 'tracking-[0.16em] text-obra-blush uppercase'),
  figure: cn('mx-0 my-2 flex flex-col gap-2.5'),
  figureFrame: cn(
    'relative flex items-center justify-center overflow-hidden rounded-[28px] bg-(--tint) p-4',
    'max-sm:h-55',
  ),
  figureMark: cn('block w-22.5 text-obra-red opacity-16'),
  figureAnchor: cn('block h-auto w-full'),
  figureCaption: cn('flex gap-3 text-[0.8125rem] text-obra-muted'),
  pullquote: cn(
    'mx-0 my-3 flex flex-col gap-3 border-l-4 border-obra-red py-1.5 pl-6.5 font-obra-serif',
    'text-[clamp(1.5rem,2.5vw,2.25rem)] leading-[1.15] font-bold text-obra-ink',
  ),
  pullquoteText: cn(BODY_TEXT),
  pullquoteCite: cn(BLOCK_LABEL, 'tracking-[0.12em] text-obra-muted'),
  bulletList: cn('m-0 flex list-none flex-col gap-3.5 p-0'),
  bulletItem: cn(
    BODY_TEXT,
    "flex gap-3.5 before:mt-[0.7em] before:size-[9px] before:flex-none before:rounded-full before:bg-obra-red before:content-['']",
  ),
  orderedList: cn('m-0 flex list-none flex-col gap-3 p-0', '[counter-reset:n]'),
  orderedItem: cn(
    'm-0 flex items-start gap-4 rounded-3xl bg-obra-white px-5.5 py-5 text-[1.0625rem]',
    'leading-normal',
    'before:font-obra-serif before:text-[2.125rem] before:leading-none before:font-bold',
    'before:text-obra-red before:content-[counter(n)]',
    '[counter-increment:n]',
  ),
  video: cn('mx-0 my-2 flex flex-col gap-4 rounded-[36px] bg-obra-warm p-5 text-obra-cream'),
  videoFrame: cn(
    'flex h-75 items-center justify-center rounded-3xl bg-obra-warm-line',
    'max-sm:h-50',
  ),
  videoPlay: cn('flex size-19 items-center justify-center rounded-full bg-obra-red-live'),
  videoBar: cn('flex items-end justify-between gap-3.5 px-2 pb-1.5'),
  videoInfo: cn('flex flex-col gap-1.5'),
  videoEyebrow: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-red-live uppercase',
  ),
  videoTitle: cn('font-obra-serif text-[1.5rem]'),
  videoMeta: cn('text-[0.875rem] text-obra-sand'),
  videoDuration: cn('text-[0.875rem] text-obra-sand'),
  videoCaption: cn(
    'mx-0 mt-2.5 mb-0 flex gap-3 text-[clamp(1.0625rem,1.4vw,1.25rem)] leading-[1.7]',
    'text-obra-muted',
  ),
  note: cn('mx-0 my-2 flex flex-col gap-2 rounded-3xl bg-obra-mist px-6.5 py-5.5'),
  noteLabel: cn('ln-eyebrow'),
  noteText: cn('m-0 text-[1.0625rem] leading-[1.55]'),
  links: cn('flex flex-col gap-3'),
  linkCard: cn(
    'flex flex-col gap-1 rounded-3xl bg-obra-white px-5.5 py-4.5',
    '[transition:translate_0.5s_var(--ease-obra)] hover:-translate-y-0.5',
  ),
  linkTitle: cn('font-obra-serif text-[1.25rem]'),
  linkDescription: cn('text-[0.9375rem] text-obra-ink-soft'),
  linkSource: cn('text-[0.9375rem] text-obra-ink-soft'),
  divider: cn('mx-0 my-4 h-px bg-obra-ink/15'),
  tagsBlock: cn('mt-8 flex flex-col gap-3.5'),
  tags: cn('flex flex-wrap gap-2'),
  reactionsBlock: cn('mt-6 flex flex-col gap-3.5'),
  reactions: cn('flex flex-wrap gap-2'),
  reaction: cn(
    'inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border-0',
    'bg-obra-mist px-4.5 font-obra-sans-bold',
    'data-[active=true]:bg-obra-red data-[active=true]:text-white',
  ),
};
---

<div
  class={blogArticleBody.container}
>
  {
    article.body.map((block) => (
      <>
        {block.type === 'paragraph' && (
          <p class={cn(blogArticleBody.paragraph, { [DROP_CAP]: block.dropCap })} set:html={block.html} />
        )}

        {block.type === 'heading' && block.level === 2 && (
          <div class={blogArticleBody.h2Group} id={block.id}>
            {block.eyebrow && <span class={blogArticleBody.eyebrow}>{block.eyebrow}</span>}
            <h2 class={blogArticleBody.h2}>
              {block.text}
            </h2>
          </div>
        )}

        {block.type === 'heading' && block.level === 3 && (
          <h3 class={blogArticleBody.h3}>{block.text}</h3>
        )}

        {block.type === 'verse' && (
          <blockquote class={blogArticleBody.verse}>
            <p class={blogArticleBody.verseText}>{block.text}</p>
            <cite class={blogArticleBody.reference}>{block.reference}</cite>
          </blockquote>
        )}

        {block.type === 'figure' && (
          <figure class={blogArticleBody.figure}>
            <div
              class={cn(blogArticleBody.figureFrame, FIGURE_HEIGHT[block.aspect ?? 'landscape'])}
              style={`--tint: ${block.tint ?? 'var(--color-obra-linen)'}`}
            >
              <span class={blogArticleBody.figureMark}>
                <AnchorMark id="blog-fig" outline={false} class={blogArticleBody.figureAnchor} />
              </span>
            </div>
            <figcaption class={blogArticleBody.figureCaption}>
              <span>{block.label}</span><span>{block.caption}</span>
            </figcaption>
          </figure>
        )}

        {block.type === 'pullquote' && (
          <blockquote class={blogArticleBody.pullquote}>
            <p class={blogArticleBody.pullquoteText}>{block.quote}</p>
            {block.cite && (
              <cite class={blogArticleBody.pullquoteCite}>{block.cite}</cite>
            )}
          </blockquote>
        )}

        {block.type === 'list' && !block.ordered && (
          <ul class={blogArticleBody.bulletList}>
            {block.items.map((item) => (
              <li
                class={blogArticleBody.bulletItem}
              >
                <span set:html={item} />
              </li>
            ))}
          </ul>
        )}
        {block.type === 'list' && block.ordered && (
          <ol class={blogArticleBody.orderedList}>
            {block.items.map((item) => (
              <li class={blogArticleBody.orderedItem}>
                <span set:html={item} />
              </li>
            ))}
          </ol>
        )}

        {block.type === 'video' && (
          <div>
            <div class={blogArticleBody.video}>
              <div class={blogArticleBody.videoFrame}>
                <span class={blogArticleBody.videoPlay} aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="30" height="30"><path d="M9 6.5v11l9-5.5z" fill="#fff" /></svg>
                </span>
              </div>
              <div class={blogArticleBody.videoBar}>
                <span class={blogArticleBody.videoInfo}>
                  <span class={blogArticleBody.videoEyebrow}>
                    {block.eyebrow}
                  </span>
                  <b class={blogArticleBody.videoTitle}>{block.title}</b>
                  <small class={blogArticleBody.videoMeta}>{block.meta}</small>
                </span>
                <small class={blogArticleBody.videoDuration}>{block.duration}</small>
              </div>
            </div>
            <p class={blogArticleBody.videoCaption}>
              {block.caption}
            </p>
          </div>
        )}

        {block.type === 'note' && (
          <div class={blogArticleBody.note}>
            <span class={blogArticleBody.noteLabel}>{block.label}</span>
            <p class={blogArticleBody.noteText} set:html={block.html} />
          </div>
        )}

        {block.type === 'links' && (
          <div class={blogArticleBody.links}>
            {block.links.map((link) => (
              <a
                href={link.href}
                class={blogArticleBody.linkCard}
              >
                <b class={blogArticleBody.linkTitle}>{link.title}</b>
                <span class={blogArticleBody.linkDescription}>{link.description}</span>
                <span class={blogArticleBody.linkSource}>{link.sourceLabel} · {link.meta}</span>
              </a>
            ))}
          </div>
        )}

        {block.type === 'divider' && <hr class={blogArticleBody.divider} />}

        {block.type === 'tags' && (
          <div class={blogArticleBody.tagsBlock}>
            <div class={blogArticleBody.tags}>
              {block.tags.map((tag) => (
                <Chip href={localizePath('/blog', locale)}>{tag}</Chip>
              ))}
            </div>
          </div>
        )}

        {block.type === 'reactions' && (
          <div class={blogArticleBody.reactionsBlock}>
            <b>{block.prompt}</b>
            <div class={blogArticleBody.reactions}>
              {block.reactions.map((reaction) => (
                <button
                  type="button"
                  class={blogArticleBody.reaction}
                  data-blog-reaction
                  data-active="false"
                >
                  <span aria-hidden="true">{reaction.icon}</span>
                  {reaction.label}
                  <span data-reaction-count>{reaction.count}</span>
                </button>
              ))}
            </div>
          </div>
        )}
      </>
    ))
  }
</div>
