---
import type { BlogArticle, BlogArticleBodyBlock } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import AnchorMark from '../AnchorMark.astro';

interface Props {
  article: BlogArticle;
  locale: Locale;
}

const { article, locale } = Astro.props;
const figureClass = (block: Extract<BlogArticleBodyBlock, { type: 'figure' }>) =>
  block.aspect === 'wide' ? 'bl-fig--wide' : block.aspect === 'square' ? 'bl-fig--square' : '';
---

<div class="bl-body">
  {
    article.body.map((block) => (
      <>
        {block.type === 'paragraph' && <p class:list={[block.dropCap && 'bl-drop']} set:html={block.html} />}

        {block.type === 'heading' && block.level === 2 && (
          <div class="bl-h" id={block.id}>
            {block.eyebrow && <span class="ln-eyebrow">{block.eyebrow}</span>}
            <h2>{block.text}</h2>
          </div>
        )}

        {block.type === 'heading' && block.level === 3 && <h3>{block.text}</h3>}

        {block.type === 'verse' && (
          <blockquote class="bl-verse">
            <p>{block.text}</p>
            <cite>{block.reference}</cite>
          </blockquote>
        )}

        {block.type === 'figure' && (
          <figure class:list={['bl-fig', figureClass(block)]}>
            <div class="bl-art" style={`--tint: ${block.tint ?? '#efebe3'}`}>
              <span class="bl-anchor-ghost" style="width: 90px"><AnchorMark id="blog-fig" outline={false} /></span>
            </div>
            <figcaption><span>{block.label}</span><span>{block.caption}</span></figcaption>
          </figure>
        )}

        {block.type === 'pullquote' && (
          <blockquote class="bl-quote">
            <p>{block.quote}</p>
            {block.cite && <cite>{block.cite}</cite>}
          </blockquote>
        )}

        {block.type === 'list' && !block.ordered && <ul>{block.items.map((item) => <li><span set:html={item} /></li>)}</ul>}
        {block.type === 'list' && block.ordered && <ol>{block.items.map((item) => <li><span set:html={item} /></li>)}</ol>}

        {block.type === 'video' && (
          <div>
            <div class="bl-vid">
              <div class="bl-vid__screen">
                <span class="bl-vid__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="30" height="30"><path d="M9 6.5v11l9-5.5z" fill="#fff" /></svg>
                </span>
              </div>
              <div class="bl-vid__info">
                <span>
                  <span class="bl-vid__eyebrow">{block.eyebrow}</span>
                  <b>{block.title}</b>
                  <small>{block.meta}</small>
                </span>
                <small>{block.duration}</small>
              </div>
            </div>
            <p class="bl-vid__cap" style="margin-top: 10px">{block.caption}</p>
          </div>
        )}

        {block.type === 'note' && (
          <div class="bl-note">
            <span class="ln-eyebrow">{block.label}</span>
            <p set:html={block.html} />
          </div>
        )}

        {block.type === 'links' && (
          <div class="bl-links">
            {block.links.map((link) => (
              <a href={link.href} class="bl-link">
                <b>{link.title}</b>
                <span>{link.description}</span>
                <span>{link.sourceLabel} · {link.meta}</span>
              </a>
            ))}
          </div>
        )}

        {block.type === 'divider' && <hr class="bl-divider" />}

        {block.type === 'tags' && (
          <div class="bl-tags">
            <div>
              {block.tags.map((tag) => (
                <a href={localizePath('/blog', locale)} class="ln-chip">{tag}</a>
              ))}
            </div>
          </div>
        )}

        {block.type === 'reactions' && (
          <div class="bl-reactions">
            <b>{block.prompt}</b>
            <div>
              {block.reactions.map((reaction) => (
                <button type="button" class="bl-react" data-blog-reaction data-active="false">
                  <span aria-hidden="true">{reaction.icon}</span>
                  {reaction.label}
                  <span class="bl-react-count">{reaction.count}</span>
                </button>
              ))}
            </div>
          </div>
        )}
      </>
    ))
  }
</div>
