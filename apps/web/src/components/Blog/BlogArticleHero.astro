---
import type { BlogArticle } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import Pill from '../ui/Pill.astro';
import BlogCover from './BlogCover.astro';

interface Props {
  article: BlogArticle;
  copy: any;
  locale: Locale;
}

const { article, copy, locale } = Astro.props;
---

<header class="bl-art-head bl-pad">
  <nav class="bl-crumbs" aria-label="breadcrumb">
    <a href={localizePath('/blog', locale)}>Blog</a><span aria-hidden="true">/</span><b>{article.category}</b>
  </nav>
  <h1 class="ln-h bl-rise">{article.title}</h1>
  <p class="bl-lead bl-rise" style="--d: .15s">{article.description}</p>
  <div class="bl-author bl-rise" style="--d: .3s">
    <span class="bl-avatar" aria-hidden="true">{article.author.initials}</span>
    <span>
      <b>{article.author.name}</b>
      <small>{article.displayDate} · {article.readTime} · {article.wordCount} {copy.words}</small>
    </span>
  </div>
</header>

<section class="bl-cover bl-pad">
  <BlogCover tint={article.tint} size="lg" class="bl-rise">
    <Pill>{article.coverCaption}</Pill>
  </BlogCover>
</section>
