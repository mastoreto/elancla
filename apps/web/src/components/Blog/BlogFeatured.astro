---
import type { BlogArticle } from 'src/data/blog';
import { getBlogArticlePath } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import Button from '../ui/Button.astro';
import Pill from '../ui/Pill.astro';
import BlogCover from './BlogCover.astro';

interface Props {
  article: BlogArticle | null;
  copy: any;
  locale: Locale;
}

const { article, copy, locale } = Astro.props;
const href = article ? localizePath(getBlogArticlePath(article), locale) : '';
---

{article && (
  <section class="bl-section bl-pad">
    <span class="ln-eyebrow">{copy.counter}</span>
    <a href={href} class="bl-feat">
      <BlogCover tint={article.tint} size="lg" class="bl-feat__art">
        <Pill tone="red">{copy.featured}</Pill>
      </BlogCover>
      <div class="bl-feat__body">
        <span class="ln-eyebrow">{article.category} · {article.displayDate}</span>
        <h2 class="ln-h bl-feat__title">{article.title}</h2>
        <p class="bl-lead">{article.excerpt}</p>
        <div class="bl-feat__foot">
          <Button as="span" arrow>{copy.read}</Button>
          <small>{copy.by} {article.author.name} · {article.readTime}</small>
        </div>
      </div>
    </a>
  </section>
)}
