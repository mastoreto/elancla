---
import type { BlogArticle } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import BlogArticleCard from './BlogArticleCard.astro';

interface Props {
  articles: BlogArticle[];
  copy: any;
  by: string;
  locale: Locale;
}

const { articles, copy, by, locale } = Astro.props;
---

{articles.length > 0 && (
  <section class="bl-related bl-pad">
    <span class="ln-eyebrow">{copy.related}</span>
    <div class="bl-grid">
      {articles.map((article) => <BlogArticleCard article={article} by={by} locale={locale} />)}
    </div>
  </section>
)}
