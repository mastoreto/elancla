---
import Button from '../ui/Button.astro';
import AnchorMark from '../AnchorMark.astro';

interface Props {
  copy: any;
}

const { copy } = Astro.props;
const { frequency, now, categories } = copy.facts;
---

<section class="bl-hero bl-pad">
  <div class="bl-hero__text">
    <span class="ln-eyebrow bl-rise">{copy.eyebrow}</span>
    <h1 class="ln-h bl-hero__title bl-rise" style="--d: .15s">
      {copy.titleBefore}<em>{copy.emphasis}</em>{copy.titleAfter}
    </h1>
    <p class="bl-lead bl-rise" style="--d: .3s">{copy.body}</p>
    <div class="bl-hero__cta bl-rise" style="--d: .45s">
      <Button href="#articulos" arrow>{copy.primaryCta}</Button>
      <Button href="#newsletter" variant="ghost">{copy.secondaryCta}</Button>
    </div>
  </div>

  <div class="bl-facts bl-rise" style="--d: .5s">
    <div class="bl-fact">
      <small>{frequency.label}</small>
      <strong>{frequency.value}</strong>
      <span>{frequency.description}</span>
    </div>
    <div class="bl-fact bl-fact--red">
      <small>{now.label}</small>
      <strong>{now.value}</strong>
      <span>{now.description}</span>
    </div>
    <div class="bl-fact bl-fact--wide">
      <div>
        <small>{categories.label}</small>
        <strong>{categories.value}</strong>
      </div>
      <AnchorMark id="blog-fact-anchor" outline={false} />
    </div>
  </div>
</section>
