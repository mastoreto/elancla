---
interface Props {
  items: string[];
}

const { items } = Astro.props;
// Four copies so each half of the track is wider than any viewport; the track shifts -50% seamlessly.
const repeated = [...items, ...items, ...items, ...items];
---

<div class="bl-marquee" aria-hidden="true">
  <div class="bl-marquee__track">
    {repeated.map((item) => <span class="bl-marquee__item">{item}<i>●</i></span>)}
  </div>
</div>
