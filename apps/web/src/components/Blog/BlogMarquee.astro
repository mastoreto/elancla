---
interface Props {
  items: string[];
}

const { items } = Astro.props;
// Four copies so each half of the track is wider than any viewport; the track shifts -50% seamlessly.
const repeated = [...items, ...items, ...items, ...items];
---

<div
  class="mt-[clamp(3rem,6vw,4.5rem)] overflow-hidden bg-obra-warm py-6 text-obra-cream"
  aria-hidden="true"
>
  <div class="flex w-max animate-marquee motion-reduce:animate-none">
    {repeated.map((item) => (
      <span class="inline-flex items-center gap-7 pr-7 font-obra-serif text-[clamp(1.625rem,2.4vw,2.125rem)] font-bold whitespace-nowrap">
        {item}<i class="text-[0.6em] text-obra-red-live not-italic">●</i>
      </span>
    ))}
  </div>
</div>
