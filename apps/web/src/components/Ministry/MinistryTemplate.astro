---
import { ULINK } from 'src/styles/classes';
import type { ContentPage } from 'src/data/contentPages';
import AnchorMark from 'src/components/AnchorMark.astro';
import Pill from 'src/components/ui/Pill.astro';
import InlineText from 'src/components/ContentPage/InlineText.astro';
import { RISE_IN } from 'src/utils/riseIn';

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
const { hero, featuredImage, sections, cta } = page;
const sectionsWithBlocks = sections.map((section) => ({
  ...section,
  prose: section.blocks.find((b) => b.type === 'prose'),
  values: section.blocks.find((b) => b.type === 'values'),
  facts: section.blocks.find((b) => b.type === 'facts'),
  links: section.blocks.find((b) => b.type === 'linkGrid'),
}));
// Stat cards alternate white / red / mist, as in the design.
const statTone = ['bg-obra-white', 'bg-obra-red text-white', 'bg-obra-mist'];
const EMPHASIS = 'text-obra-red not-italic';
const CARD =
  'flex flex-col gap-3 rounded-[28px] bg-(--tint,var(--color-obra-mist)) text-inherit no-underline [transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s,background-color_0.4s] hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift';
const CARD_TITLE = 'font-obra-serif text-[1.625rem] leading-[1.1] font-bold';
const BOX = 'flex flex-col rounded-[28px] p-6';
const BOX_LABEL = 'font-obra-sans-bold text-[0.75rem] tracking-[0.16em] text-obra-muted uppercase';
---

<article class="ln bg-obra-paper pb-24">
  <header class="flex flex-col gap-9 px-gutter-sm pt-[clamp(7.5rem,11vw,9.5rem)]">
    <nav
      class="flex flex-wrap items-center gap-2 font-obra-sans-bold text-[0.875rem] text-obra-muted"
      aria-label="breadcrumb"
    >
      {
        hero.breadcrumbs.map((crumb, i) => (
          <>
            {crumb.href ? <a href={crumb.href} class:list={ULINK}>{crumb.label}</a> : <span class="text-obra-red" aria-current="page">{crumb.label}</span>}
            {i < hero.breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
          </>
        ))
      }
    </nav>

    <div class="flex items-end gap-16 max-lg:flex-col max-lg:items-start max-lg:gap-6">
      <div class="flex min-w-0 flex-1 flex-col gap-[1.4rem]">
        <span class:list={['ln-eyebrow inline-flex flex-wrap items-center gap-2.5 tracking-[0.16em]', RISE_IN]}>
          <span class="rounded-full bg-obra-red px-3 py-1.5 tracking-[0.08em] text-white">{hero.chip}</span>{hero.meta.join(' · ')}
        </span>
        <h1
          class:list={['ln-h text-[clamp(3.25rem,7.2vw,6.5rem)] wrap-anywhere', RISE_IN]}
          style="--d: 0.15s"
        >
          {hero.titleLines.map((line, i) => <>{i > 0 && ' '}<InlineText value={line} emphasisClass={EMPHASIS} /></>)}
        </h1>
      </div>
      <p
        class:list={[
          'm-0 flex-[0_0_min(26.25rem,100%)] text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55] text-obra-ink-soft max-lg:w-full max-lg:basis-auto',
          RISE_IN,
        ]}
        style="--d: 0.3s"
      >{hero.standfirst}</p>
    </div>

    {
      hero.stats?.length && (
        <div
          class:list={['grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-2.5', RISE_IN]}
          style="--d: 0.45s"
        >
          {hero.stats.map((stat, i) => (
            <div class:list={['flex flex-col gap-1 rounded-[32px] p-6', statTone[i % statTone.length]]}>
              <b class="font-obra-serif text-[clamp(2rem,3.6vw,3.25rem)] leading-none font-bold">{stat.value}</b>
              <span class="font-obra-sans-bold text-[0.8125rem] tracking-[0.12em] uppercase opacity-80">{stat.label}</span>
            </div>
          ))}
        </div>
      )
    }
  </header>

  {
    featuredImage && (
      <section class="px-gutter-sm pt-11">
        <div class="relative h-[clamp(15rem,36vw,32.5rem)] overflow-hidden rounded-[clamp(28px,3.3vw,48px)] bg-obra-warm">
          <img
            src={featuredImage.src}
            alt={featuredImage.alt}
            class="size-full object-cover object-[50%_60%] [filter:grayscale(1)_sepia(0.14)_contrast(1.06)]"
            loading="eager"
          />
          {featuredImage.label && <Pill class="absolute top-4.5 left-4.5">{featuredImage.label}</Pill>}
          {featuredImage.badge && <Pill class="absolute bottom-4.5 left-4.5">{featuredImage.badge}</Pill>}
        </div>
      </section>
    )
  }

  <section class="flex gap-14 px-gutter-sm pt-[clamp(3.5rem,6vw,5.5rem)] max-lg:flex-col">
    <div class="flex min-w-0 flex-1 flex-col gap-[clamp(4rem,7vw,6.875rem)]">
      {
        sectionsWithBlocks.map((section) => (
          <section id={section.id} class="flex scroll-mt-28 flex-col gap-7">
            <div class="flex flex-col gap-3.5">
              <span class="ln-eyebrow">{section.eyebrow}</span>
              <h2 class="ln-h text-[clamp(2rem,3.6vw,3.25rem)]"><InlineText value={section.title} emphasisClass={EMPHASIS} /></h2>
            </div>

            {section.prose?.type === 'prose' && section.prose.paragraphs.map((p) => <p class="m-0 text-[clamp(1.0625rem,1.4vw,1.25rem)] leading-[1.7]" set:html={p} />)}

            {
              section.values?.type === 'values' && (
                <div class="grid grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] gap-3.5">
                  {section.values.values.map((v) => (
                    <div class:list={[CARD, 'p-6.5']}>
                      <span class="font-obra-serif text-[2.75rem] leading-none font-bold text-obra-red">{v.number}</span>
                      <b class={CARD_TITLE}>{v.title}</b>
                      <span class="text-[1rem] leading-[1.55] text-obra-ink-soft">{v.description}</span>
                    </div>
                  ))}
                </div>
              )
            }

            {
              section.facts?.type === 'facts' && (
                <dl class="m-0 grid grid-cols-[1fr_1fr] gap-x-10 max-[640px]:grid-cols-[1fr]">
                  {section.facts.facts.map((f) => (
                    <div class="flex flex-col gap-1 border-t border-obra-ink/14 py-4">
                      <dt class="font-obra-sans-bold text-[0.75rem] tracking-[0.14em] text-obra-muted uppercase">{f.label}</dt>
                      <dd class="m-0 font-obra-sans-bold text-[1.125rem] leading-[1.35]">{f.value}</dd>
                    </div>
                  ))}
                </dl>
              )
            }

            {
              section.links?.type === 'linkGrid' && (
                <div class="grid grid-cols-[repeat(auto-fit,minmax(19rem,1fr))] gap-3.5">
                  {section.links.links.map((link) => (
                    <a
                      href={link.href}
                      class:list={[CARD, 'flex-row items-start gap-4.5 p-6']}
                      style={link.tint ? `--tint: ${link.tint}` : undefined}
                    >
                      <span
                        class="inline-flex size-14 flex-none items-center justify-center rounded-[18px] bg-obra-red font-obra-serif text-[1.625rem] font-bold text-white"
                        aria-hidden="true"
                      >
                        {link.glyph}
                      </span>
                      <span class="flex flex-col gap-2 text-[1rem] leading-[1.55] text-obra-ink-soft">
                        <small class="font-obra-sans-bold text-[0.6875rem] tracking-[0.14em] text-obra-muted uppercase">{link.sourceLabel}</small>
                        <b class={CARD_TITLE}>{link.title}</b>
                        <span class="text-[0.9375rem] leading-normal text-obra-ink-soft">{link.description}</span>
                        <em class="font-obra-sans-bold text-[0.8125rem] text-obra-red not-italic">{link.meta} →</em>
                      </span>
                    </a>
                  ))}
                </div>
              )
            }
          </section>
        ))
      }
    </div>

    <aside class="sticky top-28 flex flex-[0_0_17.5rem] flex-col gap-5 self-start max-lg:hidden">
      <div class:list={[BOX, 'gap-3.5 bg-obra-white']}>
        <span class={BOX_LABEL}>{page.tocTitle}</span>
        <nav class="flex flex-col gap-3.5">
          {
            sections.map((section, i) => (
              <a
                href={`#${section.id}`}
                class="relative m-0 flex gap-3 border-0 p-0 font-obra-sans-bold text-[0.9375rem] leading-[1.4] font-normal text-obra-ink [transition:color_0.3s] hover:text-obra-red [&.active]:text-obra-red"
                data-content-toc
                data-target={section.id}
              >
                <span class="text-obra-red">{String(i + 1).padStart(2, '0')}</span>{section.tocLabel}
              </a>
            ))
          }
        </nav>
      </div>
      {
        page.shortcuts?.length && (
          <div class:list={[BOX, 'gap-3 bg-obra-mist']}>
            <span class={BOX_LABEL}>{page.shortcutsTitle}</span>
            {page.shortcuts.map((s) => (
              <a href={s.href} class:list={[ULINK, 'w-fit font-obra-sans-bold text-[0.9375rem]']}>{s.label}</a>
            ))}
          </div>
        )
      }
    </aside>
  </section>

  {
    cta && (
      <section class="px-gutter-sm pt-[clamp(3.5rem,6vw,5rem)]">
        <div class="relative flex items-center gap-14 overflow-hidden rounded-[clamp(28px,3.3vw,48px)] bg-obra-red p-[clamp(2rem,4.4vw,4rem)] text-white max-lg:flex-col max-lg:items-start max-lg:gap-6">
          <AnchorMark
            id="mn-cta"
            color="#fff"
            outline={false}
            class="pointer-events-none absolute right-8 -bottom-8 h-auto w-64 opacity-10"
          />
          <div class="relative flex flex-1 flex-col gap-3.5">
            <span class="font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-blush uppercase">{cta.eyebrow}</span>
            <h2 class="ln-h text-[clamp(2.25rem,3.9vw,3.5rem)] leading-none">
              <InlineText value={cta.title} emphasisClass="not-italic" />
            </h2>
            <p class="m-0 max-w-120 text-[1.125rem] leading-normal">{cta.body}</p>
          </div>
          <div class="relative flex flex-[0_0_min(22.5rem,100%)] flex-col gap-3 max-lg:w-full max-lg:basis-auto">
            <a href={cta.primary.href} class="ln-btn ln-btn--dark justify-center px-6.5">{cta.primary.label}</a>
            {cta.secondary && <a
                href={cta.secondary.href}
                class="ln-btn justify-center border-[1.5px] border-white px-6.5 text-white"
              >{cta.secondary.label}</a>}
          </div>
        </div>
      </section>
    )
  }
</article>

<script>
  import { initContentPage } from 'src/scripts/contentPage';
  initContentPage();
</script>
