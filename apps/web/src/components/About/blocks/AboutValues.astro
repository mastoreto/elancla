---
import type { ContentValuesBlock } from 'src/data/contentPages';

interface Props {
  block: ContentValuesBlock;
}

const { block } = Astro.props;
---

<div class="grid grid-cols-[1fr] gap-3.5 md:grid-cols-[repeat(3,1fr)]">
  {
    block.values.map((v) => (
      <div class="flex flex-col gap-3 rounded-[28px] bg-obra-mist p-6.5 text-inherit no-underline [transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s_var(--ease-obra),background-color_0.4s] hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift motion-reduce:transition-none">
        <span class="font-obra-serif text-[2.75rem] leading-none font-bold text-obra-red">{v.number}</span>
        <b class="font-obra-serif text-[1.625rem] leading-[1.1] font-bold">{v.title}</b>
        <span class="text-[1rem] leading-[1.55] text-obra-ink-soft">{v.description}</span>
      </div>
    ))
  }
</div>
{
  block.note && (
    <div class="flex flex-col gap-1.5 rounded-3xl bg-obra-white px-6 py-5">
      <span class="ln-eyebrow">{block.note.label}</span>
      <p
        class="m-0 text-[1rem] leading-[1.55] [&_a]:font-obra-sans-bold [&_a]:text-obra-red [&_a]:underline [&_a]:underline-offset-3"
        set:html={block.note.html}
      />
    </div>
  )
}
