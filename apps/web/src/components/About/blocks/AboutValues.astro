---
import type { ContentValuesBlock } from 'src/data/contentPages';

interface Props {
  block: ContentValuesBlock;
}

const { block } = Astro.props;
---

<div class="ab-grid ab-grid--3">
  {
    block.values.map((v) => (
      <div class="ab-card">
        <span class="ab-card__num">{v.number}</span>
        <b class="ab-card__title">{v.title}</b>
        <span class="ab-card__text">{v.description}</span>
      </div>
    ))
  }
</div>
{
  block.note && (
    <div class="ab-note">
      <span class="ln-eyebrow">{block.note.label}</span>
      <p set:html={block.note.html} />
    </div>
  )
}
