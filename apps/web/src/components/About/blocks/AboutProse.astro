---
import type { ContentProseBlock } from 'src/data/contentPages';

interface Props {
  block: ContentProseBlock;
}

const { block } = Astro.props;
---

<div class="flex flex-col gap-7 [&_b]:font-obra-sans-bold [&_b]:font-bold [&_strong]:font-obra-sans-bold [&_strong]:font-bold">
  {block.paragraphs.map((p) => <p class="m-0 text-[clamp(1.125rem,1.4vw,1.25rem)] leading-[1.7]" set:html={p} />)}
</div>
