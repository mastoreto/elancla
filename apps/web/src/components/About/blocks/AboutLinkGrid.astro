---
import type { ContentLinkGridBlock } from 'src/data/contentPages';

interface Props {
  block: ContentLinkGridBlock;
}

const { block } = Astro.props;
---

<div class="ab-grid ab-grid--2">
  {
    block.links.map((link) => (
      <a
        href={link.href}
        class="ab-card ab-link"
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
      >
        <span class="ab-link__body">
          <b class="ab-card__title">{link.title}</b>
          <span class="ab-card__text">{link.description}</span>
        </span>
        <span class="ab-link__meta">{link.meta} →</span>
      </a>
    ))
  }
</div>
