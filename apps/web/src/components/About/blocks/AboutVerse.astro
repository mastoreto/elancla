---
import AnchorMark from 'src/components/AnchorMark.astro';
import type { ContentVerseBlock } from 'src/data/contentPages';

interface Props {
  block: ContentVerseBlock;
  sectionId: string;
}

const { block, sectionId } = Astro.props;
---

<blockquote class="ab-verse">
  <AnchorMark id={`ab-verse-${sectionId}`} color="#fff" outline={false} class="ab-verse__anchor" />
  <p>«{block.text}»</p>
  <cite>{block.reference}</cite>
</blockquote>
