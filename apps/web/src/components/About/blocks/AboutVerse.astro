---
import AnchorMark from 'src/components/AnchorMark.astro';
import type { ContentVerseBlock } from 'src/data/contentPages';

interface Props {
  block: ContentVerseBlock;
  sectionId: string;
}

const { block, sectionId } = Astro.props;
---

<blockquote class="relative m-0 flex flex-col gap-3.5 overflow-hidden rounded-[clamp(1.75rem,2.8vw,2.5rem)] bg-obra-red p-[clamp(1.75rem,3vw,2.75rem)] text-white">
  <AnchorMark id={`ab-verse-${sectionId}`} color="#fff" outline={false} class="absolute right-5 -bottom-7.5 h-auto w-[9.4rem] opacity-12" />
  <p class="relative m-0 font-obra-serif text-[clamp(1.625rem,2.5vw,2.25rem)] leading-[1.15] font-bold">«{block.text}»</p>
  <cite class="relative font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-blush uppercase not-italic">{block.reference}</cite>
</blockquote>
