---
import type { ContentTimelineBlock } from 'src/data/contentPages';

interface Props {
  block: ContentTimelineBlock;
}

const { block } = Astro.props;
---

<ol class="ab-timeline">
  {
    block.items.map((item) => (
      <li class="ab-timeline__row">
        <span class="ab-timeline__year">{item.year}</span>
        <span class="ab-timeline__body">
          <b>{item.title}</b>
          <span>{item.description}</span>
        </span>
      </li>
    ))
  }
</ol>
