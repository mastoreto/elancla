---
import type { ContentPage } from 'src/data/contentPages';
import AboutCTA from './AboutCTA.astro';
import AboutFigure from './AboutFigure.astro';
import AboutHero from './AboutHero.astro';
import AboutSection from './AboutSection.astro';
import AboutToc from './AboutToc.astro';
import 'src/styles/About.css';

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
---

<div class="ln ab">
  <AboutHero hero={page.hero} />
  {page.featuredImage && <AboutFigure figure={page.featuredImage} />}
  <div class="ab-body">
    <div class="ab-sections">
      {page.sections.map((section) => <AboutSection section={section} />)}
    </div>
    <AboutToc title={page.tocTitle ?? ''} sections={page.sections} />
  </div>
  {page.cta && <AboutCTA cta={page.cta} />}
</div>

<script>
  import 'src/scripts/about.ts';
</script>
