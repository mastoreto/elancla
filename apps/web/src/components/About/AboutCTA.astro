---
import Button from 'src/components/ui/Button';
import AnchorMark from 'src/components/AnchorMark.astro';
import InlineText from 'src/components/ContentPage/InlineText.astro';
import type { ContentCta } from 'src/data/contentPages';

interface Props {
  cta: ContentCta;
}

const { cta } = Astro.props;
---

<section class="px-gutter-sm pt-[clamp(3.5rem,6.1vw,5.5rem)]">
  <div class="relative flex flex-col gap-5.5 overflow-hidden rounded-[clamp(2rem,3.3vw,3rem)] bg-obra-warm px-[clamp(1.5rem,5vw,4.5rem)] py-[clamp(2rem,5vw,4.5rem)] text-obra-cream">
    <AnchorMark id="ab-cta" color="#f4efe6" outline={false} class="absolute right-10 -bottom-10 h-auto w-64 opacity-10" />
    <span class="font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-red-live uppercase">{cta.eyebrow}</span>
    <h2 class="ln-h relative text-[clamp(2.75rem,6.1vw,5.5rem)]">
      <InlineText value={cta.title} emphasisClass="text-obra-red-live not-italic" />
    </h2>
    <p class="relative m-0 max-w-140 text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55] text-obra-sand">{cta.body}</p>
    <div class="relative flex flex-wrap gap-3">
      <Button href={cta.primary.href} arrow>{cta.primary.label}</Button>
      {cta.secondary && <Button href={cta.secondary.href} variant="ghost" class="border-obra-white/70 text-white">{cta.secondary.label}</Button>}
    </div>
  </div>
</section>
