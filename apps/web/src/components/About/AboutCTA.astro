---
import AnchorMark from 'src/components/AnchorMark.astro';
import InlineText from 'src/components/ContentPage/InlineText.astro';
import type { ContentCta } from 'src/data/contentPages';

interface Props {
  cta: ContentCta;
}

const { cta } = Astro.props;
---

<section class="ab-cta-wrap">
  <div class="ab-cta">
    <AnchorMark id="ab-cta" color="#f4efe6" outline={false} class="ab-cta__anchor" />
    <span class="ab-cta__eyebrow">{cta.eyebrow}</span>
    <h2 class="ln-h ab-cta__title"><InlineText value={cta.title} emphasisClass="ab-cta__accent" /></h2>
    <p class="ab-cta__body">{cta.body}</p>
    <div class="ab-cta__buttons">
      <a href={cta.primary.href} class="ln-btn">{cta.primary.label}<span class="ln-btn__dot" aria-hidden="true">→</span></a>
      {cta.secondary && <a href={cta.secondary.href} class="ln-btn ln-btn--ghost ab-cta__ghost">{cta.secondary.label}</a>}
    </div>
  </div>
</section>
