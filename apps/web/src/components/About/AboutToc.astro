---
import type { ContentSection } from 'src/data/contentPages';

interface Props {
  title: string;
  sections: ContentSection[];
}

const { title, sections } = Astro.props;
---

<aside class="ab-toc">
  <span class="ab-toc__title">{title}</span>
  <nav class="ab-toc__nav" aria-label={title}>
    {sections.map((s) => <a href={`#${s.id}`} class="ab-toc__link ulink" data-target={s.id}>{s.tocLabel}</a>)}
  </nav>
</aside>
