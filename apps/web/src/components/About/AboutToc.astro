---
import type { ContentSection } from 'src/data/contentPages';

interface Props {
  title: string;
  sections: ContentSection[];
}

const { title, sections } = Astro.props;
---

<aside class="sticky top-28 flex flex-[0_0_14.375rem] flex-col gap-3.5 self-start max-lg:hidden">
  <span class="font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] uppercase text-obra-muted">{title}</span>
  <nav class="flex flex-col gap-3.5" aria-label={title}>
    {sections.map((s) => <a
          href={`#${s.id}`}
          class="ulink w-fit font-obra-sans-bold text-[0.9375rem] text-obra-muted no-underline [transition:color_0.3s] [&.is-active]:text-obra-red"
          data-toc-link
          data-target={s.id}
        >{s.tocLabel}</a>)}
  </nav>
</aside>
