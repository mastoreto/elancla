---
import AnchorMark from './AnchorMark.astro';
import LogoText from './LogoText.astro';
---

<!-- First-visit intro: the anchor is drawn and forged on a dark ground, then flies to the nav logo. -->
<div class="site-loader" role="status" aria-label="Cargando el sitio" data-site-loader transition:persist>
  <div class="ldr-cap" data-ldr-cap>
    <LogoText label="Iglesia Bautista" name="El Ancla" class="text-[26px]" />
  </div>
</div>
<div class="ldr-anchor" aria-hidden="true" data-ldr-anchor transition:persist>
  <AnchorMark id="ldr" strokeWidth={28} fillFrom="empty" />
</div>

<div class="ldr-hint" aria-hidden="true" data-ldr-hint transition:persist>
  <span>Desliza</span>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
</div>

<noscript>
  <style>
    .site-loader, .ldr-anchor { display: none !important; }
  </style>
</noscript>

<script>
  import { initLoadingOverlay } from 'src/scripts/loading';

  initLoadingOverlay();
</script>
