---
import cn from '../utils/cn.ts';

const card = {
  container: cn(
    'w-[21.688rem] h-[28.625rem]',
    'rounded-md flex flex-col',
    'shadow-xl'
  ),
  cardBody: cn(
    'h-3/5 flex flex-col text-sm',
    'font-montserrat justify-between px-3 py-3'
  ),
  link: cn(
    'bg-primary-500 font-montserrat',
    'text-white text-xl font-bold rounded-xl py-2 mt-2 w-[10rem]',
    'text-center px-5 w-full mb-2 mx-auto'
  ),
  thumb: cn('h-2/5'),
  thumbImage: cn('w-full h-full object-cover rounded-t-md'),
  date: cn('text-right font-montserrat text-sm'),
  series: cn('mb-3'),
  seriesLabel: cn('font-montserrat'),
  seriesName: cn('font-barastika text-2xl'),
  speaker: cn('font-montserrat'),
  speakerLabel: cn('text-md'),
  speakerName: cn('font-barastika font-bold text-2xl'),
};
---

<div class={card.container}>
  <div class={card.thumb}>
    <img
      src="/images/miniaturas.png"
      alt="Sermon"
      class={card.thumbImage}
    />
  </div>
  <div class={card.cardBody}>
    <p class={card.date}>21 de Mayo 2024</p>
    <div>
      <div class={card.series}>
        <h3 class={card.seriesLabel}>Serie</h3>
        <span class={card.seriesName}>Hebreos</span>
      </div>
      <div class={card.speaker}>
        <p class={card.speakerLabel}>Expositor</p>
        <p class={card.speakerName}>Pr. Juan Olivera</p>
      </div>
    </div>
    <a
      href="#"
      target="_blank"
      target-rel="noopener noreferrer"
      class={card.link}
    >
      Ver Ahora
    </a>
  </div>
</div>
