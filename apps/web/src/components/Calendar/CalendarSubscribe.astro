---
import AnchorMark from 'src/components/AnchorMark.astro';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['calendar'];
  googleHref: string;
  icsHref: string;
}
const { copy, googleHref, icsHref } = Astro.props;
---

<section class="cal-wrap cal-section">
  <div class="cal-sub">
    <span class="cal-sub__mark" aria-hidden="true"><AnchorMark id="cal-sub" outline={false} color="#fff" /></span>
    <div class="cal-sub__body">
      <span class="cal-sub__eyebrow">{copy.subscribe.eyebrow}</span>
      <h3 class="ln-h cal-sub__title">{copy.subscribe.title}</h3>
    </div>
    <div class="cal-sub__actions">
      <a href={googleHref} class="ln-btn" target="_blank" rel="noopener">{copy.subscribe.google}</a>
      <a href={icsHref} class="ln-btn ln-btn--outline">{copy.subscribe.ics}</a>
    </div>
  </div>
</section>
