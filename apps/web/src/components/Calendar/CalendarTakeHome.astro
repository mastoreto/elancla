---
import AnchorMark from 'src/components/AnchorMark.astro';
import type { Messages } from 'src/i18n/messages';
import { CALENDAR_YEAR } from 'src/data/calendar';

interface Props {
  copy: Messages['calendar'];
}
const { copy } = Astro.props;
const { print, download } = copy.take;
// Printable views are in Spanish and shared by every locale.
const PRINT_BASE = '/calendario-anual/imprimir';
---

<section class="cal-wrap cal-section" id="llevalo">
  <h2 class="ln-h cal-title">{copy.take.title}<em>{copy.take.emphasis}</em></h2>
  <div class="cal-take">
    <form class="cal-card" action="#" method="post">
      <span class="ln-eyebrow">{print.eyebrow}</span>
      <h3 class="cal-card__title">{print.title}</h3>
      <p class="cal-lead">{print.body}</p>
      <div class="cal-field">
        <label for="cal-name">{print.name}</label>
        <input id="cal-name" name="name" type="text" autocomplete="name" placeholder={print.namePlaceholder} required />
      </div>
      <div class="cal-field">
        <label for="cal-wa">{print.whatsapp}</label>
        <input id="cal-wa" name="whatsapp" type="tel" autocomplete="tel" placeholder={print.whatsappPlaceholder} required />
      </div>
      <div class="cal-field">
        <label for="cal-qty">{print.quantity}</label>
        <input id="cal-qty" name="quantity" type="number" min="1" max="20" value="1" required />
      </div>
      <button type="submit" class="ln-btn">{print.submit}<span class="ln-btn__dot" aria-hidden="true">→</span></button>
    </form>

    <div class="cal-card cal-card--mist">
      <span class="ln-eyebrow">{download.eyebrow}</span>
      <h3 class="cal-card__title">{download.title}</h3>
      <div class="cal-dl">
        <div class="cal-dl__item">
          <div class="cal-dl__thumb cal-dl__thumb--paper" aria-hidden="true">
            {Array.from({ length: 12 }, () => <span></span>)}
          </div>
          <b>{download.pdf.title}</b>
          <p>{download.pdf.body}</p>
          <a href={`${PRINT_BASE}/a3?descargar`} class="ln-btn" style="background:var(--ln-ink)" target="_blank" rel="noopener">{download.pdf.ctaA3}</a>
          <a href={`${PRINT_BASE}/a4?descargar`} class="ln-btn" style="background:var(--ln-ink)" target="_blank" rel="noopener">{download.pdf.ctaA4}</a>
        </div>
        <div class="cal-dl__item">
          <div class="cal-dl__thumb cal-dl__thumb--screen" aria-hidden="true">
            <b class="ln-h">{download.digital.cover}<br />{CALENDAR_YEAR}</b>
            <AnchorMark id="cal-dl" outline={false} color="#ff2e34" class="w-[46px]" />
          </div>
          <b>{download.digital.title}</b>
          <p>{download.digital.body}</p>
          <a href={`${PRINT_BASE}/digital?descargar`} class="ln-btn ln-btn--ghost" target="_blank" rel="noopener">{download.digital.cta}</a>
        </div>
      </div>
    </div>
  </div>
</section>
