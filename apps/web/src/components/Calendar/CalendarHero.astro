---
import Button from 'src/components/ui/Button';
import type { Messages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import type { Locale } from 'src/i18n/config';
import CalendarDate from './CalendarDate.astro';
import { EMPHASIS, LEAD, SECTION, SECTION_SPACING } from './styles';

interface Props {
  copy: Messages['calendar'];
  locale: Locale;
  next: { day: number; weekday: string; month: string; title: string };
}
const { copy, locale, next } = Astro.props;
---

<section class:list={[SECTION, SECTION_SPACING.hero]}>
  <nav class="flex items-center gap-2 font-obra-sans-bold text-[0.875rem] text-obra-muted" aria-label="Breadcrumb">
    <a href={localizePath('/', locale)} class="text-inherit no-underline hover:underline">{copy.breadcrumbs.home}</a>
    <span aria-hidden="true">/</span>
    <span>{copy.breadcrumbs.resources}</span>
    <span aria-hidden="true">/</span>
    <span class="text-obra-red" aria-current="page">{copy.breadcrumbs.current}</span>
  </nav>
  <div class="flex flex-col gap-12 max-md:gap-7 lg:flex-row lg:items-end lg:gap-16">
    <div class="flex flex-1 flex-col gap-6">
      <span class="ln-eyebrow">{copy.hero.eyebrow}</span>
      <h1 class="ln-h text-[clamp(2.75rem,7.2vw,6.5rem)] leading-[0.94] tracking-[-0.03em] text-balance max-md:text-[clamp(2.5rem,12.8vw,3.125rem)]">
        {copy.hero.titleBefore}<em class={EMPHASIS}>{copy.hero.titleEmphasis}</em>
      </h1>
      <p class={LEAD}>{copy.hero.body}</p>
      <div class="flex flex-wrap gap-3">
        <Button href="#llevalo" arrow>{copy.hero.orderCta}</Button>
        <Button href="#llevalo" variant="ghost">{copy.hero.downloadCta}</Button>
      </div>
    </div>
    <div class="flex w-full max-w-110 flex-none flex-col gap-3.5 rounded-[36px] bg-obra-warm p-7.5 text-obra-cream max-md:max-w-none max-md:rounded-[28px] max-md:p-5.5">
      <span class="font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-red-live uppercase">{copy.hero.nextLabel}</span>
      <div class="flex items-center gap-4.5">
        <CalendarDate day={next.day} label={`${next.weekday} · ${next.month}`} tone="hero" />
        <b class="font-obra-serif text-[1.625rem] leading-[1.05]">{next.title}</b>
      </div>
    </div>
  </div>
</section>
