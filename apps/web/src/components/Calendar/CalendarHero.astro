---
import type { Messages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import type { Locale } from 'src/i18n/config';

interface Props {
  copy: Messages['calendar'];
  locale: Locale;
  next: { day: number; weekday: string; month: string; title: string };
}
const { copy, locale, next } = Astro.props;
---

<section class="cal-wrap cal-section cal-hero">
  <nav class="cal-crumbs" aria-label="Breadcrumb">
    <a href={localizePath('/', locale)}>{copy.breadcrumbs.home}</a>
    <span aria-hidden="true">/</span>
    <span>{copy.breadcrumbs.resources}</span>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{copy.breadcrumbs.current}</span>
  </nav>
  <div class="cal-hero__row">
    <div class="cal-hero__text">
      <span class="ln-eyebrow">{copy.hero.eyebrow}</span>
      <h1 class="ln-h cal-hero__title">{copy.hero.titleBefore}<em>{copy.hero.titleEmphasis}</em></h1>
      <p class="cal-lead">{copy.hero.body}</p>
      <div class="cal-hero__actions">
        <a href="#llevalo" class="ln-btn">{copy.hero.orderCta}<span class="ln-btn__dot" aria-hidden="true">→</span></a>
        <a href="#llevalo" class="ln-btn ln-btn--ghost">{copy.hero.downloadCta}</a>
      </div>
    </div>
    <div class="cal-next">
      <span class="cal-next__label">{copy.hero.nextLabel}</span>
      <div class="cal-next__body">
        <div class="cal-date">
          <b class="cal-date__num">{next.day}</b>
          <span class="cal-date__txt">{next.weekday} · {next.month}</span>
        </div>
        <b class="cal-next__title">{next.title}</b>
      </div>
    </div>
  </div>
</section>
