---
import { MINISTRY_COLORS, MINISTRY_KEYS } from 'src/data/calendar';
import type { Locale } from 'src/i18n/config';
import { getHtmlLang } from 'src/i18n/utils';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['calendar'];
  locale: Locale;
}
const { copy, locale } = Astro.props;

const monthFormat = new Intl.DateTimeFormat(getHtmlLang(locale), { month: 'short', timeZone: 'UTC' });
const months = Array.from({ length: 12 }, (_, i) => monthFormat.format(new Date(Date.UTC(2027, i, 1))).replace('.', ''));
---

<div class="cal-filters" data-cal-filters>
  <div class="cal-chips" role="group" aria-label={copy.months.monthFilterLabel}>
    <button type="button" class="cal-chip" data-cal-month="all" aria-pressed="true">{copy.months.allYear}</button>
    {months.map((label, i) => (
      <button type="button" class="cal-chip" data-cal-month={i} aria-pressed="false" style="text-transform:capitalize">{label}</button>
    ))}
  </div>
  <div class="cal-chips" role="group" aria-label={copy.months.ministryFilterLabel}>
    <button type="button" class="cal-chip cal-chip--ministry" data-cal-ministry="all" aria-pressed="true">
      <span class="cal-dot" style="--c:#fff"></span>{copy.months.allMinistries}
    </button>
    {MINISTRY_KEYS.map((key) => (
      <button type="button" class="cal-chip cal-chip--ministry" data-cal-ministry={key} aria-pressed="false">
        <span class="cal-dot" style={`--c:${MINISTRY_COLORS[key]}`}></span>{copy.ministries[key]}
      </button>
    ))}
  </div>
</div>
