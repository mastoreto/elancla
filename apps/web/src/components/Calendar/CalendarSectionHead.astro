---
// Eyebrow + two-tone title (+ optional lead) shared by every calendar section.
import { EMPHASIS, LEAD, TITLE } from './styles';

interface Props {
  eyebrow?: string;
  title: string;
  emphasis: string;
  body?: string;
}
const { eyebrow, title, emphasis, body } = Astro.props;
---

<div class="flex flex-col gap-2.5">
  {eyebrow && <span class="ln-eyebrow">{eyebrow}</span>}
  <h2 class={TITLE}>{title}<em class={EMPHASIS}>{emphasis}</em></h2>
  {body && <p class={LEAD}>{body}</p>}
</div>
