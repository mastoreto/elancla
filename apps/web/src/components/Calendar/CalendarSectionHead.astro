---
// Eyebrow + two-tone title (+ optional lead) shared by every calendar section.
interface Props {
  eyebrow?: string;
  title: string;
  emphasis: string;
  body?: string;
}
const { eyebrow, title, emphasis, body } = Astro.props;
---

<div style="display:flex;flex-direction:column;gap:10px">
  {eyebrow && <span class="ln-eyebrow">{eyebrow}</span>}
  <h2 class="ln-h cal-title">{title}<em>{emphasis}</em></h2>
  {body && <p class="cal-lead">{body}</p>}
</div>
