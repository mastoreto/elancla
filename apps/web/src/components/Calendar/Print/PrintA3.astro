---
import AnchorMark from 'src/components/AnchorMark.astro';
import { CALENDAR_YEAR, events, eventsOfMonth, weeklySorted } from 'src/data/calendar';
import PrintMonthGrid from './PrintMonthGrid.astro';
import { MONTHS_ES, dayOf, weekdayShortByIndex, capitalize } from './printFormat';
import { EYEBROW, EYEBROW_TONE, SERIF, SHEET, SHEET_TONE } from './styles';

const weekly = weeklySorted();
---

<section class:list={[SHEET, SHEET_TONE.light, 'h-[296.6mm] w-[420mm] gap-7 px-16 py-14']}>
  <header class="flex items-end justify-between">
    <div class="flex items-center gap-6.5">
      <AnchorMark id="cp-a3" outline={false} color="#a8141b" class="h-[71px] w-14 flex-none" />
      <div class="flex flex-col gap-1.5">
        <span class:list={[EYEBROW, EYEBROW_TONE.red]}>Iglesia Bautista El Ancla · Montevideo</span>
        <b class:list={[SERIF, 'text-[96px] leading-[0.9] tracking-[-0.03em]']}>Calendario {CALENDAR_YEAR}</b>
      </div>
    </div>
    <div class="flex flex-col gap-[3px] text-right text-[14px]">
      <span class:list={[EYEBROW, EYEBROW_TONE.ink]}>Cada semana</span>
      {weekly.map((a) => <span><b>{capitalize(weekdayShortByIndex(a.day))} {a.time}</b> {a.title}</span>)}
    </div>
  </header>

  <div class="grid grid-cols-[repeat(6,1fr)] gap-4">
    {MONTHS_ES.map((name, month) => {
      const list = eventsOfMonth(events, month);
      return (
        <div class="flex flex-col gap-2.5 rounded-[22px] bg-obra-white p-4.5">
          <b class:list={[SERIF, 'text-[24px]']}>{name}</b>
          <PrintMonthGrid year={CALENDAR_YEAR} month={month} eventDays={list.map(dayOf)} />
          <div class="flex min-h-[68px] flex-col gap-1 border-t border-obra-chalk pt-2">
            {list.map((e) => (
              <div class="flex gap-2 text-[12px] leading-[1.3]"><b class="w-5 flex-none text-obra-red">{dayOf(e)}</b><span>{e.title}</span></div>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <footer class="mt-auto flex justify-between text-[13px] text-obra-muted">
    <span>Círculos rojos: actividades de los ministerios. Fechas de ejemplo.</span>
    <span>Para imprimir en A3 · escala 100%</span>
  </footer>
</section>
