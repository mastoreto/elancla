---
// Compact month grid (L M M J V S D). Event days get a red circle, Sundays are red.
import { monthLayout } from 'src/data/calendar';

interface Props {
  year: number;
  month: number;
  eventDays: number[];
  size?: 'a3' | 'slide';
}
const { year, month, eventDays, size = 'a3' } = Astro.props;
const { lead, days } = monthLayout(year, month);
const cells = Array.from({ length: days }, (_, i) => i + 1);
---

<div class:list={['cp-grid', `cp-grid--${size}`]}>
  {['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((letter) => <span class="cp-grid__wd">{letter}</span>)}
  {Array.from({ length: lead }, () => <span></span>)}
  {cells.map((day, i) => (
    <span class:list={['cp-grid__d', (lead + i) % 7 === 6 && 'is-sun', eventDays.includes(day) && 'is-event']}>{day}</span>
  ))}
</div>
