---
import AnchorMark from 'src/components/AnchorMark.astro';
import { CALENDAR_YEAR, events, eventsOfMonth, monthLayout, weeklySorted } from 'src/data/calendar';
import {
  MONTHS_ES, capitalize, dayOf, ministryEs, placeEs, weekdayLong, weekdayShort, weekdayShortByIndex,
} from './printFormat';

const weekly = weeklySorted();
const weeklyLine = weekly.map((a) => `${capitalize(weekdayShortByIndex(a.day))} ${a.time} ${a.title}`).join(' · ');
const WD = ['LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB', 'DOM'];
---

<!-- Cover -->
<section class="cp-sheet cp-a4 cp-a4--dark">
  <span class="cp-a4__mark" aria-hidden="true"><AnchorMark id="cp-a4-cover" outline={false} color="#ff2e34" /></span>
  <span class="cp-eyebrow cp-eyebrow--live">Iglesia Bautista El Ancla · Montevideo</span>
  <b class="cp-serif cp-a4__cover">Calendario<br />{CALENDAR_YEAR}</b>
  <span class="cp-a4__verse">Tenemos esta esperanza como firme y segura ancla del alma. <em>Heb. 6:19</em></span>
</section>

{MONTHS_ES.map((name, month) => {
  const { lead, days } = monthLayout(CALENDAR_YEAR, month);
  const list = eventsOfMonth(events, month);
  const byDay = new Map(list.map((e) => [dayOf(e), e]));
  return (
    <section class="cp-sheet cp-a4">
      <header class="cp-a4__head">
        <b class="cp-serif cp-a4__month">{name}</b>
        <span class="cp-a4__year">
          <span class="cp-eyebrow">{CALENDAR_YEAR}</span>
          <AnchorMark id={`cp-a4-${month}`} outline={false} color="#a8141b" class="cp-a4__logo" />
        </span>
      </header>
      <div class="cp-a4__cal">
        {WD.map((d) => <span class="cp-a4__wd">{d}</span>)}
        {Array.from({ length: lead }, () => <span class="cp-a4__cell"></span>)}
        {Array.from({ length: days }, (_, i) => {
          const day = i + 1;
          const ev = byDay.get(day);
          const sunday = (lead + i) % 7 === 6;
          return (
            <span class:list={['cp-a4__cell', ev && 'has-event', sunday && 'is-sun']}>
              <b class="cp-serif">{day}</b>
              {ev && <span class="cp-a4__cellev">{ev.title}</span>}
            </span>
          );
        })}
      </div>
      {list.length > 0 && (
        <div class="cp-a4__list">
          <span class="cp-eyebrow">Eventos del mes · ejemplo</span>
          {list.map((e) => (
            <div class="cp-a4__row">
              <b class="cp-serif">{dayOf(e)}</b>
              <b class="cp-a4__rowt">{e.title}</b>
              <span>{weekdayShort(e.date).toUpperCase()} · {e.time} h · {placeEs(e)} · {ministryEs[e.ministry]}</span>
            </div>
          ))}
        </div>
      )}
      <div class="cp-a4__foot"><b>Cada semana:</b> {weeklyLine}</div>
    </section>
  );
})}

<!-- Back cover -->
<section class="cp-sheet cp-a4 cp-a4--dark">
  <span class="cp-eyebrow cp-eyebrow--live">Todas las semanas</span>
  <b class="cp-serif cp-a4__bye">Te esperamos.</b>
  {weekly.map((a) => (
    <div class="cp-a4__wk"><b>{weekdayLong(a.day)}</b><span>{a.time} · {a.title}</span></div>
  ))}
  <div class="cp-a4__contact">
    <span>Av. Luis A. de Herrera 3101, esq. Juan Arrieta — Montevideo</span>
    <span>Instagram · @iglesiaelancla</span>
    <span>YouTube · @iglesiaelanclauy</span>
  </div>
</section>
