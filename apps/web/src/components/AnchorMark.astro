---
// Anchor logo with an outline (stroke) and a fill revealed bottom-up by a clip rect.
// GSAP drives `[data-anchor-outline]` (stroke-dashoffset) and `[data-anchor-clip]` (rect y).
import { ANCHOR_PATH as PATH } from 'src/data/anchorPath';
import cn from 'src/utils/cn';

interface Props {
  id: string;
  color?: string;
  strokeWidth?: number;
  outline?: boolean;
  fillFrom?: 'full' | 'empty';
  class?: string;
}

const {
  id,
  color = 'currentColor',
  strokeWidth = 40,
  outline = true,
  fillFrom = 'full',
  class: className,
} = Astro.props;

const anchorMark = {
  container: cn(className),
};
---

<!-- overflow visible: the outline stroke reaches past the viewBox and must not be cut flat at the top -->
<svg viewBox="0 0 200 254" class={anchorMark.container} aria-hidden="true" focusable="false" style="overflow: visible">
  <defs>
    <clipPath id={`${id}-clip`}>
      <rect data-anchor-clip x="0" y={fillFrom === 'full' ? 0 : 254} width="200" height="254" />
    </clipPath>
  </defs>
  {outline && (
    <g transform="translate(0,254) scale(0.10101,-0.10101)">
      <path
        data-anchor-outline
        pathLength="1"
        stroke-dasharray="1"
        stroke-dashoffset="0"
        d={PATH}
        fill="none"
        stroke={color}
        stroke-width={strokeWidth}
        stroke-linejoin="round"
      />
    </g>
  )}
  <g clip-path={`url(#${id}-clip)`}>
    <g transform="translate(0,254) scale(0.10101,-0.10101)">
      <path d={PATH} fill={color} />
    </g>
  </g>
</svg>
