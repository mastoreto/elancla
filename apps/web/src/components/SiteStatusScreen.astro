---
import type { Locale } from 'src/i18n/config';
import type { SiteStatus } from '@ancla/content';
import { getMessages } from 'src/i18n/messages';

interface Props {
  status: Exclude<SiteStatus, 'online'>;
  locale: Locale;
  contactEmail?: string;
}

const { status, locale, contactEmail } = Astro.props;
const copy = getMessages(locale).siteStatus[status];
---

<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden bg-paper px-6 pb-20 pt-32 text-ink"
>
  <div
    class="pointer-events-none absolute -right-24 -top-32 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 -left-24 h-72 w-72 rounded-full bg-ink/5 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-xl text-center">
    <span class="material-symbols-outlined mb-6 inline-block text-5xl text-primary" aria-hidden="true">
      {copy.icon}
    </span>
    <p class="font-ui text-[11px] font-semibold uppercase tracking-[0.35em] text-primary">
      {copy.kicker}
    </p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink md:text-5xl">
      {copy.title}
    </h1>
    <p class="mt-5 font-ui text-base leading-relaxed text-ink/60 md:text-lg">
      {copy.description}
    </p>
    {
      contactEmail && (
        <p class="mt-8 font-ui text-sm text-ink/50">
          {copy.note}{' '}
          <a
            href={`mailto:${contactEmail}`}
            class="font-medium text-primary underline-offset-4 hover:underline"
          >
            {contactEmail}
          </a>
        </p>
      )
    }
    <img src="/images/anclarojo.png" alt="" class="mx-auto mt-12 h-10 w-auto opacity-80" />
  </div>
</section>
