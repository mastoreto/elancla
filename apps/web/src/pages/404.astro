---
import Layout from '../layouts/Layout.astro';
import { ANCHOR_PATH } from 'src/data/anchorPath';
import { defaultLocale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import 'src/styles/NotFound.css';

const locale = defaultLocale;
const copy = getMessages(locale).notFound;
// "We could not find this page" with the last word (the emphasis) picked out in red.
const titleBefore = copy.title.slice(0, copy.title.lastIndexOf(copy.titleEmphasis));
---

<Layout title={copy.seo.title} description={copy.seo.description} noindex={true} locale={locale}>
  <section class="ln nf">
    <div class="nf-anchor" aria-hidden="true">
      <svg viewBox="0 0 200 254" class="nf-anchor__svg">
        <defs>
          <clipPath id="nf-forge"><rect class="nf-forge" x="0" y="0" width="200" height="254" /></clipPath>
        </defs>
        <g transform="translate(0,254) scale(0.10101,-0.10101)">
          <path class="nf-outline" pathLength="1" d={ANCHOR_PATH} fill="none" stroke="#a8141b" stroke-width="28" stroke-linejoin="round" />
        </g>
        <g clip-path="url(#nf-forge)">
          <path transform="translate(0,254) scale(0.10101,-0.10101)" d={ANCHOR_PATH} fill="#a8141b" />
        </g>
      </svg>
    </div>

    <div class="nf-text">
      <span class="ln-eyebrow nf-rise">{copy.kicker} · {copy.badge}</span>
      <h1 class="ln-h nf-title nf-rise" style="--d: 0.15s">
        {titleBefore}<span class="nf-accent">{copy.titleEmphasis}.</span>
      </h1>
      <p class="nf-lead nf-rise" style="--d: 0.3s">{copy.description}</p>
      <div class="nf-actions nf-rise" style="--d: 0.45s">
        <a href={localizePath('/', locale)} class="ln-btn">
          {copy.primary}<span class="ln-btn__dot" aria-hidden="true">→</span>
        </a>
        <a href={localizePath('/confesion-de-fe', locale)} class="ln-btn ln-btn--ghost">{copy.secondary}</a>
      </div>
      <span class="nf-tagline nf-rise" style="--d: 0.6s">{copy.tagline}</span>
      <span class="nf-helper">{copy.helper}</span>
    </div>
  </section>
</Layout>
