---
import { getPost, getSiteConfig } from '@ancla/content';
import { defaultLocale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout';
import BlogArticleTemplate from 'src/sections/blog/BlogArticleTemplate';
import { buildBlogArticleMeta } from 'src/sections/blog/utils/buildBlogArticleMeta';
import { toUrlDate } from 'src/sections/blog/utils/getBlogArticlePath';

const locale = defaultLocale;
const { year, month, day, slug } = Astro.params;
const article = slug ? await getPost(slug, locale) : null;
// The date of the URL is part of its identity: a known slug under another date is not this post.
if (!article || article.urlDate !== toUrlDate(year, month, day)) {
  return Astro.rewrite('/404');
}
const copy = getMessages(locale).blog;
const site = Astro.locals.site ?? (await getSiteConfig());
const { canonical, noindex, languageAlternates } = buildBlogArticleMeta({
  post: article,
  locale,
  siteUrl: site.url,
});
const breadcrumbs = [
  { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
  { name: copy.breadcrumbs.blog, url: localizePath('/blog', locale) },
  { name: article.title, url: canonical },
];
const image =
  article.cover?.kind === 'photo' ? article.cover.image.url : undefined;
---

<Layout
  title={article.seoTitle ?? article.title}
  description={article.seoDescription ?? article.excerpt}
  isBlog={true}
  pageType="article"
  noindex={noindex}
  breadcrumbs={breadcrumbs}
  keywords={article.tags}
  canonical={canonical}
  languageAlternates={languageAlternates}
  image={image}
  imageAlt={article.cover?.kind === 'photo' ? article.cover.alt : undefined}
  locale={locale}
  article={{
    publishedAt: article.publishedAt,
    modifiedAt: article.modifiedAt ?? undefined,
    authorName: article.author.name,
    section: article.category.name,
    tags: article.tags,
  }}
>
  <BlogArticleTemplate
    article={article}
    related={article.related}
    previous={article.previous}
    next={article.next}
    copy={copy}
    locale={locale}
  />
</Layout>

<script>
  import { initBlog } from 'src/sections/blog/scripts/blog';

  initBlog();
</script>
