---
import BlogArticleTemplate from 'src/components/Blog/BlogArticleTemplate.astro';
import type { BlogArticle } from 'src/data/blog';
import { defaultLocale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import { getBlogNeighbours } from 'src/data/blogNeighbours';
import Layout from 'src/layouts/Layout.astro';
import { getAllPostsFull } from '@ancla/content';

const locale = defaultLocale;
const { year, month, day, slug } = Astro.params;
const posts = await getAllPostsFull();
const article = posts.find(
  (a) => a.year === year && a.month === month && a.day === day && a.slug === slug
) as BlogArticle | undefined;
if (!article) {
  return Astro.rewrite('/404');
}
const copy = getMessages(locale).blog;
const { related, previous, next } = getBlogNeighbours(posts as BlogArticle[], article);

// Artículos relacionados y navegación derivados de todos los artículos en build time
// se resuelven en el template vía props; las funciones helper siguen disponibles
// desde src/data/blog si se usa con datos estáticos, o se pueden recalcular aquí.
const articleUrl = `/blog/${article.year}/${article.month}/${article.day}/${article.slug}`;
const breadcrumbs = [
  { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
  { name: copy.breadcrumbs.blog, url: localizePath('/blog', locale) },
  { name: article.title, url: localizePath(articleUrl, locale) },
];
---

<Layout
  title={article.seoTitle ?? article.title}
  description={article.description}
  isBlog={true}
  pageType="article"
  breadcrumbs={breadcrumbs}
  keywords={article.tags}
  canonical={new URL(localizePath(articleUrl, locale), Astro.site).toString()}
  locale={locale}
  article={{
    publishedAt: article.publishedAt,
    authorName: article.author.name,
    section: article.category,
    tags: article.tags,
  }}
>
  <BlogArticleTemplate
    article={article}
    related={related}
    previous={previous}
    next={next}
    copy={copy}
    locale={locale}
  />
</Layout>

<script>
  import { initBlog } from 'src/scripts/blog';

  initBlog();
</script>
