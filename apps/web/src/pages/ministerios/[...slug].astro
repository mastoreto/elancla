---
import { getSiteConfig } from '@ancla/content';
import { getContentPageBySlug } from 'src/data/contentPages';
import { defaultLocale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout';
import MinistryTemplate from 'src/sections/ministry/MinistryTemplate';
import { buildSiteTokens } from 'src/utils/siteTokens';

const locale = defaultLocale;
const { slug } = Astro.params;
const site = Astro.locals.site ?? (await getSiteConfig());
const tokens = buildSiteTokens(site, locale);
const result = slug
  ? getContentPageBySlug('ministerios', slug, { locale, tokens })
  : null;
if (!result) {
  return Astro.rewrite('/404');
}
const { page, isAlias } = result;

const canonicalPath = `/ministerios/${page.slug}`;
const canonical = new URL(
  localizePath(canonicalPath, locale),
  Astro.site
).toString();
const breadcrumbs = page.hero.breadcrumbs.map((item) => ({
  name: item.label,
  url: item.href ?? canonicalPath,
}));
---

<Layout
  title={page.seoTitle ?? page.title}
  description={page.description}
  breadcrumbs={breadcrumbs}
  image={page.featuredImage?.src}
  imageAlt={page.featuredImage?.alt}
  canonical={canonical}
  noindex={isAlias}
  locale={locale}
>
  <MinistryTemplate page={page} />
</Layout>
