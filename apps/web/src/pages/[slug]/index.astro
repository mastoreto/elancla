---
import { getPage, getPeople, getSiteConfig } from '@ancla/content';
import { getContentPageBySlug } from 'src/data/contentPages';
import { defaultLocale, isLocale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout';
import AboutPage from 'src/sections/about/AboutPage';
import ContentPageTemplate from 'src/sections/contentPage/ContentPageTemplate';
import LandingPage from 'src/sections/landing/LandingPage';
import SimplePage from 'src/sections/simplePage/SimplePage';
import { renderRichText } from 'src/utils/renderRichText';
import { buildSimplePageMeta } from 'src/utils/simplePageMeta';
import { buildSiteTokens } from 'src/utils/siteTokens';

// En SSR, `/pt` y `/en` (home localizada) comparten forma con `/nosotros`
// (página de contenido de raíz). Este único punto de entrada decide cuál es.
const { slug } = Astro.params;
const localeHome = isLocale(slug) && slug !== defaultLocale ? slug : null;

const locale = defaultLocale;
const site = Astro.locals.site ?? (await getSiteConfig());
const tokens = buildSiteTokens(site, locale);
const result =
  !localeHome && slug
    ? getContentPageBySlug('root', slug, { locale, tokens })
    : null;
// Third option, after the home and the content pages: a page written in the CRM.
const simplePage =
  !localeHome && !result && slug ? await getPage(slug, locale) : null;
if (!localeHome && !result && !simplePage) {
  return Astro.rewrite('/404');
}
const simplePageMeta = simplePage
  ? buildSimplePageMeta({ page: simplePage, locale, siteUrl: site.url })
  : null;

const page = result?.page;
const team = page?.slug === 'nosotros' ? await getPeople('team', locale) : [];
const canonicalPath = page ? `/${page.slug}` : '';
const canonical = page
  ? new URL(localizePath(canonicalPath, locale), Astro.site).toString()
  : '';
const breadcrumbs = page
  ? page.hero.breadcrumbs.map((item) => ({
      name: item.label,
      url: item.href ?? canonicalPath,
    }))
  : [];
---

{
  localeHome ? (
    <LandingPage locale={localeHome} />
  ) : simplePage && simplePageMeta ? (
    <SimplePage
      locale={locale}
      title={simplePage.title}
      html={renderRichText(simplePage.body)}
      seoTitle={simplePage.seoTitle ?? undefined}
      seoDescription={simplePage.seoDescription ?? undefined}
      {...simplePageMeta}
    />
  ) : (
    <Layout
      title={page!.seoTitle ?? page!.title}
      description={page!.description}
      breadcrumbs={breadcrumbs}
      image={page!.featuredImage?.src}
      imageAlt={page!.featuredImage?.alt}
      canonical={canonical}
      noindex={result!.isAlias}
      locale={locale}
    >
      {page!.slug === 'nosotros' ? <AboutPage page={page!} team={team} /> : <ContentPageTemplate page={page!} />}
    </Layout>
  )
}
