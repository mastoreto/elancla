---
import { getSiteConfig, getVisit } from '@ancla/content';
import { defaultLocale, isLocale } from 'src/i18n/config';
import VisitPage from 'src/sections/visit/VisitPage';

const { locale } = Astro.params;
if (!isLocale(locale) || locale === defaultLocale) {
  return Astro.rewrite('/404');
}
const site = Astro.locals.site ?? (await getSiteConfig());
const visit = await getVisit(locale);
---

<VisitPage locale={locale} {site} {visit} />
