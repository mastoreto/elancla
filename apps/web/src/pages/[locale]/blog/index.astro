---
import { getBlogIndex } from '@ancla/content';
import { defaultLocale, isLocale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout';
import BlogPageTemplate from 'src/sections/blog/BlogPageTemplate';

const { locale: localeParam } = Astro.params;
if (!isLocale(localeParam) || localeParam === defaultLocale) {
  return Astro.rewrite('/404');
}
const locale = localeParam;
const index = await getBlogIndex(locale);
const copy = getMessages(locale).blog;
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  isBlog={true}
  keywords={copy.seo.keywords}
  breadcrumbs={[
    { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
    { name: copy.breadcrumbs.blog, url: localizePath('/blog', locale) },
  ]}
  canonical={new URL(localizePath('/blog', locale), Astro.site).toString()}
  locale={locale}
>
  <BlogPageTemplate index={index} copy={copy} locale={locale} />
</Layout>

<script>
  import { initBlog } from 'src/sections/blog/scripts/blog';

  initBlog();
</script>
