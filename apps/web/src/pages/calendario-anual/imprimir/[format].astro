---
import { getCalendar, getSiteConfig } from '@ancla/content';
import PrintA3 from 'src/sections/calendar/CalendarPrint/components/PrintA3';
import PrintA4 from 'src/sections/calendar/CalendarPrint/components/PrintA4';
import PrintDigital from 'src/sections/calendar/CalendarPrint/components/PrintDigital';
import PrintLayout from 'src/sections/calendar/CalendarPrint/components/PrintLayout';
import { PRINT_LANG } from 'src/sections/calendar/CalendarPrint/utils/printFormat';
import { buildSiteTokens } from 'src/utils/siteTokens';

const formats = {
  a3: {
    title: 'A3 · una sola hoja',
    size: 'A3 landscape',
    hint: 'Elige «Guardar como PDF», papel A3, márgenes ninguno y escala 100%.',
  },
  a4: {
    title: 'A4 · una página por mes',
    size: 'A4 portrait',
    hint: 'Elige «Guardar como PDF», papel A4, márgenes ninguno y escala 100%.',
  },
  digital: {
    title: 'Digital 16:9',
    size: '1280px 720px',
    hint: 'Elige «Guardar como PDF», márgenes ninguno; cada lámina es una página.',
  },
} as const;

const format = formats[Astro.params.format as keyof typeof formats];
if (!format) return Astro.rewrite('/404');
const site = Astro.locals.site ?? (await getSiteConfig());
const calendar = await getCalendar(PRINT_LANG);
const tokens = buildSiteTokens(site, PRINT_LANG);
const contact = {
  address: [tokens.street, tokens.city].filter(Boolean).join(' — '),
  instagram: tokens.instagramHandle,
  youtube: tokens.youtubeHandle,
};
---

<PrintLayout title={`Calendario ${calendar.year} · ${format.title} | El Ancla`} hint={format.hint} pageSize={format.size}>
  {
    Astro.params.format === 'a4' ? (
      <PrintA4 calendar={calendar} contact={contact} />
    ) : Astro.params.format === 'a3' ? (
      <PrintA3 calendar={calendar} />
    ) : (
      <PrintDigital calendar={calendar} />
    )
  }
</PrintLayout>
