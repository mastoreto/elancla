---
import InlineText from 'src/components/InlineText';
import type { ContentHero } from 'src/data/contentPages';
import { ULINK } from 'src/styles/classes';
import cn from 'src/utils/cn';

interface Props {
  hero: ContentHero;
}

const { hero } = Astro.props;

// Paper grain over the hero and a faint 72px grid behind it.
const GRAIN =
  'before:pointer-events-none before:absolute before:inset-0 before:bg-(image:--texture-grain) before:opacity-35 before:mix-blend-multiply';
const GRID_LINES =
  '[background-image:linear-gradient(var(--grid)_1px,transparent_1px),linear-gradient(90deg,var(--grid)_1px,transparent_1px)] bg-size-[72px_72px]';
// Title lines rise one after another.
const LINE_DELAYS = [0.1, 0.22, 0.34];

const contentHero = {
  container: cn('relative overflow-hidden pt-32 pb-12', GRAIN),
  glow: cn('absolute inset-0 opacity-50', 'dark:opacity-[0.42]', GRID_LINES),
  watermark: cn(
    'absolute top-[15%] right-[-10%] w-[55vw] h-[55vw] opacity-[0.05] pointer-events-none'
  ),
  head: cn('relative mx-auto max-w-[1600px] px-6', 'md:px-10'),
  breadcrumbs: cn(
    'flex items-center gap-3 font-ui text-[11px] tracking-[0.2em] uppercase text-ink/60 mb-10'
  ),
  breadcrumbsDot: cn('w-8 h-px bg-ink/40'),
  crumbLink: cn(ULINK),
  crumbSeparator: cn('opacity-50'),
  meta: cn('flex flex-wrap items-center gap-3 mb-8'),
  chip: cn(
    'font-ui text-[10px] tracking-[0.18em] uppercase font-semibold text-primary'
  ),
  metaDot: cn('w-1 h-1 rounded-full bg-ink/30'),
  metaItem: cn('font-ui text-[11px] tracking-wider uppercase text-ink/60'),
  title: cn(
    'font-display text-[clamp(2.5rem,8vw,7.5rem)] leading-[0.92] tracking-[-0.035em]',
    'max-w-6xl font-light'
  ),
  titleLine: cn('mb-[-0.08em] block overflow-hidden pb-[0.08em]'),
  titleLineText: cn(
    'inline-block animate-hero-rise leading-none',
    '[transform:translate3d(0,110%,0)]',
    'max-[640px]:whitespace-normal'
  ),
  body: cn(
    'mt-12 grid grid-cols-1 gap-10 items-end pt-10 border-t border-ink/10',
    'lg:grid-cols-12'
  ),
  standfirstColumn: cn(hero.stats?.length ? 'lg:col-span-7' : 'lg:col-span-9'),
  standfirst: cn(
    'font-ui text-[18px] leading-relaxed text-ink/75 max-w-3xl',
    'md:text-[20px]'
  ),
  statsColumn: cn('border-ink/10', 'lg:col-span-5 lg:border-l lg:pl-10'),
  stats: cn('grid grid-cols-3 gap-4'),
  statValue: cn('font-display text-3xl tracking-tight', 'md:text-4xl'),
  statLabel: cn(
    'font-ui text-[10px] tracking-[0.2em] uppercase text-ink/50 mt-1'
  ),
};
---

<section class={contentHero.container}>
  <div class={contentHero.glow}></div>

  <svg
    aria-hidden="true"
    class={contentHero.watermark}
    viewBox="0 0 200 200"
  >
    <circle cx="100" cy="100" r="100" fill="none" stroke="#141414" stroke-width="0.4" />
    <circle cx="100" cy="100" r="70" fill="none" stroke="#141414" stroke-width="0.4" />
    <circle cx="100" cy="100" r="40" fill="none" stroke="#141414" stroke-width="0.4" />
  </svg>

  <div class={contentHero.head}>
    <div class={contentHero.breadcrumbs}>
      <span class={contentHero.breadcrumbsDot}></span>
      {
        hero.breadcrumbs.map((crumb, index) => (
          <>
            {crumb.href ? (
              <a href={crumb.href} class={contentHero.crumbLink}>
                {crumb.label}
              </a>
            ) : (
              <span>{crumb.label}</span>
            )}
            {index < hero.breadcrumbs.length - 1 && <span class={contentHero.crumbSeparator}>/</span>}
          </>
        ))
      }
    </div>

    <div class={contentHero.meta}>
      {hero.chip && <span class={contentHero.chip}>{hero.chip}</span>}
      {
        hero.meta.map((item) => (
          <>
            <span class={contentHero.metaDot}></span>
            <span class={contentHero.metaItem}>{item}</span>
          </>
        ))
      }
    </div>

    <h1 class={contentHero.title}>
      {
        hero.titleLines.map((line, i) => (
          <span class={contentHero.titleLine}>
            <span
              class={contentHero.titleLineText}
              style={`--d: ${LINE_DELAYS[i] ?? 0}s`}
            >
              <InlineText value={line} />
            </span>
          </span>
        ))
      }
    </h1>

    <div class={contentHero.body}>
      <div class={contentHero.standfirstColumn}>
        <p class={contentHero.standfirst}>
          {hero.standfirst}
        </p>
      </div>
      {
        hero.stats?.length && (
          <div class={contentHero.statsColumn}>
            <div class={contentHero.stats}>
              {hero.stats.map((stat) => (
                <div>
                  <div class={contentHero.statValue}>{stat.value}</div>
                  <div class={contentHero.statLabel}>
                    {stat.label}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
