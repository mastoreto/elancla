---
import type { ContentValuesBlock } from 'src/data/contentPages';
import cn from 'src/utils/cn';

interface Props {
  block: ContentValuesBlock;
}

const { block } = Astro.props;

const valuesBlock = {
  container: cn('mt-10'),
  grid: cn('grid grid-cols-1 gap-3', 'md:grid-cols-3'),
  value: cn(
    'relative border border-charcoal/10 bg-(--paper) px-7 py-9',
    '[transition:background_0.4s_ease,translate_0.4s_ease] hover:-translate-y-0.75',
    'hover:bg-obra-white',
  ),
  number: cn('mb-3 font-label-mono text-[10px] tracking-[0.22em] font-semibold text-(--primary)'),
  valueTitle: cn('font-display text-2xl mb-3 font-medium'),
  description: cn('font-ui text-[14px] leading-relaxed text-ink/70'),
  wrapper: cn('relative mt-10 border border-dashed border-charcoal/20 bg-sandstone px-6.5 py-5.5'),
  noteLabel: cn(
    'absolute -top-3 left-5.5 bg-(--paper) px-2.5 py-0.75 font-label-mono text-[10px]',
    'tracking-[0.22em] font-semibold text-(--primary) uppercase',
  ),
  text: cn(
    'font-ui text-[15px] leading-relaxed text-ink/80',
    '[&_a]:font-semibold [&_a]:text-(--ink) [&_a:hover]:text-(--primary) [&_a]:underline',
    '[&_a]:decoration-primary/60 [&_a]:underline-offset-2',
  ),
};
---

<div class={valuesBlock.container}>
  <div class={valuesBlock.grid}>
    {
      block.values.map((value) => (
        <div class={valuesBlock.value}>
          <div class={valuesBlock.number}>{value.number}</div>
          <h3 class={valuesBlock.valueTitle}>{value.title}</h3>
          <p class={valuesBlock.description}>{value.description}</p>
        </div>
      ))
    }
  </div>

  {
    block.note && (
      <div class={valuesBlock.wrapper}>
        <span class={valuesBlock.noteLabel}>{block.note.label}</span>
        <p class={valuesBlock.text}
          set:html={block.note.html} />
      </div>
    )
  }
</div>
