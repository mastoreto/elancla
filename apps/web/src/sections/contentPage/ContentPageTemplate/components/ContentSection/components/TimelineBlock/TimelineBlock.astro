---
import type { ContentTimelineBlock } from 'src/data/contentPages';
import cn from 'src/utils/cn';

interface Props {
  block: ContentTimelineBlock;
}

const { block } = Astro.props;

const timelineBlock = {
  container: cn(
    'relative mt-12 grid grid-cols-2 gap-x-4 gap-y-10',
    'md:before:absolute md:before:inset-x-0 md:before:top-9 md:before:h-px',
    "md:before:bg-charcoal/12 md:before:content-[''] md:grid-cols-5"
  ),
  dot: cn('relative z-1 size-3.25 rounded-full border-[1.5px]'),
  dotCurrent: cn(
    'border-(--primary) bg-(--primary) shadow-[0_0_0_5px_rgba(255,46,52,0.18)]'
  ),
  dotIdle: cn('border-(--ink) bg-(--paper)'),
  year: cn(
    'font-mono text-[11px] tracking-[0.18em] uppercase text-primary mt-5'
  ),
  title: cn('font-display text-lg leading-tight mt-2 font-medium'),
  description: cn('font-ui text-[12.5px] text-ink/60 mt-1'),
};
---

<div class={timelineBlock.container}>
  {
    block.items.map((item) => (
      <div>
        <div
          class={cn(timelineBlock.dot, item.isCurrent ? timelineBlock.dotCurrent : timelineBlock.dotIdle)}
        ></div>
        <div class={timelineBlock.year}>{item.year}</div>
        <div class={timelineBlock.title}>{item.title}</div>
        <div class={timelineBlock.description}>{item.description}</div>
      </div>
    ))
  }
</div>
