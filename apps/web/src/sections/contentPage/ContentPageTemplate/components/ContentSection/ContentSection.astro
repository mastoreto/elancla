---
import InlineText from 'src/components/InlineText';
import type { ContentSection as ContentSectionData } from 'src/data/contentPages';
import ContentCTA from 'src/sections/contentPage/ContentPageTemplate/components/ContentCTA';
import ContentFigure from 'src/sections/contentPage/ContentPageTemplate/components/ContentFigure';
import LinkGridBlock from 'src/sections/contentPage/ContentPageTemplate/components/ContentSection/components/LinkGridBlock';
import ProseBlock from 'src/sections/contentPage/ContentPageTemplate/components/ContentSection/components/ProseBlock';
import PullquoteBlock from 'src/sections/contentPage/ContentPageTemplate/components/ContentSection/components/PullquoteBlock';
import TimelineBlock from 'src/sections/contentPage/ContentPageTemplate/components/ContentSection/components/TimelineBlock';
import ValuesBlock from 'src/sections/contentPage/ContentPageTemplate/components/ContentSection/components/ValuesBlock';
import VerseBlock from 'src/sections/contentPage/ContentPageTemplate/components/ContentSection/components/VerseBlock';
import { REVEAL } from 'src/styles/classes';
import cn from 'src/utils/cn';

interface Props {
  section: ContentSectionData;
}

const { section } = Astro.props;

const contentSection = {
  container: cn(REVEAL, 'scroll-mt-32'),
  row: cn('flex items-baseline gap-4 mb-8'),
  eyebrow: cn(
    'font-label-mono text-[10px] tracking-[0.22em] font-semibold text-(--primary)'
  ),
  label: cn('flex-1 h-px bg-ink/15'),
  heading: cn(
    'font-display text-[clamp(2rem,5vw,3.6rem)] leading-[0.98] tracking-tight font-normal'
  ),
  description: cn(
    'mt-6 max-w-2xl font-ui text-[16px] leading-relaxed text-ink/70'
  ),
};
---

<section id={section.id} class={contentSection.container} data-reveal>
  <div class={contentSection.row}>
    <span class={contentSection.eyebrow}>{section.eyebrow}</span>
    <span class={contentSection.label}></span>
  </div>
  <h2 class={contentSection.heading}>
    <InlineText value={section.title} />
  </h2>
  {
    section.description && (
      <p class={contentSection.description}>
        {section.description}
      </p>
    )
  }

  {
    section.blocks.map((block) => (
      <>
        {block.type === 'prose' && <ProseBlock block={block} />}
        {block.type === 'verse' && <VerseBlock block={block} />}
        {block.type === 'values' && <ValuesBlock block={block} />}
        {block.type === 'timeline' && <TimelineBlock block={block} />}
        {block.type === 'pullquote' && <PullquoteBlock block={block} />}
        {block.type === 'figure' && <ContentFigure figure={block.figure} />}
        {block.type === 'linkGrid' && <LinkGridBlock block={block} />}
        {block.type === 'cta' && <ContentCTA cta={block.cta} />}
      </>
    ))
  }
</section>
