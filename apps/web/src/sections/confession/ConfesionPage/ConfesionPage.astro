---
import { getDoctrines, getSolas } from 'src/data/doctrines';
import type { Locale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout';
import ConfesionChristus from 'src/sections/confession/ConfesionPage/components/ConfesionChristus';
import ConfesionCTA from 'src/sections/confession/ConfesionPage/components/ConfesionCTA';
import ConfesionHero from 'src/sections/confession/ConfesionPage/components/ConfesionHero';
import ConfesionMarquee from 'src/sections/confession/ConfesionPage/components/ConfesionMarquee';
import ConfesionQuote from 'src/sections/confession/ConfesionPage/components/ConfesionQuote';
import DoctrineList from 'src/sections/confession/ConfesionPage/components/DoctrineList';
import cn from 'src/utils/cn';

interface Props {
  locale: Locale;
  canonical?: string;
}

const { locale, canonical } = Astro.props;
const copy = getMessages(locale).confession;
const doctrines = getDoctrines(locale);

const confesionPage = {
  container: cn('ln bg-obra-paper pb-24', 'max-sm:pb-14'),
};
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  keywords={copy.seo.keywords}
  breadcrumbs={copy.breadcrumbs.map((item) => ({ ...item, url: localizePath(item.url, locale) }))}
  canonical={canonical}
  locale={locale}
>
  <div class={confesionPage.container} data-confession>
    <ConfesionHero copy={copy.hero} locale={locale} />
    <ConfesionMarquee solas={getSolas(locale)} />
    <ConfesionQuote copy={copy.quote} />
    <DoctrineList doctrines={doctrines} copy={copy.doctrineList} />
    <ConfesionChristus copy={copy.christus} />
    <ConfesionCTA copy={copy.cta} locale={locale} />
  </div>
</Layout>

<script>
  import 'src/sections/confession/ConfesionPage/scripts/confesion';
</script>
