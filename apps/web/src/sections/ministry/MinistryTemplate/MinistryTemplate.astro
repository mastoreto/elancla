---
import AnchorMark from 'src/components/AnchorMark';
import InlineText from 'src/components/InlineText';
import Button from 'src/components/ui/Button';
import Pill from 'src/components/ui/Pill';
import type { ContentPage } from 'src/data/contentPages';
import { ULINK } from 'src/styles/classes';
import cn from 'src/utils/cn';
import { RISE_IN } from 'src/utils/riseIn';

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
const { hero, featuredImage, sections, cta } = page;
const sectionsWithBlocks = sections.map((section) => ({
  ...section,
  prose: section.blocks.find((b) => b.type === 'prose'),
  values: section.blocks.find((b) => b.type === 'values'),
  facts: section.blocks.find((b) => b.type === 'facts'),
  links: section.blocks.find((b) => b.type === 'linkGrid'),
}));
// Stat cards alternate white / red / mist, as in the design.
const statTone = ['bg-obra-white', 'bg-obra-red text-white', 'bg-obra-mist'];
const EMPHASIS = 'text-obra-red not-italic';
const CARD =
  'flex flex-col gap-3 rounded-[28px] bg-(--tint,var(--color-obra-mist)) text-inherit no-underline [transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s,background-color_0.4s] hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift';
const CARD_TITLE = 'font-obra-serif text-[1.625rem] leading-[1.1] font-bold';
const BOX = 'flex flex-col rounded-[28px] p-6';
const BOX_LABEL =
  'font-obra-sans-bold text-[0.75rem] tracking-[0.16em] text-obra-muted uppercase';

const ministryTemplate = {
  container: cn('ln bg-obra-paper pb-24'),
  header: cn('flex flex-col gap-9 px-gutter-sm pt-[clamp(7.5rem,11vw,9.5rem)]'),
  breadcrumbs: cn(
    'flex flex-wrap items-center gap-2 font-obra-sans-bold text-[0.875rem] text-obra-muted'
  ),
  crumbLink: cn(ULINK),
  current: cn('text-obra-red'),
  heroBody: cn(
    'flex items-end gap-16',
    'max-lg:flex-col max-lg:items-start max-lg:gap-6'
  ),
  heroCopy: cn('flex min-w-0 flex-1 flex-col gap-[1.4rem]'),
  heroMeta: cn(
    'ln-eyebrow inline-flex flex-wrap items-center gap-2.5 tracking-[0.16em]',
    RISE_IN
  ),
  heroChip: cn(
    'rounded-full bg-obra-red px-3 py-1.5 tracking-[0.08em] text-white'
  ),
  heroTitle: cn(
    'ln-h text-[clamp(3.25rem,7.2vw,6.5rem)] wrap-anywhere',
    RISE_IN
  ),
  standfirst: cn(
    'm-0 flex-[0_0_min(26.25rem,100%)] text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55]',
    'text-obra-ink-soft',
    'max-lg:w-full max-lg:basis-auto',
    RISE_IN
  ),
  stats: cn(
    'grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-2.5',
    RISE_IN
  ),
  stat: cn('flex flex-col gap-1 rounded-[32px] p-6'),
  statStrong: cn(
    'font-obra-serif text-[clamp(2rem,3.6vw,3.25rem)] leading-none font-bold'
  ),
  statLabel: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.12em] uppercase opacity-80'
  ),
  featured: cn('px-gutter-sm pt-11'),
  featuredFrame: cn(
    'relative h-[clamp(15rem,36vw,32.5rem)] overflow-hidden rounded-[clamp(28px,3.3vw,48px)]',
    'bg-obra-warm'
  ),
  featuredImage: cn(
    'size-full object-cover object-[50%_60%]',
    '[filter:grayscale(1)_sepia(0.14)_contrast(1.06)]'
  ),
  featuredLabel: cn('absolute top-4.5 left-4.5'),
  featuredBadge: cn('absolute bottom-4.5 left-4.5'),
  body: cn(
    'flex gap-14 px-gutter-sm pt-[clamp(3.5rem,6vw,5.5rem)]',
    'max-lg:flex-col'
  ),
  sections: cn('flex min-w-0 flex-1 flex-col gap-[clamp(4rem,7vw,6.875rem)]'),
  section: cn('flex scroll-mt-28 flex-col gap-7'),
  sectionHead: cn('flex flex-col gap-3.5'),
  sectionEyebrow: cn('ln-eyebrow'),
  sectionHeading: cn('ln-h text-[clamp(2rem,3.6vw,3.25rem)]'),
  paragraph: cn('m-0 text-[clamp(1.0625rem,1.4vw,1.25rem)] leading-[1.7]'),
  values: cn('grid grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] gap-3.5'),
  value: cn(CARD, 'p-6.5'),
  valueNumber: cn(
    'font-obra-serif text-[2.75rem] leading-none font-bold text-obra-red'
  ),
  valueTitle: cn(CARD_TITLE),
  valueDescription: cn('text-[1rem] leading-[1.55] text-obra-ink-soft'),
  facts: cn(
    'm-0 grid grid-cols-[1fr_1fr] gap-x-10',
    'max-[640px]:grid-cols-[1fr]'
  ),
  fact: cn('flex flex-col gap-1 border-t border-obra-ink/14 py-4'),
  factLabel: cn(
    'font-obra-sans-bold text-[0.75rem] tracking-[0.14em] text-obra-muted uppercase'
  ),
  factValue: cn('m-0 font-obra-sans-bold text-[1.125rem] leading-[1.35]'),
  links: cn('grid grid-cols-[repeat(auto-fit,minmax(19rem,1fr))] gap-3.5'),
  linkCard: cn(CARD, 'flex-row items-start gap-4.5 p-6'),
  linkGlyph: cn(
    'inline-flex size-14 flex-none items-center justify-center rounded-[18px] bg-obra-red',
    'font-obra-serif text-[1.625rem] font-bold text-white'
  ),
  linkCopy: cn(
    'flex flex-col gap-2 text-[1rem] leading-[1.55] text-obra-ink-soft'
  ),
  linkSource: cn(
    'font-obra-sans-bold text-[0.6875rem] tracking-[0.14em] text-obra-muted uppercase'
  ),
  linkTitle: cn(CARD_TITLE),
  linkDescription: cn('text-[0.9375rem] leading-normal text-obra-ink-soft'),
  linkMeta: cn('font-obra-sans-bold text-[0.8125rem] text-obra-red not-italic'),
  toc: cn(
    'sticky top-28 flex flex-[0_0_17.5rem] flex-col gap-5 self-start',
    'max-lg:hidden'
  ),
  tocPanel: cn(BOX, 'gap-3.5 bg-obra-white'),
  tocTitle: cn(BOX_LABEL),
  tocNav: cn('flex flex-col gap-3.5'),
  tocLink: cn(
    'relative m-0 flex gap-3 border-0 p-0 font-obra-sans-bold text-[0.9375rem] leading-[1.4]',
    'font-normal text-obra-ink',
    '[transition:color_0.3s] hover:text-obra-red [&.active]:text-obra-red'
  ),
  tocNumber: cn('text-obra-red'),
  shortcuts: cn(BOX, 'gap-3 bg-obra-mist'),
  shortcutsTitle: cn(BOX_LABEL),
  shortcutLink: cn(ULINK, 'w-fit font-obra-sans-bold text-[0.9375rem]'),
  cta: cn('px-gutter-sm pt-[clamp(3.5rem,6vw,5rem)]'),
  ctaPanel: cn(
    'relative flex items-center gap-14 overflow-hidden rounded-[clamp(28px,3.3vw,48px)]',
    'bg-obra-red p-[clamp(2rem,4.4vw,4rem)] text-white',
    'max-lg:flex-col max-lg:items-start max-lg:gap-6'
  ),
  ctaMark: cn(
    'pointer-events-none absolute right-8 -bottom-8 h-auto w-64 opacity-10'
  ),
  ctaCopy: cn('relative flex flex-1 flex-col gap-3.5'),
  ctaEyebrow: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-blush uppercase'
  ),
  ctaTitle: cn('ln-h text-[clamp(2.25rem,3.9vw,3.5rem)] leading-none'),
  ctaBody: cn('m-0 max-w-120 text-[1.125rem] leading-normal'),
  ctaActions: cn(
    'relative flex flex-[0_0_min(22.5rem,100%)] flex-col gap-3',
    'max-lg:w-full max-lg:basis-auto'
  ),
  ctaPrimary: cn('justify-center px-6.5'),
  ctaSecondary: cn(
    'justify-center border-[1.5px] border-white px-6.5 text-white'
  ),
};
---

<article class={ministryTemplate.container}>
  <header class={ministryTemplate.header}>
    <nav
      class={ministryTemplate.breadcrumbs}
      aria-label="breadcrumb"
    >
      {
        hero.breadcrumbs.map((crumb, i) => (
          <>
            {crumb.href ? <a href={crumb.href} class={ministryTemplate.crumbLink}>{crumb.label}</a> : <span class={ministryTemplate.current} aria-current="page">{crumb.label}</span>}
            {i < hero.breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
          </>
        ))
      }
    </nav>

    <div class={ministryTemplate.heroBody}>
      <div class={ministryTemplate.heroCopy}>
        <span class={ministryTemplate.heroMeta}>
          <span class={ministryTemplate.heroChip}>{hero.chip}</span>{hero.meta.join(' · ')}
        </span>
        <h1
          class={ministryTemplate.heroTitle}
          style="--d: 0.15s"
        >
          {hero.titleLines.map((line, i) => <>{i > 0 && ' '}<InlineText value={line} emphasisClass={EMPHASIS} /></>)}
        </h1>
      </div>
      <p
        class={ministryTemplate.standfirst}
        style="--d: 0.3s"
      >{hero.standfirst}</p>
    </div>

    {
      hero.stats?.length && (
        <div
          class={ministryTemplate.stats}
          style="--d: 0.45s"
        >
          {hero.stats.map((stat, i) => (
            <div class={cn(ministryTemplate.stat, statTone[i % statTone.length])}>
              <b class={ministryTemplate.statStrong}>{stat.value}</b>
              <span class={ministryTemplate.statLabel}>{stat.label}</span>
            </div>
          ))}
        </div>
      )
    }
  </header>

  {
    featuredImage && (
      <section class={ministryTemplate.featured}>
        <div class={ministryTemplate.featuredFrame}>
          <img
            src={featuredImage.src}
            alt={featuredImage.alt}
            class={ministryTemplate.featuredImage}
            loading="eager"
          />
          {featuredImage.label && <Pill class={ministryTemplate.featuredLabel}>{featuredImage.label}</Pill>}
          {featuredImage.badge && <Pill class={ministryTemplate.featuredBadge}>{featuredImage.badge}</Pill>}
        </div>
      </section>
    )
  }

  <section class={ministryTemplate.body}>
    <div class={ministryTemplate.sections}>
      {
        sectionsWithBlocks.map((section) => (
          <section id={section.id} class={ministryTemplate.section}>
            <div class={ministryTemplate.sectionHead}>
              <span class={ministryTemplate.sectionEyebrow}>{section.eyebrow}</span>
              <h2 class={ministryTemplate.sectionHeading}><InlineText value={section.title} emphasisClass={EMPHASIS} /></h2>
            </div>

            {section.prose?.type === 'prose' && section.prose.paragraphs.map((p) => <p class={ministryTemplate.paragraph} set:html={p} />)}

            {
              section.values?.type === 'values' && (
                <div class={ministryTemplate.values}>
                  {section.values.values.map((v) => (
                    <div class={ministryTemplate.value}>
                      <span class={ministryTemplate.valueNumber}>{v.number}</span>
                      <b class={ministryTemplate.valueTitle}>{v.title}</b>
                      <span class={ministryTemplate.valueDescription}>{v.description}</span>
                    </div>
                  ))}
                </div>
              )
            }

            {
              section.facts?.type === 'facts' && (
                <dl class={ministryTemplate.facts}>
                  {section.facts.facts.map((f) => (
                    <div class={ministryTemplate.fact}>
                      <dt class={ministryTemplate.factLabel}>{f.label}</dt>
                      <dd class={ministryTemplate.factValue}>{f.value}</dd>
                    </div>
                  ))}
                </dl>
              )
            }

            {
              section.links?.type === 'linkGrid' && (
                <div class={ministryTemplate.links}>
                  {section.links.links.map((link) => (
                    <a
                      href={link.href}
                      class={ministryTemplate.linkCard}
                      style={link.tint ? `--tint: ${link.tint}` : undefined}
                    >
                      <span
                        class={ministryTemplate.linkGlyph}
                        aria-hidden="true"
                      >
                        {link.glyph}
                      </span>
                      <span class={ministryTemplate.linkCopy}>
                        <small class={ministryTemplate.linkSource}>{link.sourceLabel}</small>
                        <b class={ministryTemplate.linkTitle}>{link.title}</b>
                        <span class={ministryTemplate.linkDescription}>{link.description}</span>
                        <em class={ministryTemplate.linkMeta}>{link.meta} →</em>
                      </span>
                    </a>
                  ))}
                </div>
              )
            }
          </section>
        ))
      }
    </div>

    <aside class={ministryTemplate.toc}>
      <div class={ministryTemplate.tocPanel}>
        <span class={ministryTemplate.tocTitle}>{page.tocTitle}</span>
        <nav class={ministryTemplate.tocNav}>
          {
            sections.map((section, i) => (
              <a
                href={`#${section.id}`}
                class={ministryTemplate.tocLink}
                data-content-toc
                data-target={section.id}
              >
                <span class={ministryTemplate.tocNumber}>{String(i + 1).padStart(2, '0')}</span>{section.tocLabel}
              </a>
            ))
          }
        </nav>
      </div>
      {
        page.shortcuts?.length && (
          <div class={ministryTemplate.shortcuts}>
            <span class={ministryTemplate.shortcutsTitle}>{page.shortcutsTitle}</span>
            {page.shortcuts.map((s) => (
              <a href={s.href} class={ministryTemplate.shortcutLink}>{s.label}</a>
            ))}
          </div>
        )
      }
    </aside>
  </section>

  {
    cta && (
      <section class={ministryTemplate.cta}>
        <div class={ministryTemplate.ctaPanel}>
          <AnchorMark
            id="mn-cta"
            color="#fff"
            outline={false}
            class={ministryTemplate.ctaMark}
          />
          <div class={ministryTemplate.ctaCopy}>
            <span class={ministryTemplate.ctaEyebrow}>{cta.eyebrow}</span>
            <h2 class={ministryTemplate.ctaTitle}>
              <InlineText value={cta.title} emphasisClass="not-italic" />
            </h2>
            <p class={ministryTemplate.ctaBody}>{cta.body}</p>
          </div>
          <div class={ministryTemplate.ctaActions}>
            <Button href={cta.primary.href} variant="dark" class={ministryTemplate.ctaPrimary}>{cta.primary.label}</Button>
            {cta.secondary && (
              <Button href={cta.secondary.href} class={ministryTemplate.ctaSecondary}>{cta.secondary.label}</Button>
            )}
          </div>
        </div>
      </section>
    )
  }
</article>

<script>
  import { initContentPage } from 'src/scripts/contentPage';
  initContentPage();
</script>
