---
import type { PublicMinistry } from '@ancla/content';
import { renderRichText } from '@ancla/content';
import AnchorMark from 'src/components/AnchorMark';
import InlineText from 'src/components/InlineText';
import Button from 'src/components/ui/Button';
import Pill from 'src/components/ui/Pill';
import type { Locale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import { simplePageStyles } from 'src/sections/simplePage/SimplePage';
import { ULINK } from 'src/styles/classes';
import { buildPhotoSrcSet } from 'src/utils/buildPhotoSrcSet';
import cn from 'src/utils/cn';
import { formatWeeklySlots } from 'src/utils/formatWeeklySlots';
import { RISE_IN } from 'src/utils/riseIn';
import { buildMinistrySections } from './utils/buildMinistrySections';

interface Props {
  ministry: PublicMinistry;
  locale: Locale;
}

const { ministry, locale } = Astro.props;
const copy = getMessages(locale).contentPages.ministryTemplate;
const sections = buildMinistrySections(ministry);
const has = (key: string) => sections.find((section) => section.key === key);
const about = has('about');
const facts = has('facts');
const next = has('next');
const aboutHtml = renderRichText(ministry.about);
const sectionLabel = {
  about: copy.about,
  facts: copy.facts,
  next: copy.next,
};
const juntosPath = localizePath('/#juntos', locale);
const shortcuts = [
  { label: copy.shortcuts.all, href: juntosPath },
  { label: copy.shortcuts.visit, href: localizePath('/#visitanos', locale) },
  {
    label: copy.shortcuts.confession,
    href: localizePath('/confesion-de-fe', locale),
  },
];
const { cover, icon, values, leaders } = ministry;
const scheduleRows = formatWeeklySlots(ministry.schedule, locale);
const EMPHASIS = 'text-obra-red not-italic';
const CARD = 'flex flex-col gap-3 rounded-[28px] bg-obra-mist text-inherit';
const CARD_TITLE = 'font-obra-serif text-[1.625rem] leading-[1.1] font-bold';
const BOX = 'flex flex-col rounded-[28px] p-6';
const BOX_LABEL =
  'font-obra-sans-bold text-[0.75rem] tracking-[0.16em] text-obra-muted uppercase';

const ministryTemplate = {
  container: cn('ln bg-obra-paper pb-24'),
  header: cn('flex flex-col gap-9 px-gutter-sm pt-[clamp(7.5rem,11vw,9.5rem)]'),
  breadcrumbs: cn(
    'flex flex-wrap items-center gap-2 font-obra-sans-bold text-[0.875rem] text-obra-muted'
  ),
  crumbLink: cn(ULINK),
  current: cn('text-obra-red'),
  heroBody: cn(
    'flex items-end gap-16',
    'max-lg:flex-col max-lg:items-start max-lg:gap-6'
  ),
  heroCopy: cn('flex min-w-0 flex-1 flex-col gap-[1.4rem]'),
  heroMeta: cn(
    'ln-eyebrow inline-flex flex-wrap items-center gap-2.5 tracking-[0.16em]',
    RISE_IN
  ),
  heroChip: cn(
    'rounded-full bg-obra-red px-3 py-1.5 tracking-[0.08em] text-white'
  ),
  heroIcon: cn('size-14 rounded-2xl bg-obra-mist p-3'),
  heroTitle: cn(
    'ln-h text-[clamp(3.25rem,7.2vw,6.5rem)] wrap-anywhere',
    RISE_IN
  ),
  standfirst: cn(
    'm-0 flex-[0_0_min(26.25rem,100%)] text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55]',
    'text-obra-ink-soft',
    'max-lg:w-full max-lg:basis-auto',
    RISE_IN
  ),
  featured: cn('px-gutter-sm pt-11'),
  featuredFrame: cn(
    'relative h-[clamp(15rem,36vw,32.5rem)] overflow-hidden rounded-[clamp(28px,3.3vw,48px)]',
    'bg-obra-warm'
  ),
  featuredImage: cn(
    'size-full object-cover object-[50%_60%]',
    '[filter:grayscale(1)_sepia(0.14)_contrast(1.06)]'
  ),
  featuredLabel: cn('absolute top-4.5 left-4.5'),
  body: cn(
    'flex gap-14 px-gutter-sm pt-[clamp(3.5rem,6vw,5.5rem)]',
    'max-lg:flex-col'
  ),
  sections: cn('flex min-w-0 flex-1 flex-col gap-[clamp(4rem,7vw,6.875rem)]'),
  section: cn('flex scroll-mt-28 flex-col gap-7'),
  sectionHead: cn('flex flex-col gap-3.5'),
  sectionEyebrow: cn('ln-eyebrow'),
  sectionHeading: cn('ln-h text-[clamp(2rem,3.6vw,3.25rem)]'),
  prose: cn(
    simplePageStyles.body,
    'max-w-none text-[clamp(1.0625rem,1.4vw,1.25rem)]'
  ),
  paragraph: cn('m-0 text-[clamp(1.0625rem,1.4vw,1.25rem)] leading-[1.7]'),
  values: cn('grid grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] gap-3.5'),
  value: cn(CARD, 'p-6.5'),
  valueNumber: cn(
    'font-obra-serif text-[2.75rem] leading-none font-bold text-obra-red'
  ),
  valueTitle: cn(CARD_TITLE),
  valueDescription: cn('text-[1rem] leading-[1.55] text-obra-ink-soft'),
  facts: cn(
    'm-0 grid grid-cols-[1fr_1fr] gap-x-10',
    'max-[640px]:grid-cols-[1fr]'
  ),
  fact: cn('flex flex-col gap-1 border-t border-obra-ink/14 py-4'),
  factLabel: cn(
    'font-obra-sans-bold text-[0.75rem] tracking-[0.14em] text-obra-muted uppercase'
  ),
  factValue: cn('m-0 font-obra-sans-bold text-[1.125rem] leading-[1.35]'),
  schedule: cn('m-0 flex list-none flex-col gap-1 p-0'),
  leaders: cn('m-0 flex list-none flex-col gap-4 p-0'),
  leader: cn('flex items-center gap-4'),
  leaderPhoto: cn('size-15 flex-none rounded-full object-cover'),
  leaderName: cn('font-obra-sans-bold text-[1.125rem] leading-[1.3]'),
  leaderTitle: cn('block text-[0.9375rem] font-normal text-obra-ink-soft'),
  toc: cn(
    'sticky top-28 flex flex-[0_0_17.5rem] flex-col gap-5 self-start',
    'max-lg:hidden'
  ),
  tocPanel: cn(BOX, 'gap-3.5 bg-obra-white'),
  tocTitle: cn(BOX_LABEL),
  tocNav: cn('flex flex-col gap-3.5'),
  tocLink: cn(
    'relative m-0 flex gap-3 border-0 p-0 font-obra-sans-bold text-[0.9375rem] leading-[1.4]',
    'font-normal text-obra-ink',
    '[transition:color_0.3s] hover:text-obra-red [&.active]:text-obra-red'
  ),
  tocNumber: cn('text-obra-red'),
  shortcuts: cn(BOX, 'gap-3 bg-obra-mist'),
  shortcutsTitle: cn(BOX_LABEL),
  shortcutLink: cn(ULINK, 'w-fit font-obra-sans-bold text-[0.9375rem]'),
  cta: cn('px-gutter-sm pt-[clamp(3.5rem,6vw,5rem)]'),
  ctaPanel: cn(
    'relative flex items-center gap-14 overflow-hidden rounded-[clamp(28px,3.3vw,48px)]',
    'bg-obra-red p-[clamp(2rem,4.4vw,4rem)] text-white',
    'max-lg:flex-col max-lg:items-start max-lg:gap-6'
  ),
  ctaMark: cn(
    'pointer-events-none absolute right-8 -bottom-8 h-auto w-64 opacity-10'
  ),
  ctaCopy: cn('relative flex flex-1 flex-col gap-3.5'),
  ctaEyebrow: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-blush uppercase'
  ),
  ctaTitle: cn('ln-h text-[clamp(2.25rem,3.9vw,3.5rem)] leading-none'),
  ctaActions: cn(
    'relative flex flex-[0_0_min(22.5rem,100%)] flex-col gap-3',
    'max-lg:w-full max-lg:basis-auto'
  ),
  ctaPrimary: cn('justify-center px-6.5'),
  ctaSecondary: cn(
    'justify-center border-[1.5px] border-white px-6.5 text-white'
  ),
};
---

<article class={ministryTemplate.container}>
  <header class={ministryTemplate.header}>
    <nav class={ministryTemplate.breadcrumbs} aria-label="breadcrumb">
      <a href={localizePath('/', locale)} class={ministryTemplate.crumbLink}>{copy.breadcrumbs.home}</a>
      <span aria-hidden="true">/</span>
      <a href={juntosPath} class={ministryTemplate.crumbLink}>{copy.breadcrumbs.ministries}</a>
      <span aria-hidden="true">/</span>
      <span class={ministryTemplate.current} aria-current="page">{ministry.name}</span>
    </nav>

    <div class={ministryTemplate.heroBody}>
      <div class={ministryTemplate.heroCopy}>
        <span class={ministryTemplate.heroMeta}>
          <span class={ministryTemplate.heroChip}>{copy.chip}</span>
          {icon && <img src={`/images/ministries/${icon}.svg`} alt="" width="56" height="56" class={ministryTemplate.heroIcon} />}
        </span>
        <h1 class={ministryTemplate.heroTitle} style="--d: 0.15s">
          {ministry.name}{' '}<InlineText value={{ before: copy.titleSuffixBefore, emphasis: copy.titleSuffixEmphasis }} emphasisClass={EMPHASIS} />
        </h1>
      </div>
      <p class={ministryTemplate.standfirst} style="--d: 0.3s">{ministry.tagline}</p>
    </div>
  </header>

  {
    cover && (
      <section class={ministryTemplate.featured}>
        <div class={ministryTemplate.featuredFrame}>
          <img
            src={cover.image.url}
            width={cover.image.width}
            height={cover.image.height}
            alt={cover.alt ?? ministry.name}
            class={ministryTemplate.featuredImage}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <Pill class={ministryTemplate.featuredLabel}>{copy.coverLabel}</Pill>
        </div>
      </section>
    )
  }

  <section class={ministryTemplate.body}>
    <div class={ministryTemplate.sections}>
      {
        about && (
          <section id={about.id} class={ministryTemplate.section}>
            <div class={ministryTemplate.sectionHead}>
              <span class={ministryTemplate.sectionEyebrow}>{about.number} — {sectionLabel.about.eyebrow}</span>
              <h2 class={ministryTemplate.sectionHeading}><InlineText value={{ before: `${ministry.name}: `, emphasis: ministry.tagline }} emphasisClass={EMPHASIS} /></h2>
            </div>
            <div class={ministryTemplate.prose} set:html={aboutHtml} />
            {
              values.length > 0 && (
                <div class={ministryTemplate.values}>
                  {values.map((value, index) => (
                    <div class={ministryTemplate.value}>
                      <span class={ministryTemplate.valueNumber}>{String(index + 1).padStart(2, '0')}</span>
                      <b class={ministryTemplate.valueTitle}>{value.title}</b>
                      {value.description && <span class={ministryTemplate.valueDescription}>{value.description}</span>}
                    </div>
                  ))}
                </div>
              )
            }
          </section>
        )
      }

      {
        facts && (
          <section id={facts.id} class={ministryTemplate.section}>
            <div class={ministryTemplate.sectionHead}>
              <span class={ministryTemplate.sectionEyebrow}>{facts.number} — {sectionLabel.facts.eyebrow}</span>
              <h2 class={ministryTemplate.sectionHeading}><InlineText value={{ before: copy.facts.titleBefore, emphasis: copy.facts.titleEmphasis }} emphasisClass={EMPHASIS} /></h2>
            </div>
            <dl class={ministryTemplate.facts}>
              {scheduleRows.length > 0 && (
                <div class={ministryTemplate.fact}>
                  <dt class={ministryTemplate.factLabel}>{copy.facts.when}</dt>
                  <dd class={ministryTemplate.factValue}>
                    <ul class={ministryTemplate.schedule}>
                      {scheduleRows.map((row) => (
                        <li>{row.dayLabel} · {row.timeLabel}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
              {ministry.place && (
                <div class={ministryTemplate.fact}>
                  <dt class={ministryTemplate.factLabel}>{copy.facts.place}</dt>
                  <dd class={ministryTemplate.factValue}>{ministry.place}</dd>
                </div>
              )}
              {ministry.audience && (
                <div class={ministryTemplate.fact}>
                  <dt class={ministryTemplate.factLabel}>{copy.facts.audience}</dt>
                  <dd class={ministryTemplate.factValue}>{ministry.audience}</dd>
                </div>
              )}
              {ministry.howToJoin && (
                <div class={ministryTemplate.fact}>
                  <dt class={ministryTemplate.factLabel}>{copy.facts.howToJoin}</dt>
                  <dd class={ministryTemplate.factValue}>{ministry.howToJoin}</dd>
                </div>
              )}
              {leaders.length > 0 && (
                <div class={ministryTemplate.fact}>
                  <dt class={ministryTemplate.factLabel}>{copy.facts.leaders}</dt>
                  <dd class={ministryTemplate.factValue}>
                    <ul class={ministryTemplate.leaders}>
                      {leaders.map((leader) => {
                        const photo = buildPhotoSrcSet(leader.photo ?? null);
                        return (
                          <li class={ministryTemplate.leader}>
                            {photo && (
                              <img
                                src={photo.src}
                                srcset={photo.srcset}
                                sizes="60px"
                                width="60"
                                height="60"
                                alt=""
                                class={ministryTemplate.leaderPhoto}
                                loading="lazy"
                                decoding="async"
                              />
                            )}
                            <span class={ministryTemplate.leaderName}>
                              {leader.name}
                              <span class={ministryTemplate.leaderTitle}>{leader.title}</span>
                            </span>
                          </li>
                        );
                      })}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
          </section>
        )
      }

      {
        next && ministry.nextStep && (
          <section id={next.id} class={ministryTemplate.section}>
            <div class={ministryTemplate.sectionHead}>
              <span class={ministryTemplate.sectionEyebrow}>{next.number} — {sectionLabel.next.eyebrow}</span>
              <h2 class={ministryTemplate.sectionHeading}><InlineText value={{ before: copy.next.titleBefore, emphasis: copy.next.titleEmphasis }} emphasisClass={EMPHASIS} /></h2>
            </div>
            <p class={ministryTemplate.paragraph}>{ministry.nextStep}</p>
          </section>
        )
      }
    </div>

    <aside class={ministryTemplate.toc}>
      <div class={ministryTemplate.tocPanel}>
        <span class={ministryTemplate.tocTitle}>{copy.tocTitle}</span>
        <nav class={ministryTemplate.tocNav}>
          {
            sections.map((section) => (
              <a
                href={`#${section.id}`}
                class={ministryTemplate.tocLink}
                data-content-toc
                data-target={section.id}
              >
                <span class={ministryTemplate.tocNumber}>{section.number}</span>{sectionLabel[section.key].toc}
              </a>
            ))
          }
        </nav>
      </div>
      <div class={ministryTemplate.shortcuts}>
        <span class={ministryTemplate.shortcutsTitle}>{copy.shortcuts.title}</span>
        {shortcuts.map((shortcut) => (
          <a href={shortcut.href} class={ministryTemplate.shortcutLink}>{shortcut.label}</a>
        ))}
      </div>
    </aside>
  </section>

  <section class={ministryTemplate.cta}>
    <div class={ministryTemplate.ctaPanel}>
      <AnchorMark id="mn-cta" color="#fff" outline={false} class={ministryTemplate.ctaMark} />
      <div class={ministryTemplate.ctaCopy}>
        <span class={ministryTemplate.ctaEyebrow}>{copy.cta.eyebrow}</span>
        <h2 class={ministryTemplate.ctaTitle}>
          <InlineText value={{ before: copy.cta.titleBefore, emphasis: `${ministry.name}.` }} emphasisClass="not-italic" />
        </h2>
      </div>
      <div class={ministryTemplate.ctaActions}>
        <Button href={localizePath('/#visitanos', locale)} variant="dark" class={ministryTemplate.ctaPrimary}>{copy.cta.primary}</Button>
        <Button href={juntosPath} class={ministryTemplate.ctaSecondary}>{copy.cta.secondary}</Button>
      </div>
    </div>
  </section>
</article>

<script>
  import { initContentPage } from 'src/scripts/contentPage';
  initContentPage();
</script>
