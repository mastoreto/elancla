---
import AnchorMark from 'src/components/AnchorMark.astro';
import { doctrineIcons } from 'src/data/doctrineIcons';
import { localizePath } from 'src/i18n/utils';
import { getMessages } from 'src/i18n/messages';
import type { Locale } from 'src/i18n/config';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['landing']['doctrines'];
  locale: Locale;
}
const { copy, locale } = Astro.props;
const doctrines = getMessages(locale).confession.doctrines;
const STEP = 40;
---

<section id="doctrinas" class="ln-section ln-doc" data-ln="doctrines" aria-labelledby="ln-doc-title">
  <div class="ln-doc__side" data-doc-side>
    <h2 id="ln-doc-title" class="ln-doc__title">{copy.title}</h2>
    <p class="ln-doc__intro">{copy.intro}</p>
    <blockquote class="ln-doc__quote">
      <p>{copy.quote}</p>
      <cite>{copy.cite}</cite>
    </blockquote>
  </div>

  <div class="ln-doc__stage" data-doc-stage>
    <span class="ln-doc__ring" aria-hidden="true"></span>

    <div class="ln-doc__orbit" role="group" aria-label={copy.listLabel}>
      <div class="ln-doc__spin" data-doc-spin>
        {doctrines.map((d, i) => (
          <div class="ln-doc__slot" style={`transform:rotate(${i * STEP}deg) translateY(calc(var(--orbit-r) * -1)) rotate(${-i * STEP}deg)`}>
            <div class="ln-doc__ctr" data-doc-ctr>
              <button type="button" class="ln-dot" data-doc-dot={i} aria-label={`${copy.goTo}: ${d.title}`}>
                <svg viewBox="0 0 120 120" fill="currentColor" stroke="currentColor" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                  {doctrineIcons[i].map((s) => s.circle
                    ? <circle cx={s.circle[0]} cy={s.circle[1]} r={s.circle[2]} />
                    : <path d={s.d} fill={s.cut ? 'var(--ln-warm)' : undefined} />)}
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="ln-doc__intro-anchor" data-doc-anchor>
      <AnchorMark id="doc" color="#f4efe6" strokeWidth={26} fillFrom="empty" />
    </div>

    <div class="ln-doc__big" aria-hidden="true">
      <svg viewBox="-4 -4 128 128" fill="none" stroke-linejoin="round" stroke-linecap="round">
        {doctrineIcons.map((shapes, i) => (
          <g data-ic={i}>
            <clipPath id={`doc-clip-${i}`}><rect data-doc-forge x="-4" y="124" width="128" height="128" /></clipPath>
            {shapes.filter((s) => !s.cut).map((s) => s.circle
              ? <circle data-doc-draw pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" cx={s.circle[0]} cy={s.circle[1]} r={s.circle[2]} stroke="#f4efe6" stroke-width="4" />
              : <path data-doc-draw pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" d={s.d} stroke="#f4efe6" stroke-width="4" />)}
            <g clip-path={`url(#doc-clip-${i})`} fill="#f4efe6" stroke="#f4efe6" stroke-width="4">
              {shapes.map((s) => s.circle
                ? <circle cx={s.circle[0]} cy={s.circle[1]} r={s.circle[2]} />
                : <path d={s.d} fill={s.cut ? 'var(--ln-warm)' : undefined} stroke={s.cut ? 'none' : undefined} />)}
            </g>
          </g>
        ))}
      </svg>
    </div>

    <div class="ln-doc__caption" aria-live="polite">
      {doctrines.map((d, i) => (
        <div class="ln-doc__cap" data-doc-cap={i}>
          <strong>{d.title.toUpperCase()}</strong>
          <span>{d.subtitle}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="ln-doc__seal" aria-hidden="true">
    <AnchorMark id="doc-seal" color="#3d3634" outline={false} />
    <span>{copy.mark}</span>
  </div>

  <div class="ln-doc__foot" data-doc-foot>
    <p>{copy.closing}</p>
    <a href={localizePath('/confesion-de-fe', locale)} class="ln-btn ln-btn--light">
      {copy.cta}
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>

  <!-- Plain list for screen readers, and the visible fallback without motion. -->
  <ol class="ln-doc__list">
    {doctrines.map((d) => <li><strong>{d.title}</strong><span>{d.subtitle}</span></li>)}
  </ol>
</section>
