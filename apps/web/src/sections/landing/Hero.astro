---
import AnchorMark from 'src/components/AnchorMark.astro';
import { LandingSection } from 'src/sections/landing/components/LandingSection';
import { localizePath } from 'src/i18n/utils';
import type { Locale } from 'src/i18n/config';
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['landing']['hero'];
  locale: Locale;
  street: string;
}
const { copy, locale, street } = Astro.props;
const [line1, ...rest] = street.split(', ');

// Drifting columns (design "B3"): every column scrolls forever, alternating up/down.
// `n` is the photo (public/images/hero/hero<n>-md.webp), `h` its height in px at full scale,
// `pos` the object-position that keeps the subject in frame.
type Tile = { n: number; h: number; pos: string };
const columns: { tiles: Tile[]; dir: 'up' | 'down'; secs: number; offset: number }[] = [
  { dir: 'up', secs: 80, offset: -60, tiles: [
    { n: 10, h: 340, pos: '50% 55%' }, { n: 5, h: 280, pos: '50% 50%' }, { n: 8, h: 360, pos: '50% 55%' },
    { n: 3, h: 300, pos: '50% 25%' }, { n: 6, h: 320, pos: '40% 50%' },
  ] },
  { dir: 'down', secs: 95, offset: -260, tiles: [
    { n: 2, h: 300, pos: '50% 30%' }, { n: 7, h: 360, pos: '50% 60%' }, { n: 4, h: 280, pos: '50% 40%' },
    { n: 1, h: 340, pos: '50% 70%' }, { n: 10, h: 300, pos: '50% 40%' },
  ] },
  { dir: 'up', secs: 70, offset: -120, tiles: [
    { n: 8, h: 360, pos: '50% 55%' }, { n: 6, h: 300, pos: '40% 50%' }, { n: 5, h: 320, pos: '50% 45%' },
    { n: 3, h: 280, pos: '50% 30%' }, { n: 2, h: 340, pos: '50% 35%' },
  ] },
  { dir: 'down', secs: 88, offset: -340, tiles: [
    { n: 4, h: 280, pos: '50% 40%' }, { n: 1, h: 340, pos: '50% 70%' }, { n: 7, h: 300, pos: '50% 60%' },
    { n: 10, h: 360, pos: '50% 55%' }, { n: 6, h: 300, pos: '40% 50%' },
  ] },
];

const DRIFT_ANIMATION = { up: 'animate-drift-up', down: 'animate-drift-down' } as const;
const FACT_CLASS = [
  'flex flex-col gap-0.5 rounded-[24px] bg-obra-white px-5 py-3.5 shadow-obra-float',
  'max-lg:rounded-none max-lg:bg-transparent max-lg:py-3 max-lg:shadow-none',
  'max-lg:not-first:border-l max-lg:not-first:border-obra-ink/12',
  'max-sm:not-first:border-t max-sm:not-first:border-l-0',
];
---

<LandingSection
  id="inicio"
  data-ln="hero"
  class:list={[
    'grid min-h-[calc(100svh_+_40px)] grid-cols-1 items-center bg-obra-mist px-gutter pt-[clamp(6.5rem,12vh,8rem)] pb-38',
    '[--colw:290px] [--gap:16px] [--k:1]',
    'max-lg:min-h-auto max-lg:content-start max-lg:items-start max-lg:gap-10 max-lg:px-6 max-lg:pt-29 max-lg:pb-12',
    'max-lg:[grid-template-areas:"text"_"facts"_"photo"] max-lg:[--colw:220px] max-lg:[--gap:12px] max-lg:[--k:0.76]',
    'max-sm:gap-7 max-sm:px-4 max-sm:pt-28 max-sm:pb-7 max-sm:[--colw:150px] max-sm:[--gap:8px] max-sm:[--k:0.5]',
  ]}
>
  <div
    class="relative z-4 flex max-w-124 flex-col gap-6 max-lg:max-w-none max-lg:gap-5 max-lg:px-4 max-lg:[grid-area:text] max-sm:px-1"
    data-hero-text
  >
    <span class="font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-muted uppercase" data-hero-in>
      {copy.eyebrow}
    </span>
    <h1
      class="ln-h text-[clamp(2.6rem,min(5.7vw,8.6vh),5.125rem)] leading-[0.95] tracking-[-0.025em] text-balance max-lg:text-[4.5rem] max-sm:text-[2.875rem] max-sm:leading-[0.97]"
      data-hero-in
    >
      {copy.title}
    </h1>
    <p
      class="m-0 max-w-100 text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55] text-obra-ink-soft max-lg:max-w-120 max-lg:text-[1.1875rem] max-sm:text-[1.0625rem]"
      data-hero-in
    >
      {copy.text}
    </p>
    <a href={localizePath('/visitanos', locale)} class="ln-btn self-start" data-hero-in>
      {copy.cta}<span class="ln-btn__dot" aria-hidden="true">→</span>
    </a>
  </div>

  <div
    class="absolute inset-0 z-1 overflow-hidden bg-obra-mist max-lg:relative max-lg:inset-auto max-lg:h-130 max-lg:rounded-[48px] max-lg:[grid-area:photo] max-sm:h-82.5 max-sm:rounded-[32px]"
    data-hero-photo
    aria-hidden="true"
  >
    <div
      class="absolute -top-75 left-[42.4%] flex h-[max(1500px,170svh)] w-[calc(4*var(--colw)+3*var(--gap))] -rotate-8 gap-(--gap) max-lg:top-[-40%] max-lg:left-1/2 max-lg:ml-[calc(-2*var(--colw)-1.5*var(--gap))] max-lg:h-[260%] max-sm:top-[-60%] max-sm:h-[300%]"
    >
      {columns.map((col) => (
        <div class="w-(--colw) flex-none" style={`margin-top: calc(${col.offset}px * var(--k))`}>
          <div
            class:list={['flex flex-col will-change-transform motion-reduce:animate-none', DRIFT_ANIMATION[col.dir]]}
            style={`--t: ${col.secs}s`}
          >
            {[0, 1].map((copyIndex) => (
              <div>
                {col.tiles.map((tile) => (
                  <div
                    class="mb-(--gap) h-[calc(var(--h)*var(--k))] flex-none overflow-hidden rounded-[calc(36px*var(--k))]"
                    style={`--h: ${tile.h}px`}
                  >
                    <img
                      src={`/images/hero/hero${tile.n}-md.webp`}
                      alt=""
                      class="ln-photo"
                      style={`object-position: ${tile.pos}`}
                      loading={copyIndex === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgba(232,230,226,0.97)_0%,rgba(232,230,226,0.9)_34%,rgba(232,230,226,0.35)_58%,rgba(232,230,226,0.05)_100%)] max-lg:hidden"
    >
    </div>
  </div>

  <div
    class:list={[
      'absolute top-[26%] left-[44%] z-3 w-[clamp(150px,min(18vw,34vh),300px)] drop-shadow-[0_22px_36px_rgba(21,21,21,0.3)]',
      'max-lg:relative max-lg:inset-auto max-lg:mb-12 max-lg:ml-12 max-lg:w-50 max-lg:self-end max-lg:justify-self-start',
      'max-lg:drop-shadow-[0_22px_36px_rgba(21,21,21,0.35)] max-lg:[grid-area:photo]',
      'max-sm:mb-6 max-sm:ml-6 max-sm:w-32.5',
    ]}
    data-hero-anchor
  >
    <!-- While the loader's anchor flies into place it stands in for this one. -->
    <AnchorMark
      id="hero"
      color="#a8141b"
      strokeWidth={28}
      fillFrom="empty"
      class="block h-auto w-full in-[.ldr-floating]:invisible"
    />
  </div>

  <div
    class:list={[
      'absolute bottom-14 left-gutter z-4 flex gap-2.5',
      'max-lg:relative max-lg:bottom-auto max-lg:left-auto max-lg:mx-4 max-lg:flex-wrap max-lg:gap-0 max-lg:self-start max-lg:justify-self-start',
      'max-lg:rounded-[24px] max-lg:bg-obra-white max-lg:shadow-obra-float max-lg:[grid-area:facts]',
      'max-sm:mx-1 max-sm:flex-col max-sm:self-stretch max-sm:justify-self-stretch',
    ]}
    data-hero-facts
  >
    <div class:list={FACT_CLASS} data-hero-fact>
      <small class="font-obra-sans-bold text-[0.75rem] tracking-[0.12em] text-obra-muted uppercase">{copy.sunday}</small>
      <strong class="font-obra-serif text-[1.875rem] leading-none max-lg:text-[1.625rem]">11:15</strong>
    </div>
    <div class:list={FACT_CLASS} data-hero-fact>
      <small class="font-obra-sans-bold text-[0.75rem] tracking-[0.12em] text-obra-muted uppercase">{copy.where}</small>
      <span class="font-obra-sans-bold text-[1.0625rem] leading-[1.3] max-lg:text-[1rem]">
        {line1}{rest.length > 0 && <><br />{rest.join(', ')}</>}
      </span>
    </div>
  </div>
</LandingSection>
