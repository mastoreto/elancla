---
import type { Messages } from 'src/i18n/messages';

interface Props {
  copy: Messages['landing']['sunday'];
  street: string;
  mapsUrl: string;
  email: string;
}
const { copy, street, mapsUrl, email } = Astro.props;
---

<section id="domingo" class="ln-section ln-sun" data-ln="sunday">
  <div class="ln-sun__card">
    <div class="ln-sun__photo" data-sun-photo>
      <img src="/images/salon.jpg" alt={copy.photoAlt} class="ln-photo" style="object-position:50% 40%" loading="lazy" decoding="async" />
      <span class="ln-sun__badge">{street}</span>
    </div>
    <div class="ln-sun__body">
      <div data-sun-in style="display:flex;flex-direction:column;gap:12px">
        <span class="ln-eyebrow">{copy.eyebrow}</span>
        <h2 class="ln-h ln-sun__title">{copy.title}</h2>
      </div>
      <div class="ln-sun__rows" data-sun-in>
        {copy.rows.map((row, i) => (
          <div class="ln-row" data-sun-row={i}>
            <span class="ln-row__t">{row.time}</span>
            <b class="ln-row__h">{row.title}</b>
            <span class="ln-row__d">{row.text}</span>
          </div>
        ))}
      </div>
      <div class="ln-sun__cta" data-sun-in>
        <a href={mapsUrl} class="ln-btn" target="_blank" rel="noopener">{copy.how}<span class="ln-btn__dot" aria-hidden="true">→</span></a>
        <a href={`mailto:${email}`} class="ln-btn ln-btn--ghost">{copy.write}</a>
      </div>
    </div>
  </div>
</section>
