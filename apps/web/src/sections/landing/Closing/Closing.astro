---
import Button from 'src/components/ui/Button';
import AnchorMark from 'src/components/AnchorMark';
import { ANCHOR_PATH } from 'src/data/anchorPath';
import { LandingSection } from 'src/sections/landing/components/LandingSection';
import type { Messages } from 'src/i18n/messages';
import cn from 'src/utils/cn';

interface Props {
  copy: Messages['landing']['closing'];
  street: string;
  mapsUrl: string;
  embedUrl: string;
  social: { youtube?: string; instagram?: string; facebook?: string };
}
const { copy, street, mapsUrl, embedUrl, social } = Astro.props;
const icons = {
  youtube: '<rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="M10 9.2l5 2.8-5 2.8z" fill="currentColor"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/>',
  facebook: '<path d="M14 8h2.5V4.5H14a4 4 0 0 0-4 4V11H7.5v3.5H10V21h3.5v-6.5H16l.5-3.5h-3V8.8c0-.5.3-.8.8-.8z"/>',
} as const;
const names = { youtube: 'YouTube', instagram: 'Instagram', facebook: 'Facebook' } as const;
const links = (Object.keys(icons) as (keyof typeof icons)[]).filter((k) => social[k]);
const KICKER_CLASS = 'font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-blush uppercase';

const closingSection = {
  container: cn('flex min-h-svh flex-col bg-obra-red pt-10 text-white', 'max-lg:min-h-auto'),
  grid: cn(
    'grid flex-1 grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] items-center',
    'gap-[clamp(2rem,5vw,5rem)] px-[clamp(1.5rem,6.7vw,6rem)] pt-24 pb-18',
    'max-lg:grid-cols-1 max-lg:items-start max-lg:gap-7 max-lg:px-11 max-lg:pt-22',
    'max-lg:pb-20',
    'max-sm:gap-6 max-sm:px-6 max-sm:py-16',
  ),
  copy: cn('flex max-w-152 flex-col gap-6', 'max-lg:max-w-none max-lg:gap-7 max-sm:gap-6'),
  intro: cn('flex items-center gap-3.5'),
  anchorMark: cn('h-auto w-8.5'),
  eyebrow: cn(KICKER_CLASS),
  title: cn(
    'ln-h text-[clamp(2.6rem,5.85vw,5.25rem)] leading-[0.94] tracking-[-0.025em]',
    'max-lg:text-[4.75rem] max-sm:text-[3.125rem] max-sm:leading-[0.96]',
  ),
  text: cn(
    'm-0 max-w-130 text-[clamp(1.0625rem,1.4vw,1.25rem)] leading-[1.5]',
    'max-lg:text-[1.25rem] max-sm:text-[1.125rem]',
  ),
  social: cn('mt-3 flex flex-col gap-3.5 border-t border-obra-white/30 pt-6'),
  followLabel: cn(KICKER_CLASS),
  links: cn('flex flex-wrap gap-2.5'),
  socialLink: cn(
    'inline-flex min-h-13 items-center gap-2.5 rounded-full border-[1.5px]',
    'border-obra-white/70 pr-5 pl-4',
    'font-obra-sans-bold text-[1rem] text-white no-underline',
    '[transition:background-color_0.4s,color_0.4s,translate_0.5s_var(--ease-obra)]',
    'hover:-translate-y-0.5 hover:bg-obra-white hover:text-obra-red',
  ),
  socialIcon: cn('size-5.5'),
  mapCard: cn(
    'flex flex-col overflow-hidden rounded-[40px] bg-obra-white text-obra-ink',
    'max-lg:mt-2 max-lg:rounded-[32px]',
  ),
  mapFrame: cn('relative aspect-[580/396]'),
  mapEmbed: cn('absolute inset-0 block size-full border-0'),
  mapPinSvg: cn(
    'pointer-events-none absolute top-1/2 left-1/2 h-25 w-21 -translate-x-1/2',
    '-translate-y-[84%] overflow-visible',
  ),
  mapPinShadow: cn('origin-center opacity-0 transform-fill animate-halo', 'motion-reduce:hidden'),
  mapPin: cn('origin-bottom transform-fill'),
  address: cn(
    'flex flex-wrap items-center justify-between gap-5 py-6 pr-6 pl-7',
    'max-lg:flex-nowrap max-lg:px-7 max-lg:py-5.5 max-sm:flex-col max-sm:items-start',
    'max-sm:gap-4.5 max-sm:px-5.5',
  ),
  addressStreet: cn('block font-obra-sans-bold text-[1.1875rem] leading-[1.3]'),
  addressWhere: cn('text-[0.9375rem] text-obra-muted'),
};
---

<LandingSection
  id="visitanos"
  data-ln="closing"
  class={closingSection.container}
>
  <div
    class={closingSection.grid}
  >
    <div class={closingSection.copy}>
      <div class={closingSection.intro} data-end-in>
        <AnchorMark id="end" color="#fff" strokeWidth={40} fillFrom="empty" class={closingSection.anchorMark} />
        <span class={closingSection.eyebrow}>{copy.eyebrow}</span>
      </div>
      <h2
        class={closingSection.title}
        data-end-in
      >
        {copy.title}
      </h2>
      <p
        class={closingSection.text}
        data-end-in
      >
        {copy.text}
      </p>
      <div class={closingSection.social} data-end-in>
        <span class={closingSection.followLabel}>{copy.follow}</span>
        <div class={closingSection.links}>
          {links.map((k) => (
            <a
              href={social[k]}
              class={closingSection.socialLink}
              target="_blank"
              rel="noopener"
            >
              <svg
                viewBox="0 0 24 24"
                class={closingSection.socialIcon}
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[k]}
              />
              <span>{names[k]}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div
      class={closingSection.mapCard}
      data-end-card
    >
      <div class={closingSection.mapFrame}>
        <iframe
          class={closingSection.mapEmbed}
          src={embedUrl}
          title={copy.mapLabel}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <svg
          class={closingSection.mapPinSvg}
          viewBox="247 130 84 100"
          aria-hidden="true"
        >
          <circle
            class={closingSection.mapPinShadow}
            cx="289"
            cy="214"
            r="14"
            fill="#a8141b"
          />
          <g class={closingSection.mapPin} data-end-pin>
            <path d="M289 214 C271 190 261 176 261 162 A28 28 0 1 1 317 162 C317 176 307 190 289 214 Z" fill="#a8141b" />
            <path d={ANCHOR_PATH} transform="translate(276,178) scale(0.013,-0.013)" fill="#fff" />
          </g>
        </svg>
      </div>
      <div
        class={closingSection.address}
      >
        <div>
          <b class={closingSection.addressStreet}>{street}</b>
          <span class={closingSection.addressWhere}>{copy.where}</span>
        </div>
        <Button href={mapsUrl} arrow dotClass="text-[0.9375rem] text-obra-muted" target="_blank" rel="noopener">{copy.how}</Button>
      </div>
    </div>
  </div>
</LandingSection>
