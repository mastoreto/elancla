---
import type { ContentTeamBlock } from 'src/data/contentPages';
import cn from 'src/utils/cn';

interface Props {
  block: ContentTeamBlock;
}

const { block } = Astro.props;

const aboutTeam = {
  container: cn('grid grid-cols-[1fr] gap-3.5', 'md:grid-cols-[repeat(2,1fr)]'),
  person: cn(
    'flex flex-col gap-3 rounded-[28px] bg-obra-mist p-5.5 text-inherit no-underline',
    '[transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s_var(--ease-obra),background-color_0.4s]',
    'hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift',
    'motion-reduce:transition-none'
  ),
  initials: cn(
    'flex size-15 items-center justify-center rounded-full font-obra-sans-bold',
    'text-[1.125rem] text-white'
  ),
  initialsLead: cn('bg-obra-red'),
  initialsRest: cn('bg-obra-ink'),
  role: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] uppercase text-obra-muted'
  ),
  personName: cn('font-obra-serif text-[1.5rem] leading-[1.1] font-bold'),
  bio: cn('text-[0.9375rem] leading-normal text-obra-ink-soft'),
};
---

<div class={aboutTeam.container}>
  {
    block.people.map((person, i) => (
      <article class={aboutTeam.person}>
        <span
          class={cn(aboutTeam.initials, i === 0 ? aboutTeam.initialsLead : aboutTeam.initialsRest)}
          aria-hidden="true"
        >{person.initials}</span>
        <span class={aboutTeam.role}>{person.role}</span>
        <b class={aboutTeam.personName}>{person.name}</b>
        <span class={aboutTeam.bio}>{person.bio}</span>
      </article>
    ))
  }
</div>
