---
import type { ContentValuesBlock } from 'src/data/contentPages';
import cn from 'src/utils/cn';

interface Props {
  block: ContentValuesBlock;
}

const { block } = Astro.props;

const aboutValues = {
  container: cn('grid grid-cols-[1fr] gap-3.5', 'md:grid-cols-[repeat(3,1fr)]'),
  value: cn(
    'flex flex-col gap-3 rounded-[28px] bg-obra-mist p-6.5 text-inherit no-underline',
    '[transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s_var(--ease-obra),background-color_0.4s]',
    'hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift',
    'motion-reduce:transition-none',
  ),
  number: cn('font-obra-serif text-[2.75rem] leading-none font-bold text-obra-red'),
  valueTitle: cn('font-obra-serif text-[1.625rem] leading-[1.1] font-bold'),
  description: cn('text-[1rem] leading-[1.55] text-obra-ink-soft'),
  stack: cn('flex flex-col gap-1.5 rounded-3xl bg-obra-white px-6 py-5'),
  noteLabel: cn('ln-eyebrow'),
  text: cn(
    'm-0 text-[1rem] leading-[1.55]',
    '[&_a]:font-obra-sans-bold [&_a]:text-obra-red [&_a]:underline [&_a]:underline-offset-3',
  ),
};
---

<div class={aboutValues.container}>
  {
    block.values.map((v) => (
      <div class={aboutValues.value}>
        <span class={aboutValues.number}>{v.number}</span>
        <b class={aboutValues.valueTitle}>{v.title}</b>
        <span class={aboutValues.description}>{v.description}</span>
      </div>
    ))
  }
</div>
{
  block.note && (
    <div class={aboutValues.stack}>
      <span class={aboutValues.noteLabel}>{block.note.label}</span>
      <p
        class={aboutValues.text}
        set:html={block.note.html}
      />
    </div>
  )
}
