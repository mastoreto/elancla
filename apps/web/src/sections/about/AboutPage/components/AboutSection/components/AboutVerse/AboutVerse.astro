---
import AnchorMark from 'src/components/AnchorMark';
import type { ContentVerseBlock } from 'src/data/contentPages';
import cn from 'src/utils/cn';

interface Props {
  block: ContentVerseBlock;
  sectionId: string;
}

const { block, sectionId } = Astro.props;

const aboutVerse = {
  container: cn(
    'relative m-0 flex flex-col gap-3.5 overflow-hidden rounded-[clamp(1.75rem,2.8vw,2.5rem)]',
    'bg-obra-red p-[clamp(1.75rem,3vw,2.75rem)] text-white',
  ),
  anchorMark: cn('absolute right-5 -bottom-7.5 h-auto w-[9.4rem] opacity-12'),
  text: cn(
    'relative m-0 font-obra-serif text-[clamp(1.625rem,2.5vw,2.25rem)] leading-[1.15]',
    'font-bold',
  ),
  reference: cn(
    'relative font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-blush',
    'uppercase not-italic',
  ),
};
---

<blockquote class={aboutVerse.container}>
  <AnchorMark id={`ab-verse-${sectionId}`} color="#fff" outline={false} class={aboutVerse.anchorMark} />
  <p class={aboutVerse.text}>«{block.text}»</p>
  <cite class={aboutVerse.reference}>{block.reference}</cite>
</blockquote>
