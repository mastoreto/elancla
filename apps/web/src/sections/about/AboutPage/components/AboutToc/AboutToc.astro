---
import { ULINK } from 'src/styles/classes';
import type { ContentSection } from 'src/data/contentPages';
import cn from 'src/utils/cn';

interface Props {
  title: string;
  sections: ContentSection[];
}

const { title, sections } = Astro.props;

const aboutToc = {
  container: cn(
    'sticky top-28 flex flex-[0_0_14.375rem] flex-col gap-3.5 self-start',
    'max-lg:hidden',
  ),
  label: cn('font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] uppercase text-obra-muted'),
  sections: cn('flex flex-col gap-3.5'),
  tocLabel: cn(
    ULINK,
    'w-fit font-obra-sans-bold text-[0.9375rem] text-obra-muted no-underline',
    '[transition:color_0.3s] [&.is-active]:text-obra-red',
  ),
};
---

<aside class={aboutToc.container}>
  <span class={aboutToc.label}>{title}</span>
  <nav class={aboutToc.sections} aria-label={title}>
    {sections.map((s) => <a
          href={`#${s.id}`}
          class={aboutToc.tocLabel}
          data-toc-link
          data-target={s.id}
        >{s.tocLabel}</a>)}
  </nav>
</aside>
