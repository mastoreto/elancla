---
import AnchorMark from 'src/components/AnchorMark';
import InlineText from 'src/components/InlineText';
import Button from 'src/components/ui/Button';
import type { ContentCta } from 'src/data/contentPages';
import cn from 'src/utils/cn';

interface Props {
  cta: ContentCta;
}

const { cta } = Astro.props;

const aboutCTA = {
  container: cn('px-gutter-sm pt-[clamp(3.5rem,6.1vw,5.5rem)]'),
  stack: cn(
    'relative flex flex-col gap-5.5 overflow-hidden rounded-[clamp(2rem,3.3vw,3rem)]',
    'bg-obra-warm px-[clamp(1.5rem,5vw,4.5rem)] py-[clamp(2rem,5vw,4.5rem)] text-obra-cream'
  ),
  abCta: cn('absolute right-10 -bottom-10 h-auto w-64 opacity-10'),
  eyebrow: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-red-live uppercase'
  ),
  heading: cn('ln-h relative text-[clamp(2.75rem,6.1vw,5.5rem)]'),
  ctaBody: cn(
    'relative m-0 max-w-140 text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55]',
    'text-obra-sand'
  ),
  row: cn('relative flex flex-wrap gap-3'),
  secondaryLabel: cn('border-obra-white/70 text-white'),
};
---

<section class={aboutCTA.container}>
  <div class={aboutCTA.stack}>
    <AnchorMark id="ab-cta" color="#f4efe6" outline={false} class={aboutCTA.abCta} />
    <span class={aboutCTA.eyebrow}>{cta.eyebrow}</span>
    <h2 class={aboutCTA.heading}>
      <InlineText value={cta.title} emphasisClass="text-obra-red-live not-italic" />
    </h2>
    <p class={aboutCTA.ctaBody}>{cta.body}</p>
    <div class={aboutCTA.row}>
      <Button href={cta.primary.href} arrow>{cta.primary.label}</Button>
      {cta.secondary && <Button href={cta.secondary.href} variant="ghost" class={aboutCTA.secondaryLabel}>{cta.secondary.label}</Button>}
    </div>
  </div>
</section>
