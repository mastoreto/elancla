---
import { getSiteConfig } from '@ancla/content';
import AnchorMark from 'src/components/AnchorMark';
import Button from 'src/components/ui/Button';
import Chip from 'src/components/ui/Chip';
import {
  embedUrl,
  getLiveStream,
  getSeries,
  getSermons,
  watchUrl,
} from 'src/data/youtube';
import type { Locale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { getHtmlLang, interpolateDeep, localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout';
import { PHOTO } from 'src/styles/classes';
import cn from 'src/utils/cn';
import { RISE_IN } from 'src/utils/riseIn';
import { buildSiteTokens } from 'src/utils/siteTokens';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const site = Astro.locals.site ?? (await getSiteConfig());
const copy = interpolateDeep(
  getMessages(locale).sermonsPage,
  buildSiteTokens(site, locale)
);
const path = localizePath('/sermones', locale);

// ?serie=<playlistId> filters the list; only ids of the channel's own playlists are accepted.
const [live, latestList, series] = await Promise.all([
  getLiveStream(),
  getSermons(),
  getSeries(),
]);
const selected = series.find(
  (serie) => serie.id === Astro.url.searchParams.get('serie')
);
const sermons = selected ? await getSermons(selected.id) : latestList;
const latest = latestList[0];

const dateFormat = new Intl.DateTimeFormat(getHtmlLang(locale), {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: site.timezone,
});
const metaOf = (sermon: { publishedAt: string; duration: string }) =>
  `${dateFormat.format(new Date(sermon.publishedAt)).replace(/\./g, '')} · ${sermon.duration}`;

const initialId = live?.id ?? latest?.id;
const initialTitle = live?.title ?? latest?.title ?? copy.player.emptyTitle;
const PAGE_SIZE = 9;
const subscribeUrl = `${site.social.youtube ?? 'https://youtube.com'}?sub_confirmation=1`;
// The server sets `data-live` on the hero and ./scripts/sermons.ts flips it when the stream starts or ends.
const LIVE_ONLY = 'group-data-[live=false]/hero:hidden';
const IDLE_ONLY = 'group-data-[live=true]/hero:hidden';
const DOT =
  'inline-block rounded-full bg-obra-white animate-pulse-soft motion-reduce:animate-none';
const SECTION = 'flex flex-col gap-5 px-gutter pt-[clamp(3.5rem,7vw,5rem)]';
const HERO_BLOCK = 'flex flex-col gap-6.5';
const HERO_TITLE =
  'ln-h text-[clamp(2.875rem,7.5vw,6.75rem)] leading-[0.94] tracking-[-0.03em] text-balance';
const LEAD =
  'm-0 max-w-140 text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55] text-obra-ink-soft';
const SCREEN_CHIP =
  'pointer-events-none absolute top-4 left-4 z-1 inline-flex items-center gap-2 rounded-full px-3.25 py-1.75 font-obra-sans-bold text-[0.75rem]';
const RED_EM = 'text-obra-red not-italic';
const chips = [
  { label: copy.list.all, href: `${path}#sermones`, on: !selected },
  ...series.map((serie) => ({
    label: serie.title,
    href: `${path}?serie=${serie.id}#sermones`,
    on: serie.id === selected?.id,
  })),
];

const sermonsPage = {
  container: cn('ln overflow-x-clip bg-obra-paper', '[&_[hidden]]:hidden!'),
  sermonsHero: cn(
    'group/hero flex items-center gap-14 px-gutter pt-[clamp(7rem,12vh,8.5rem)]',
    'max-lg:flex-col max-lg:items-stretch max-lg:gap-8'
  ),
  heroCopy: cn('min-w-0 flex-1'),
  liveOnly: cn(HERO_BLOCK, LIVE_ONLY),
  liveBadge: cn(
    'inline-flex items-center gap-2.5 self-start rounded-full bg-obra-live px-4 py-2.25',
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.14em] text-white uppercase',
    RISE_IN
  ),
  liveBadgeDot: cn(DOT, 'size-2'),
  liveTitle: cn(HERO_TITLE, RISE_IN),
  liveTitleEmphasis: cn(RED_EM),
  liveBody: cn(LEAD, RISE_IN),
  liveActions: cn('flex flex-wrap gap-3', RISE_IN),
  idleOnly: cn(HERO_BLOCK, IDLE_ONLY),
  idleEyebrow: cn('ln-eyebrow', RISE_IN),
  idleTitle: cn(HERO_TITLE, RISE_IN),
  idleTitleEmphasis: cn(RED_EM),
  idleBody: cn(LEAD, RISE_IN),
  idleActions: cn('flex flex-wrap gap-3', RISE_IN),
  sermonsPlayer: cn(
    'flex flex-[0_0_min(640px,46%)] flex-col gap-5 rounded-[48px] bg-obra-mist p-5',
    'max-lg:flex-none max-lg:rounded-[32px] max-lg:p-3',
    RISE_IN
  ),
  playerFrame: cn(
    'relative aspect-video overflow-hidden rounded-[36px] bg-obra-warm',
    'max-lg:rounded-[22px]'
  ),
  player: cn('absolute inset-0 size-full border-0'),
  playerEmpty: cn(
    'absolute inset-0 flex flex-col items-center justify-center gap-2 p-6 text-center',
    'text-obra-cream'
  ),
  playerEmptyMark: cn('mb-2 h-auto w-12 text-obra-red-live opacity-60'),
  emptyTitle: cn('font-obra-serif text-[1.5rem]'),
  emptyBody: cn('text-[0.9375rem] text-obra-sand'),
  playerLiveChip: cn(
    SCREEN_CHIP,
    'bg-obra-live tracking-[0.08em] text-white uppercase',
    LIVE_ONLY
  ),
  playerLiveDot: cn(DOT, 'size-1.75'),
  latestChip: cn(
    SCREEN_CHIP,
    'bg-obra-white tracking-[0.04em] text-obra-ink',
    IDLE_ONLY
  ),
  playerInfo: cn('flex flex-col gap-2.5 px-4 pb-3', 'max-sm:px-2 max-sm:pb-2'),
  playerEyebrow: cn(
    'font-obra-sans-bold text-[0.75rem] tracking-[0.12em] text-obra-red uppercase'
  ),
  initialTitle: cn(
    'font-obra-serif text-[clamp(1.625rem,2.4vw,2.125rem)] leading-[1.05] font-bold',
    'wrap-anywhere'
  ),
  nextService: cn(
    "inline-flex items-center gap-2.5 font-obra-sans-bold text-[0.875rem] before:size-2 before:rounded-full before:bg-obra-stone before:content-['']",
    IDLE_ONLY
  ),
  sermonsList: cn(SECTION),
  listEyebrow: cn('ln-eyebrow'),
  listTitle: cn('ln-h text-[clamp(2.25rem,4.2vw,3.75rem)] leading-none'),
  listTitleEmphasis: cn(RED_EM),
  listToolbar: cn(
    'flex items-center justify-between gap-4',
    'max-lg:flex-col max-lg:items-stretch'
  ),
  chips: cn('flex flex-wrap gap-2.5'),
  fieldLabel: cn(
    'flex min-h-13 flex-[0_0_340px] items-center gap-3 rounded-full bg-obra-white px-5.5',
    'text-obra-muted',
    'focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-obra-red',
    'max-lg:flex-none'
  ),
  searchLabel: cn('sr-only'),
  sermonsSearch: cn(
    'min-w-0 flex-1 border-0 bg-transparent text-[0.9375rem] leading-[inherit] text-obra-ink',
    'placeholder:text-obra-placeholder',
    '[outline:0]'
  ),
  empty: cn('mx-0 my-6 text-[1.0625rem] text-obra-ink-soft'),
  noResults: cn('mx-0 my-6 text-[1.0625rem] text-obra-ink-soft'),
  sermons: cn(
    'mt-3 grid grid-cols-3 gap-5',
    'max-lg:grid-cols-2 max-sm:grid-cols-[1fr]'
  ),
  sermonCard: cn(
    'group flex flex-col gap-4 rounded-[32px] bg-obra-mist px-4 pt-4 pb-6 text-inherit',
    'no-underline',
    '[transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s,background-color_0.4s]',
    'hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift focus-visible:outline-2',
    'focus-visible:outline-offset-3 focus-visible:outline-obra-red'
  ),
  sermonThumb: cn(
    'relative aspect-video overflow-hidden rounded-[22px] bg-obra-linen'
  ),
  sermonThumbImage: cn(PHOTO),
  sermonPlay: cn(
    'absolute top-1/2 left-1/2 flex size-14 -translate-1/2 items-center justify-center',
    'rounded-full bg-obra-white text-obra-red shadow-[0_12px_28px_-12px_rgba(21,21,21,0.6)]',
    '[transition:scale_0.5s_var(--ease-obra)] group-hover:scale-108'
  ),
  duration: cn(
    'absolute bottom-3.5 left-3.5 rounded-full bg-obra-ink/82 px-2.75 py-1.25',
    'font-obra-sans-bold text-[0.75rem] text-white'
  ),
  sermonBody: cn('flex flex-col gap-2.5 px-2'),
  sermonDate: cn(
    'font-obra-sans-bold text-[0.75rem] tracking-[0.12em] text-obra-muted uppercase'
  ),
  sermonTitle: cn(
    'm-0 font-obra-serif text-[1.5625rem] leading-[1.1] font-bold wrap-anywhere',
    'max-sm:text-[1.375rem]'
  ),
  watch: cn('font-obra-sans-bold text-[0.8125rem] text-obra-red'),
  listMore: cn('mt-4 flex justify-center'),
  seriesSection: cn(SECTION),
  seriesPanel: cn(
    'rounded-[48px] bg-obra-warm p-[clamp(2rem,5vw,4rem)] text-obra-cream',
    'max-lg:rounded-[32px]'
  ),
  seriesHeader: cn(
    'mb-10 flex gap-16',
    '*:min-w-0 *:flex-1',
    'max-lg:flex-col max-lg:gap-5'
  ),
  seriesEyebrow: cn('ln-eyebrow text-obra-red-live'),
  seriesTitle: cn('ln-h mt-4 text-[clamp(2.5rem,4.4vw,4rem)] leading-none'),
  seriesTitleEmphasis: cn('text-obra-red-live not-italic'),
  seriesBody: cn('m-0 text-[1.125rem] leading-[1.55] text-obra-sand'),
  seriesGrid: cn(
    'grid grid-cols-3 gap-4',
    'max-lg:grid-cols-2 max-sm:grid-cols-[1fr]'
  ),
  seriesCard: cn(
    'flex flex-col gap-3 rounded-[28px] border border-obra-warm-line bg-obra-warm-card p-6',
    'text-obra-cream no-underline',
    '[transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s] hover:-translate-y-0.5',
    'hover:shadow-[0_14px_28px_-14px_rgba(0,0,0,0.6)]'
  ),
  seriesCount: cn(
    'font-obra-sans-bold text-[0.75rem] tracking-[0.12em] text-obra-sand uppercase'
  ),
  seriesCardTitle: cn(
    'font-obra-serif text-[1.875rem] leading-[1.05] wrap-anywhere'
  ),
  ctaSection: cn(SECTION),
  ctaPanel: cn(
    'relative flex items-center gap-14 overflow-hidden rounded-[48px] bg-obra-red',
    'p-[clamp(2rem,5vw,4rem)] text-white',
    'max-lg:flex-col max-lg:items-stretch max-lg:gap-7 max-lg:rounded-[32px]'
  ),
  ctaMark: cn(
    'pointer-events-none absolute -right-7.5 -bottom-10 h-auto w-65 text-white opacity-10'
  ),
  ctaCopy: cn('relative flex flex-1 flex-col gap-3.5'),
  ctaEyebrow: cn('ln-eyebrow text-obra-blush'),
  ctaTitle: cn('ln-h text-[clamp(2.25rem,3.9vw,3.5rem)] leading-none'),
  ctaBody: cn('m-0 max-w-120 text-[1.125rem] leading-normal'),
  ctaActions: cn('relative flex flex-[0_0_auto] flex-col'),
  subscribe: cn('justify-center'),
  bottomSpacer: cn('h-[clamp(4rem,8vw,6rem)]'),
};
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  keywords={copy.seo.keywords}
  breadcrumbs={[
    { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
    { name: copy.breadcrumbs.current, url: path },
  ]}
  locale={locale}
>
  <div class={sermonsPage.container}>
    <section
      class={sermonsPage.sermonsHero}
      data-sermons-hero
      data-live={live ? 'true' : 'false'}
      data-latest-id={latest?.id ?? ''}
      data-latest-title={latest?.title ?? ''}
      data-latest-meta={latest ? metaOf(latest) : ''}
      data-live-meta={copy.player.liveMeta}
      data-playing-chip={copy.player.playingChip}
      data-latest-chip={copy.player.latestChip}
    >
      <div class={sermonsPage.heroCopy}>
        <div class={sermonsPage.liveOnly} data-live-only>
          <span
            class={sermonsPage.liveBadge}
          ><i class={sermonsPage.liveBadgeDot} aria-hidden="true"></i>{copy.hero.live.badge}</span>
          <h1 class={sermonsPage.liveTitle} style="--d: .15s">{copy.hero.live.titleBefore}<em class={sermonsPage.liveTitleEmphasis}>{copy.hero.live.titleEmphasis}</em></h1>
          <p class={sermonsPage.liveBody} style="--d: .3s">{copy.hero.live.body}</p>
          <div class={sermonsPage.liveActions} style="--d: .45s">
            <Button href={live ? watchUrl(live.id) : site.social.youtube} arrow target="_blank" rel="noopener" data-live-link>{copy.hero.live.primaryCta}</Button>
            <Button href="#sermones" variant="ghost">{copy.hero.live.secondaryCta}</Button>
          </div>
        </div>
        <div class={sermonsPage.idleOnly} data-idle-only>
          <span class={sermonsPage.idleEyebrow}>{copy.hero.idle.eyebrow}</span>
          <h1 class={sermonsPage.idleTitle} style="--d: .15s">{copy.hero.idle.titleBefore}<em class={sermonsPage.idleTitleEmphasis}>{copy.hero.idle.titleEmphasis}</em>{copy.hero.idle.titleAfter}</h1>
          <p class={sermonsPage.idleBody} style="--d: .3s">{copy.hero.idle.body}</p>
          <div class={sermonsPage.idleActions} style="--d: .45s">
            <Button href="#sermones" arrow>{copy.hero.idle.primaryCta}</Button>
            <Button href={subscribeUrl} variant="ghost" target="_blank" rel="noopener">{copy.hero.idle.secondaryCta}</Button>
          </div>
        </div>
      </div>

      <div
        class={sermonsPage.sermonsPlayer}
        style="--d: .5s"
        id="vivo"
        data-sermons-player
      >
        <div class={sermonsPage.playerFrame} id="reproductor">
          {
            initialId ? (
              <iframe
                class={sermonsPage.player}
                data-player
                src={embedUrl(initialId)}
                title={copy.player.iframeTitle}
                loading="lazy"
                allow="accelerometer; encrypted-media; picture-in-picture; fullscreen"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            ) : (
              <div class={sermonsPage.playerEmpty}>
                <AnchorMark id="sm-empty" outline={false} class={sermonsPage.playerEmptyMark} />
                <b class={sermonsPage.emptyTitle}>{copy.player.emptyTitle}</b>
                <span class={sermonsPage.emptyBody}>{copy.player.emptyBody}</span>
              </div>
            )
          }
          <span
            class={sermonsPage.playerLiveChip}
            data-live-only
          ><i class={sermonsPage.playerLiveDot} aria-hidden="true"></i>{copy.player.liveChip}</span>
          <span
            class={sermonsPage.latestChip}
            data-idle-only
            data-player-chip
          >{copy.player.latestChip}</span>
        </div>
        {
          initialId && (
            <div class={sermonsPage.playerInfo}>
              <span class={sermonsPage.playerEyebrow} data-player-eyebrow>{live || !latest ? copy.player.liveMeta : metaOf(latest)}</span>
              <b class={sermonsPage.initialTitle} data-player-title>{initialTitle}</b>
              <span
                class={sermonsPage.nextService}
                data-idle-only
              >{copy.player.nextService}</span>
            </div>
          )
        }
      </div>
    </section>

    <section id="sermones" class={sermonsPage.sermonsList} data-sermons-list data-page-size={PAGE_SIZE}>
      <span class={sermonsPage.listEyebrow}>{copy.list.eyebrow}</span>
      <h2 class={sermonsPage.listTitle}>{copy.list.title}<em class={sermonsPage.listTitleEmphasis}>{copy.list.emphasis}</em></h2>
      <div class={sermonsPage.listToolbar}>
        {
          chips.length > 1 && (
            <div class={sermonsPage.chips}>
              {chips.map((chip) => (
                <Chip href={chip.href} data-on={chip.on} aria-current={chip.on ? 'page' : undefined}>{chip.label}</Chip>
              ))}
            </div>
          )
        }
        <label class={sermonsPage.fieldLabel}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4 4"></path></svg>
          <span class={sermonsPage.searchLabel}>{copy.list.searchLabel}</span>
          <input
            class={sermonsPage.sermonsSearch}
            type="search"
            placeholder={copy.list.searchPlaceholder}
            data-sermons-search
          />
        </label>
      </div>

      {sermons.length === 0 && <p class={sermonsPage.empty}>{copy.list.empty}</p>}
      <p class={sermonsPage.noResults} data-sermons-empty hidden>{copy.list.noResults}</p>
      <div class={sermonsPage.sermons}>
        {
          sermons.map((sermon, index) => (
            <a
              href={watchUrl(sermon.id)}
              class={sermonsPage.sermonCard}
              target="_blank"
              rel="noopener"
              hidden={index >= PAGE_SIZE}
              data-sermon-card
              data-video-id={sermon.id}
              data-title={sermon.title}
              data-meta={metaOf(sermon)}
            >
              <div class={sermonsPage.sermonThumb}>
                <img class={sermonsPage.sermonThumbImage} src={`https://i.ytimg.com/vi/${sermon.id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />
                <span
                  class={sermonsPage.sermonPlay}
                  aria-hidden="true"
                ><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg></span>
                <span class={sermonsPage.duration}>{sermon.duration}</span>
              </div>
              <div class={sermonsPage.sermonBody}>
                <span class={sermonsPage.sermonDate}>{dateFormat.format(new Date(sermon.publishedAt)).replace(/\./g, '')}</span>
                <h3 class={sermonsPage.sermonTitle}>{sermon.title}</h3>
                <span class={sermonsPage.watch}>{copy.list.watch} ↗</span>
              </div>
            </a>
          ))
        }
      </div>
      {
        sermons.length > PAGE_SIZE && (
          <div class={sermonsPage.listMore}>
            <Button variant="ghost" data-sermons-more>{copy.list.more}</Button>
          </div>
        )
      }
    </section>

    {
      series.length > 0 && (
        <section class={sermonsPage.seriesSection}>
          <div class={sermonsPage.seriesPanel}>
            <div class={sermonsPage.seriesHeader}>
              <div>
                <span class={sermonsPage.seriesEyebrow}>{copy.series.eyebrow}</span>
                <h3 class={sermonsPage.seriesTitle}>
                  {copy.series.title}<em class={sermonsPage.seriesTitleEmphasis}>{copy.series.emphasis}</em></h3>
              </div>
              <p class={sermonsPage.seriesBody}>{copy.series.body}</p>
            </div>
            <div class={sermonsPage.seriesGrid}>
              {series.map((serie) => (
                <a
                  href={`${path}?serie=${serie.id}#sermones`}
                  class={sermonsPage.seriesCard}
                >
                  <small class={sermonsPage.seriesCount}>{serie.count === 1 ? copy.series.countOne : copy.series.count.replace('{n}', String(serie.count))}</small>
                  <b class={sermonsPage.seriesCardTitle}>{serie.title}</b>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class={sermonsPage.ctaSection}>
      <div class={sermonsPage.ctaPanel}>
        <AnchorMark
          id="sm-cta"
          outline={false}
          class={sermonsPage.ctaMark}
        />
        <div class={sermonsPage.ctaCopy}>
          <span class={sermonsPage.ctaEyebrow}>{copy.cta.eyebrow}</span>
          <h3 class={sermonsPage.ctaTitle}>{copy.cta.title}</h3>
          <p class={sermonsPage.ctaBody}>{copy.cta.body}</p>
        </div>
        <div class={sermonsPage.ctaActions}>
          <Button href={subscribeUrl} variant="dark" class={sermonsPage.subscribe} target="_blank" rel="noopener">{copy.cta.subscribe}</Button>
        </div>
      </div>
    </section>
    <div class={sermonsPage.bottomSpacer}></div>
  </div>
</Layout>

<script>
  import { initSermons } from 'src/sections/sermons/SermonsPage/scripts/sermons';
  document.addEventListener('astro:page-load', initSermons);
</script>
