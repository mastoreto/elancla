---
import type { PublicPost } from '@ancla/content';
import Pill from 'src/components/ui/Pill';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import BlogCover from 'src/sections/blog/components/BlogCover';
import { formatBlogDate } from 'src/sections/blog/utils/formatBlogDate';
import cn from 'src/utils/cn';
import { RISE_IN } from 'src/utils/riseIn';

interface Props {
  article: PublicPost;
  copy: any;
  /** Unit of the reading time ("min"). */
  minutes: string;
  locale: Locale;
}

const { article, copy, minutes, locale } = Astro.props;
const meta = [
  formatBlogDate(article.urlDate, locale),
  `${article.readingMinutes} ${minutes}`,
  `${article.wordCount} ${copy.words}`,
].join(' · ');

const blogArticleHero = {
  container: cn(
    'flex max-w-275 flex-col gap-6.5 px-gutter pt-[clamp(6.5rem,11vh,8rem)]'
  ),
  nav: cn(
    'flex items-center gap-2 font-obra-sans-bold text-[0.875rem] text-obra-muted'
  ),
  link: cn('no-underline', 'hover:text-obra-red'),
  category: cn('text-obra-red', '[font-weight:inherit]'),
  articleTitle: cn(
    'ln-h text-[clamp(2.5rem,5.8vw,5.25rem)] leading-[0.97] tracking-[-0.03em] text-balance',
    RISE_IN
  ),
  description: cn(
    'm-0 max-w-180 text-[clamp(1.1875rem,1.6vw,1.375rem)] leading-normal text-obra-ink-soft',
    RISE_IN
  ),
  row: cn('flex flex-wrap items-center gap-3.5', RISE_IN),
  initials: cn(
    'flex size-12 flex-none items-center justify-center rounded-full bg-obra-red',
    'font-obra-sans-bold text-white'
  ),
  label: cn('flex flex-col gap-0.5'),
  displayDate: cn('text-[0.875rem] text-obra-muted'),
  section: cn('mt-10 px-gutter'),
  blogCover: cn('h-[clamp(240px,36vw,520px)]', RISE_IN),
};
---

<header class={blogArticleHero.container}>
  <nav
    class={blogArticleHero.nav}
    aria-label="breadcrumb"
  >
    <a href={localizePath('/blog', locale)} class={blogArticleHero.link}>Blog</a>
    <span aria-hidden="true">/</span>
    <b class={blogArticleHero.category}>{article.category.name}</b>
  </nav>
  <h1
    class={blogArticleHero.articleTitle}
  >{article.title}</h1>
  <p
    class={blogArticleHero.description}
    style="--d: .15s"
  >{article.excerpt}</p>
  <div class={blogArticleHero.row} style="--d: .3s">
    <span class={blogArticleHero.initials} aria-hidden="true">{article.author.initials}</span>
    <span class={blogArticleHero.label}>
      <b>{article.author.name}</b>
      <small class={blogArticleHero.displayDate}>{meta}</small>
    </span>
  </div>
</header>

<section class={blogArticleHero.section}>
  <BlogCover
    cover={article.cover}
    size="hero"
    priority
    class={blogArticleHero.blogCover}
  >
    <Pill>{article.category.name}</Pill>
  </BlogCover>
</section>
