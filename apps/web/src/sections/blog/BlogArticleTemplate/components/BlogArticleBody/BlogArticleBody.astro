---
// The body of a post: the HTML `renderBlogBody` built from the API's JSON (the only HTML this
// component injects). Its look lives in `styles.ts`, keyed on the `blog-*` classes of the renderer.
import { blogArticleBodyStyles } from './styles';

interface Props {
  /** Output of `renderBlogBody`. */
  html: string;
}

const { html } = Astro.props;
---

<div class={blogArticleBodyStyles.container} set:html={html} />
