---
import type { PublicPostSummary } from '@ancla/content';
import type { Locale } from 'src/i18n/config';
import BlogArticleCard from 'src/sections/blog/components/BlogArticleCard';
import cn from 'src/utils/cn';

interface Props {
  articles: PublicPostSummary[];
  copy: any;
  by: string;
  minutes: string;
  locale: Locale;
}

const { articles, copy, by, minutes, locale } = Astro.props;

const blogRelated = {
  container: cn('flex flex-col gap-6 pt-[clamp(3.5rem,7vw,5rem)] px-gutter'),
  related: cn('ln-eyebrow'),
  articles: cn(
    'grid grid-cols-[repeat(3,1fr)] gap-4',
    'max-lg:grid-cols-[repeat(2,1fr)] max-sm:grid-cols-[1fr]'
  ),
};
---

{articles.length > 0 && (
  <section class={blogRelated.container}>
    <span class={blogRelated.related}>{copy.related}</span>
    <div class={blogRelated.articles}>
      {articles.map((article) => <BlogArticleCard article={article} by={by} minutes={minutes} locale={locale} />)}
    </div>
  </section>
)}
