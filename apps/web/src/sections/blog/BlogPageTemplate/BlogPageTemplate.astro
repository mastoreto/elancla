---
import type { BlogArticle, BlogCategory, BlogSeriesItem } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import BlogArticleGrid from 'src/sections/blog/BlogPageTemplate/components/BlogArticleGrid';
import BlogCategories from 'src/sections/blog/BlogPageTemplate/components/BlogCategories';
import BlogFeatured from 'src/sections/blog/BlogPageTemplate/components/BlogFeatured';
import BlogHero from 'src/sections/blog/BlogPageTemplate/components/BlogHero';
import BlogMarquee from 'src/sections/blog/BlogPageTemplate/components/BlogMarquee';
import BlogSeries from 'src/sections/blog/BlogPageTemplate/components/BlogSeries';
import NewsletterCard from 'src/sections/blog/components/NewsletterCard';
import cn from 'src/utils/cn';

interface Props {
  articles: BlogArticle[];
  categories: BlogCategory[];
  featured: BlogArticle | null;
  marqueeItems: string[];
  series: BlogSeriesItem[];
  copy: any;
  locale: Locale;
}

const { articles, categories, featured, marqueeItems, series, copy, locale } =
  Astro.props;

const blogPageTemplate = {
  container: cn('ln overflow-x-clip bg-obra-paper'),
  wrapper: cn('h-[clamp(4rem,8vw,6rem)]'),
};
---

<div class={blogPageTemplate.container}>
  <BlogHero copy={copy.hero} />
  <BlogMarquee items={marqueeItems} />
  <BlogFeatured article={featured} copy={copy.featured} locale={locale} />
  <BlogCategories categories={categories} copy={copy.categories} />
  <BlogArticleGrid articles={articles} copy={copy.articles} locale={locale} />
  <BlogSeries series={series} copy={copy.series} locale={locale} />
  <NewsletterCard id="newsletter" copy={copy.newsletter} />
  <div class={blogPageTemplate.wrapper}></div>
</div>
