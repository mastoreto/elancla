---
import type { PublicPostSummary } from '@ancla/content';
import Button from 'src/components/ui/Button';
import Pill from 'src/components/ui/Pill';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import BlogCover from 'src/sections/blog/components/BlogCover';
import { formatBlogDate } from 'src/sections/blog/utils/formatBlogDate';
import { getBlogArticlePath } from 'src/sections/blog/utils/getBlogArticlePath';
import cn from 'src/utils/cn';

interface Props {
  article: PublicPostSummary | null;
  copy: any;
  /** Unit of the reading time ("min"). */
  minutes: string;
  locale: Locale;
}

const { article, copy, minutes, locale } = Astro.props;
const href = article ? localizePath(getBlogArticlePath(article), locale) : '';

const blogFeatured = {
  container: cn('pt-[clamp(3.5rem,7vw,5rem)] px-gutter'),
  counter: cn('ln-eyebrow'),
  link: cn(
    'mt-5 flex gap-10 rounded-[48px] bg-obra-mist p-5 text-inherit no-underline',
    '[transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s,background-color_0.4s]',
    'hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift',
    'max-lg:flex-col max-lg:gap-5 max-lg:rounded-[32px] max-lg:p-4'
  ),
  blogCover: cn(
    'min-h-105 flex-[0_0_min(640px,46%)]',
    'max-lg:h-70 max-lg:min-h-0 max-lg:flex-none'
  ),
  stack: cn(
    'flex min-w-0 flex-1 flex-col justify-center gap-4.5 py-5 pr-9',
    'max-lg:px-2 max-lg:pt-2 max-lg:pb-4'
  ),
  category: cn('ln-eyebrow'),
  articleTitle: cn('ln-h text-[clamp(2rem,3.6vw,3.25rem)] leading-none'),
  excerpt: cn(
    'm-0 text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55] text-obra-ink-soft'
  ),
  row: cn('flex flex-wrap items-center gap-4'),
  small: cn('text-[0.875rem] text-obra-muted'),
};
---

{article && (
  <section class={blogFeatured.container}>
    <span class={blogFeatured.counter}>{copy.counter}</span>
    <a
    href={href}
    class={blogFeatured.link}
  >
      <BlogCover cover={article.cover} size="lg" class={blogFeatured.blogCover}>
        <Pill tone="red">{copy.featured}</Pill>
      </BlogCover>
      <div class={blogFeatured.stack}>
        <span class={blogFeatured.category}>{article.category.name} · {formatBlogDate(article.urlDate, locale)}</span>
        <h2 class={blogFeatured.articleTitle}>{article.title}</h2>
        <p class={blogFeatured.excerpt}>{article.excerpt}</p>
        <div class={blogFeatured.row}>
          <Button as="span" arrow>{copy.read}</Button>
          <small class={blogFeatured.small}>{copy.by} {article.authorName} · {article.readingMinutes} {minutes}</small>
        </div>
      </div>
    </a>
  </section>
)}
