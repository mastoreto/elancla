---
import { RISE_IN } from 'src/utils/riseIn';
import Button from 'src/components/ui/Button';
import AnchorMark from 'src/components/AnchorMark';
import cn from 'src/utils/cn';

interface Props {
  copy: any;
}

const { copy } = Astro.props;
const { frequency, now, categories } = copy.facts;
const FACT_LABEL = 'font-obra-sans-bold text-[0.75rem] tracking-[0.12em] uppercase';
const FACT_VALUE = 'font-obra-serif text-[1.875rem] leading-none';

const blogHero = {
  container: cn(
    'flex items-end gap-16 px-gutter pt-[clamp(7rem,12vh,8.5rem)]',
    'max-lg:flex-col max-lg:items-stretch max-lg:gap-8',
  ),
  intro: cn('flex min-w-0 flex-1 flex-col gap-6.5'),
  eyebrow: cn('ln-eyebrow', RISE_IN),
  title: cn(
    'ln-h text-[clamp(2.875rem,7.5vw,6.75rem)] leading-[0.94] tracking-[-0.03em] text-balance',
    RISE_IN,
  ),
  titleEmphasis: cn('text-obra-red not-italic'),
  text: cn(
    'm-0 text-[clamp(1.0625rem,1.3vw,1.1875rem)] leading-[1.55] text-obra-ink-soft max-w-140',
    RISE_IN,
  ),
  actions: cn('flex flex-wrap gap-3', RISE_IN),
  facts: cn('grid flex-[0_0_min(440px,34vw)] grid-cols-2 gap-2.5', 'max-lg:flex-none', RISE_IN),
  frequencyFact: cn('flex flex-col gap-1.5 rounded-[28px] p-5 bg-obra-white'),
  frequencyLabel: cn(FACT_LABEL, 'text-obra-muted'),
  frequencyValue: cn(FACT_VALUE),
  frequencyDescription: cn('text-[0.875rem] text-obra-muted'),
  nowFact: cn('flex flex-col gap-1.5 rounded-[28px] p-5 bg-obra-red text-white'),
  nowLabel: cn(FACT_LABEL, 'text-obra-blush'),
  nowValue: cn(FACT_VALUE),
  nowDescription: cn('text-[0.875rem] text-obra-blush'),
  categoriesFact: cn(
    'flex flex-col gap-1.5 rounded-[28px] p-5 col-span-2 flex-row items-center',
    'justify-between bg-obra-mist',
  ),
  categoriesCopy: cn('flex flex-col gap-1.5'),
  categoriesLabel: cn(FACT_LABEL, 'text-obra-muted'),
  categoriesValue: cn(FACT_VALUE),
  categoriesMark: cn('h-auto w-7.5 text-obra-red'),
};
---

<section class={blogHero.container}>
  <div class={blogHero.intro}>
    <span class={blogHero.eyebrow}>{copy.eyebrow}</span>
    <h1
      class={blogHero.title}
      style="--d: .15s"
    >
      {copy.titleBefore}<em class={blogHero.titleEmphasis}>{copy.emphasis}</em>{copy.titleAfter}
    </h1>
    <p class={blogHero.text} style="--d: .3s">{copy.body}</p>
    <div class={blogHero.actions} style="--d: .45s">
      <Button href="#articulos" arrow>{copy.primaryCta}</Button>
      <Button href="#newsletter" variant="ghost">{copy.secondaryCta}</Button>
    </div>
  </div>

  <div
    class={blogHero.facts}
    style="--d: .5s"
  >
    <div class={blogHero.frequencyFact}>
      <small class={blogHero.frequencyLabel}>{frequency.label}</small>
      <strong class={blogHero.frequencyValue}>{frequency.value}</strong>
      <span class={blogHero.frequencyDescription}>{frequency.description}</span>
    </div>
    <div class={blogHero.nowFact}>
      <small class={blogHero.nowLabel}>{now.label}</small>
      <strong class={blogHero.nowValue}>{now.value}</strong>
      <span class={blogHero.nowDescription}>{now.description}</span>
    </div>
    <div class={blogHero.categoriesFact}>
      <div class={blogHero.categoriesCopy}>
        <small class={blogHero.categoriesLabel}>{categories.label}</small>
        <strong class={blogHero.categoriesValue}>{categories.value}</strong>
      </div>
      <AnchorMark id="blog-fact-anchor" outline={false} class={blogHero.categoriesMark} />
    </div>
  </div>
</section>
