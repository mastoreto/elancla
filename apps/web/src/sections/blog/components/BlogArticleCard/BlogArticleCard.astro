---
import Pill from 'src/components/ui/Pill';
import type { BlogArticle } from 'src/data/blog';
import { getBlogArticlePath } from 'src/data/blog';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import BlogCover from 'src/sections/blog/components/BlogCover';
import { REVEAL_STATE } from 'src/styles/classes';
import cn from 'src/utils/cn';

interface Props {
  article: BlogArticle;
  by: string;
  locale: Locale;
}

const { article, by, locale } = Astro.props;
const href = localizePath(getBlogArticlePath(article), locale);

const blogArticleCard = {
  // Its own transition replaces the reveal one; the `.in` hover keeps the lift once revealed.
  container: cn(
    'flex flex-col gap-4 rounded-[32px] bg-obra-mist px-4 pt-4 pb-6 text-inherit no-underline',
    '[transition:transform_0.5s_var(--ease-obra),box-shadow_0.5s,background-color_0.4s]',
    'hover:[transform:translateY(-4px)] hover:[&.in]:[transform:translateY(-4px)]',
    'hover:bg-obra-white hover:shadow-obra-lift',
    REVEAL_STATE
  ),
  blogCover: cn('h-47.5', 'max-sm:h-37.5'),
  stack: cn('flex flex-col gap-2.5 px-2'),
  compactDate: cn(
    'font-obra-sans-bold text-[0.75rem] tracking-[0.12em] text-obra-muted'
  ),
  articleTitle: cn(
    'm-0 font-obra-serif text-[1.5625rem] leading-[1.1] font-bold',
    'max-sm:text-[1.375rem]'
  ),
  excerpt: cn('text-[0.9375rem] leading-normal text-obra-ink-soft'),
  label: cn('font-obra-sans-bold text-[0.8125rem] text-obra-red'),
};
---

<a
  href={href}
  class={blogArticleCard.container}
  data-reveal
  data-blog-article-card
  data-blog-filter={article.filter}
>
  <BlogCover tint={article.tint} class={blogArticleCard.blogCover}><Pill>{article.category}</Pill></BlogCover>
  <div class={blogArticleCard.stack}>
    <span class={blogArticleCard.compactDate}>{article.compactDate} · {article.readTime}</span>
    <h3 class={blogArticleCard.articleTitle}>{article.title}</h3>
    <span class={blogArticleCard.excerpt}>{article.excerpt}</span>
    <span class={blogArticleCard.label}>{by} {article.author.name}</span>
  </div>
</a>
