---
// Cover placeholder shared by cards, featured and article: tinted block + faint anchor.
// Slot = pills shown top-left. (Swap for a real <img class={PHOTO}> once articles carry a photo.)
import AnchorMark from 'src/components/AnchorMark';
import cn from 'src/utils/cn';

type CoverSize = 'sm' | 'lg' | 'hero';

interface Props {
  tint: string;
  size?: CoverSize;
  class?: string;
}

const SIZE: Record<CoverSize, { box: string; pills: string; ghost: string }> = {
  sm: { box: 'rounded-[22px] p-4', pills: 'top-3.5 left-3.5', ghost: 'w-14' },
  lg: { box: 'rounded-[36px] p-7', pills: 'top-4 left-4', ghost: 'w-30' },
  hero: {
    box: 'rounded-[clamp(28px,3.3vw,48px)] p-7',
    pills: 'top-4 left-4',
    ghost: 'w-[clamp(90px,10vw,150px)]',
  },
};

const { tint, size = 'sm', class: className } = Astro.props;
const { box, pills, ghost } = SIZE[size];

const blogCover = {
  container: cn(
    'relative flex items-end justify-end overflow-hidden bg-(--tint)',
    box,
    className
  ),
  category: cn('absolute flex gap-2', pills),
  markBox: cn('block text-obra-red opacity-16', ghost),
  mark: cn('block h-auto w-full'),
};
---

<div
  class={blogCover.container}
  style={`--tint: ${tint}`}
>
  <span class={blogCover.category}><slot /></span>
  <span class={blogCover.markBox}>
    <AnchorMark id="blog-cover" outline={false} class={blogCover.mark} />
  </span>
</div>
