---
// Cover shared by cards, featured and article: the photo of the post, or a design cover (tinted
// block + faint glyph). A photo that is not ready arrives as `null` and gets the default design.
// Slot = pills shown top-left.
import type { PublicBlogCover } from '@ancla/content';
import cn from 'src/utils/cn';
import BlogGlyph from './components/BlogGlyph';

type CoverSize = 'sm' | 'lg' | 'hero';
type DesignCover = Extract<PublicBlogCover, { kind: 'design' }>;

interface Props {
  cover: PublicBlogCover | null;
  size?: CoverSize;
  /** The cover of the hero is the LCP: it loads first instead of lazily. */
  priority?: boolean;
  class?: string;
}

const SIZE: Record<CoverSize, { box: string; pills: string; ghost: string }> = {
  sm: { box: 'rounded-[22px] p-4', pills: 'top-3.5 left-3.5', ghost: 'w-14' },
  lg: { box: 'rounded-[36px] p-7', pills: 'top-4 left-4', ghost: 'w-30' },
  hero: {
    box: 'rounded-[clamp(28px,3.3vw,48px)] p-7',
    pills: 'top-4 left-4',
    ghost: 'w-[clamp(90px,10vw,150px)]',
  },
};
// Full class names so Tailwind finds them: they read the `--color-cover-*` tokens of the theme.
const TINT: Record<DesignCover['tint'], string> = {
  paper: 'bg-cover-paper',
  cream: 'bg-cover-cream',
  stone: 'bg-cover-stone',
  sand: 'bg-cover-sand',
};
const DEFAULT_COVER: DesignCover = {
  kind: 'design',
  glyph: 'anchor',
  tint: 'paper',
};

const { cover, size = 'sm', priority = false, class: className } = Astro.props;
const { box, pills, ghost } = SIZE[size];
const shown = cover ?? DEFAULT_COVER;

const blogCover = {
  container: cn(
    'relative flex items-end justify-end overflow-hidden',
    box,
    shown.kind === 'design' && TINT[shown.tint],
    className
  ),
  photo: cn('absolute inset-0 size-full object-cover'),
  category: cn('absolute z-1 flex gap-2', pills),
  markBox: cn('block text-obra-red opacity-16', ghost),
  mark: cn('block h-auto w-full'),
};
---

<div class={blogCover.container}>
  {
    shown.kind === 'photo' && (
      <img
        class={blogCover.photo}
        src={shown.image.url}
        width={shown.image.width}
        height={shown.image.height}
        alt={shown.alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    )
  }
  <span class={blogCover.category}><slot /></span>
  {
    shown.kind === 'design' && (
      <span class={blogCover.markBox}>
        <BlogGlyph glyph={shown.glyph} class={blogCover.mark} />
      </span>
    )
  }
</div>
