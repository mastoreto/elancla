---
import type { PublicCalendar } from '@ancla/content';
import { cn } from '@ancla/utils';
import AnchorMark from 'src/components/AnchorMark';
import PrintMonthGrid from 'src/sections/calendar/CalendarPrint/components/PrintMonthGrid';
import {
  EYEBROW,
  EYEBROW_TONE,
  SERIF,
  SHEET,
  SHEET_TONE,
} from 'src/sections/calendar/CalendarPrint/styles';
import {
  MONTHS_ES,
  PRINT_LANG,
  printableEvents,
} from 'src/sections/calendar/CalendarPrint/utils/printFormat';
import {
  dayOfEvent,
  eventsOfMonth,
  sortWeekly,
} from 'src/sections/calendar/utils';
import { weekdayName } from 'src/utils/formatServiceTimes';

interface Props {
  calendar: PublicCalendar;
}
const { calendar } = Astro.props;

const year = calendar.year;
const events = printableEvents(calendar.events);
const weekly = sortWeekly(calendar.weekly);

const printA3 = {
  container: cn(
    SHEET,
    SHEET_TONE.light,
    'h-[296.6mm] w-[420mm] gap-7 px-16 py-14'
  ),
  header: cn('flex items-end justify-between'),
  brand: cn('flex items-center gap-6.5'),
  brandMark: cn('h-[71px] w-14 flex-none'),
  brandCopy: cn('flex flex-col gap-1.5'),
  brandChurch: cn(EYEBROW, EYEBROW_TONE.red),
  brandTitle: cn(SERIF, 'text-[96px] leading-[0.9] tracking-[-0.03em]'),
  weekly: cn('flex flex-col gap-[3px] text-right text-[14px]'),
  weeklyEyebrow: cn(EYEBROW, EYEBROW_TONE.ink),
  months: cn('grid grid-cols-[repeat(6,1fr)] gap-4'),
  month: cn('flex flex-col gap-2.5 rounded-[22px] bg-obra-white p-4.5'),
  monthName: cn(SERIF, 'text-[24px]'),
  events: cn(
    'flex min-h-[68px] flex-col gap-1 border-t border-obra-chalk pt-2'
  ),
  event: cn('flex gap-2 text-[12px] leading-[1.3]'),
  eventDay: cn('w-5 flex-none text-obra-red'),
  footer: cn('mt-auto flex justify-between text-[13px] text-obra-muted'),
};
---

<section class={printA3.container}>
  <header class={printA3.header}>
    <div class={printA3.brand}>
      <AnchorMark id="cp-a3" outline={false} color="#a8141b" class={printA3.brandMark} />
      <div class={printA3.brandCopy}>
        <span class={printA3.brandChurch}>Iglesia Bautista El Ancla · Montevideo</span>
        <b class={printA3.brandTitle}>Calendario {year}</b>
      </div>
    </div>
    <div class={printA3.weekly}>
      <span class={printA3.weeklyEyebrow}>Cada semana</span>
      {weekly.map((a) => <span><b>{weekdayName(a.weekday, PRINT_LANG, 'short')} {a.start}</b> {a.title}</span>)}
    </div>
  </header>

  <div class={printA3.months}>
    {MONTHS_ES.map((name, month) => {
      const list = eventsOfMonth(events, month);
      return (
        <div class={printA3.month}>
          <b class={printA3.monthName}>{name}</b>
          <PrintMonthGrid year={year} month={month} eventDays={list.map(dayOfEvent)} />
          <div class={printA3.events}>
            {list.map((e) => (
              <div class={printA3.event}><b class={printA3.eventDay}>{dayOfEvent(e)}</b><span>{e.title}</span></div>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <footer class={printA3.footer}>
    <span>Círculos rojos: eventos del año.</span>
    <span>Para imprimir en A3 · escala 100%</span>
  </footer>
</section>
