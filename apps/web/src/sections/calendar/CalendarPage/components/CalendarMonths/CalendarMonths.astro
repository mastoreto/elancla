---
import type { PublicCalendar } from '@ancla/content';
import { cn } from '@ancla/utils';
import type { Locale } from 'src/i18n/config';
import { interpolate } from 'src/i18n/interpolate';
import type { Messages } from 'src/i18n/messages';
import { getHtmlLang } from 'src/i18n/utils';
import CalendarEventRow from 'src/sections/calendar/CalendarPage/components/CalendarMonths/components/CalendarEventRow';
import CalendarFilters from 'src/sections/calendar/CalendarPage/components/CalendarMonths/components/CalendarFilters';
import CalendarSectionHead from 'src/sections/calendar/CalendarPage/components/CalendarSectionHead';
import {
  SECTION,
  SECTION_SPACING,
} from 'src/sections/calendar/CalendarPage/styles';
import { groupEventsByMonth, monthName } from 'src/sections/calendar/utils';

interface Props {
  calendar: PublicCalendar;
  copy: Messages['calendar'];
  locale: Locale;
}
const { calendar, copy, locale } = Astro.props;

const lang = getHtmlLang(locale);
const groups = groupEventsByMonth(calendar.events).map(
  ({ month, events: list }) => ({
    month,
    name: monthName(month, lang, 'long'),
    count:
      list.length === 1
        ? copy.months.countOne
        : interpolate(copy.months.countMany, { n: String(list.length) }),
    events: list,
  })
);

const calendarMonths = {
  container: cn(SECTION, SECTION_SPACING.default),
  empty: cn(
    'm-0 rounded-[20px] border-[1.5px] border-dashed border-obra-red bg-obra-white',
    'px-4.5 py-3.5 text-[0.9375rem] leading-[1.45]'
  ),
  groups: cn('mt-4 flex flex-col'),
  month: cn(
    'flex flex-col gap-6 border-t-[1.5px] border-obra-ink py-7.5',
    '[&[hidden]]:hidden',
    'max-md:gap-3.5 max-md:py-5.5 lg:flex-row lg:gap-10'
  ),
  groupHeader: cn(
    'flex flex-col gap-1.5',
    'lg:sticky lg:top-24 lg:min-w-0 lg:flex-[0_0_17rem] lg:self-start'
  ),
  groupName: cn(
    'font-obra-serif text-[clamp(2.5rem,3.6vw,3.5rem)] leading-[0.92] tracking-[-0.02em]',
    'wrap-anywhere capitalize',
    'max-md:text-[2.5rem]'
  ),
  count: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.12em] text-obra-red uppercase'
  ),
  rows: cn('flex min-w-0 flex-1 flex-col gap-2.5'),
};
---

<section class={calendarMonths.container} id="eventos" data-cal>
  <CalendarSectionHead eyebrow={copy.months.eyebrow} title={copy.months.title} emphasis={copy.months.emphasis} />
  {groups.length === 0 ? (
    <p class={calendarMonths.empty}>{interpolate(copy.months.empty, { year: String(calendar.year) })}</p>
  ) : (
    <>
      <CalendarFilters copy={copy} locale={locale} ministries={calendar.ministries} />
      <div class={calendarMonths.groups}>
        {groups.map((group) => (
          <section class={calendarMonths.month} data-month={group.month}>
            <header class={calendarMonths.groupHeader}>
              <h3 class={calendarMonths.groupName}>{group.name}</h3>
              <span class={calendarMonths.count}>{group.count}</span>
            </header>
            <div class={calendarMonths.rows}>
              {group.events.map((event) => (
                <CalendarEventRow event={event} ministries={calendar.ministries} timezone={calendar.timezone} copy={copy} locale={locale} />
              ))}
            </div>
          </section>
        ))}
      </div>
    </>
  )}
</section>
