---
import { MINISTRY_COLORS, PLACE_TBC, googleCalendarUrl, type CalendarEvent } from 'src/data/calendar';
import type { Messages } from 'src/i18n/messages';
import CalendarDate from 'src/sections/calendar/CalendarPage/components/CalendarDate';
import { DOT, FOCUS_RING } from 'src/sections/calendar/CalendarPage/styles';
import cn from 'src/utils/cn';

interface Props {
  event: CalendarEvent;
  weekday: string;
  copy: Messages['calendar'];
}
const { event, weekday, copy } = Astro.props;
const place = event.place === PLACE_TBC ? copy.months.tbc : event.place;
const suffix = copy.months.timeSuffix ? ` ${copy.months.timeSuffix}` : '';

// Desktop: one line (date · title · ministry · when · add). Phones: date and add span two rows.
const ROW = [
  'grid grid-cols-[auto_1fr_auto] items-center gap-x-5 gap-y-1.5 rounded-[28px] bg-obra-mist px-5.5 py-4.5 [&[hidden]]:hidden',
  '[transition:translate_0.5s_var(--ease-obra),box-shadow_0.5s,background-color_0.4s] hover:-translate-y-1 hover:bg-obra-white hover:shadow-obra-lift',
  'motion-reduce:transition-none motion-reduce:hover:translate-none',
  'lg:grid-cols-[auto_1fr_9.5rem_12rem_auto]',
  "max-md:grid-cols-[4rem_1fr_auto] max-md:gap-x-3.5 max-md:gap-y-1.25 max-md:rounded-3xl max-md:py-4 max-md:pr-4 max-md:pl-3.5 max-md:[grid-template-areas:'date_title_add'_'date_meta_add']",
];

const calendarEventRow = {
  container: cn(ROW),
  date: cn('w-18', 'max-md:w-16 max-md:[grid-area:date]'),
  eventTitle: cn(
    'font-obra-serif text-[1.5rem] leading-[1.05]',
    'max-md:[grid-area:title] max-md:text-[1.3125rem] max-md:leading-[1.08]',
    'lg:text-[1.6875rem]',
  ),
  meta: cn(
    'col-start-2 flex flex-wrap gap-x-6 gap-y-1',
    'max-md:[grid-area:meta] max-md:flex-col-reverse max-md:gap-1.25 lg:contents',
  ),
  ministry: cn(
    'flex items-center gap-2 font-obra-sans-bold text-[0.9375rem]',
    'max-md:text-[0.8125rem]',
  ),
  ministryDot: cn(DOT),
  time: cn('text-[0.9375rem] text-obra-ink-soft', 'max-md:text-[0.875rem]'),
  link: cn(
    'inline-flex size-11 flex-none items-center justify-center rounded-full border-[1.5px]',
    'border-obra-ink text-obra-ink',
    '[transition:background-color_0.3s,color_0.3s] hover:bg-obra-ink hover:text-white',
    'max-md:[grid-area:add]',
    FOCUS_RING,
  ),
};
---

<article class={calendarEventRow.container} data-ministry={event.ministry}>
  <div class={calendarEventRow.date}><CalendarDate day={Number(event.date.slice(8))} label={weekday} tone="row" /></div>
  <b class={calendarEventRow.eventTitle}>{event.title}</b>
  <div class={calendarEventRow.meta}>
    <span class={calendarEventRow.ministry}>
      <span class={calendarEventRow.ministryDot} style={`--c:${MINISTRY_COLORS[event.ministry]}`}></span>{copy.ministries[event.ministry]}
    </span>
    <span class={calendarEventRow.time}>{event.time}{suffix} · {place}</span>
  </div>
  <a
    class={calendarEventRow.link}
    href={googleCalendarUrl(event, place)}
    target="_blank"
    rel="noopener"
    aria-label={`${copy.months.add}: ${event.title}`}
    title={copy.months.add}
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3.5" y="5" width="17" height="15" rx="3"></rect>
      <path d="M8 3v4M16 3v4M3.5 10h17M12 13v4M10 15h4"></path>
    </svg>
  </a>
</article>
