---
import Button from 'src/components/ui/Button';
import type { Locale } from 'src/i18n/config';
import type { Messages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import CalendarDate from 'src/sections/calendar/CalendarPage/components/CalendarDate';
import {
  EMPHASIS,
  LEAD,
  SECTION,
  SECTION_SPACING,
} from 'src/sections/calendar/CalendarPage/styles';
import cn from 'src/utils/cn';

interface Props {
  copy: Messages['calendar'];
  locale: Locale;
  next: { day: number; weekday: string; month: string; title: string };
}
const { copy, locale, next } = Astro.props;

const calendarHero = {
  container: cn(SECTION, SECTION_SPACING.hero),
  nav: cn(
    'flex items-center gap-2 font-obra-sans-bold text-[0.875rem] text-obra-muted'
  ),
  homeLink: cn('text-inherit no-underline', 'hover:underline'),
  current: cn('text-obra-red'),
  body: cn(
    'flex flex-col gap-12',
    'max-md:gap-7 lg:flex-row lg:items-end lg:gap-16'
  ),
  intro: cn('flex flex-1 flex-col gap-6'),
  eyebrow: cn('ln-eyebrow'),
  title: cn(
    'ln-h text-[clamp(2.75rem,7.2vw,6.5rem)] leading-[0.94] tracking-[-0.03em] text-balance',
    'max-md:text-[clamp(2.5rem,12.8vw,3.125rem)]'
  ),
  titleEmphasis: cn(EMPHASIS),
  heroBody: cn(LEAD),
  actions: cn('flex flex-wrap gap-3'),
  nextCard: cn(
    'flex w-full max-w-110 flex-none flex-col gap-3.5 rounded-[36px] bg-obra-warm p-7.5',
    'text-obra-cream',
    'max-md:max-w-none max-md:rounded-[28px] max-md:p-5.5'
  ),
  nextLabel: cn(
    'font-obra-sans-bold text-[0.8125rem] tracking-[0.16em] text-obra-red-live uppercase'
  ),
  nextRow: cn('flex items-center gap-4.5'),
  nextTitle: cn('font-obra-serif text-[1.625rem] leading-[1.05]'),
};
---

<section class={calendarHero.container}>
  <nav class={calendarHero.nav} aria-label="Breadcrumb">
    <a href={localizePath('/', locale)} class={calendarHero.homeLink}>{copy.breadcrumbs.home}</a>
    <span aria-hidden="true">/</span>
    <span>{copy.breadcrumbs.resources}</span>
    <span aria-hidden="true">/</span>
    <span class={calendarHero.current} aria-current="page">{copy.breadcrumbs.current}</span>
  </nav>
  <div class={calendarHero.body}>
    <div class={calendarHero.intro}>
      <span class={calendarHero.eyebrow}>{copy.hero.eyebrow}</span>
      <h1 class={calendarHero.title}>
        {copy.hero.titleBefore}<em class={calendarHero.titleEmphasis}>{copy.hero.titleEmphasis}</em>
      </h1>
      <p class={calendarHero.heroBody}>{copy.hero.body}</p>
      <div class={calendarHero.actions}>
        <Button href="#llevalo" arrow>{copy.hero.orderCta}</Button>
        <Button href="#llevalo" variant="ghost">{copy.hero.downloadCta}</Button>
      </div>
    </div>
    <div class={calendarHero.nextCard}>
      <span class={calendarHero.nextLabel}>{copy.hero.nextLabel}</span>
      <div class={calendarHero.nextRow}>
        <CalendarDate day={next.day} label={`${next.weekday} · ${next.month}`} tone="hero" />
        <b class={calendarHero.nextTitle}>{next.title}</b>
      </div>
    </div>
  </div>
</section>
