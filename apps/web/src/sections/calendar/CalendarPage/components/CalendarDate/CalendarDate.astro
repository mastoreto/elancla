---
// Big day number with weekday (and optionally month) underneath. Used by the hero card and every event row.
import cn from 'src/utils/cn';

interface Props {
  day: number;
  label: string;
  tone: 'hero' | 'row';
}
const { day, label, tone } = Astro.props;

// Sizes carry the line-height (`size/leading`) so cn() keeps it when merging with the base.
const NUMBER_TONE = {
  hero: 'text-[4rem]/[0.9] text-obra-red-live',
  row: 'text-[3.25rem]/[0.9] text-obra-red max-md:text-[2.5rem]/[0.9]',
} as const;
const LABEL_TONE = {
  hero: 'text-obra-dune',
  row: 'text-obra-muted',
} as const;

const calendarDate = {
  container: cn('flex flex-col items-center'),
  day: cn('font-obra-serif', NUMBER_TONE[tone]),
  label: cn(
    'mt-1 font-obra-sans-bold text-[0.75rem] tracking-[0.14em] uppercase',
    LABEL_TONE[tone]
  ),
};
---

<div class={calendarDate.container}>
  <b class={calendarDate.day}>{day}</b>
  <span class={calendarDate.label}>{label}</span>
</div>
