---
import { getCalendar } from '@ancla/content';
import { cn } from '@ancla/utils';
import type { Locale } from 'src/i18n/config';
import { interpolate } from 'src/i18n/interpolate';
import { getMessages } from 'src/i18n/messages';
import { getHtmlLang, localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout';
import CalendarHero from 'src/sections/calendar/CalendarPage/components/CalendarHero';
import CalendarMonths from 'src/sections/calendar/CalendarPage/components/CalendarMonths';
import CalendarSubscribe from 'src/sections/calendar/CalendarPage/components/CalendarSubscribe';
import CalendarTakeHome from 'src/sections/calendar/CalendarPage/components/CalendarTakeHome';
import CalendarWeekly from 'src/sections/calendar/CalendarPage/components/CalendarWeekly';
import {
  findNextEvent,
  localDateIn,
  monthName,
} from 'src/sections/calendar/utils';
import { weekdayName } from 'src/utils/formatServiceTimes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getMessages(locale).calendar;
const lang = getHtmlLang(locale);

const calendar = await getCalendar(locale);
const year = String(calendar.year);
const today = localDateIn(calendar.timezone);
const nextEvent = findNextEvent(calendar.events, today);
const next = nextEvent && {
  day: Number(nextEvent.startDate.slice(8)),
  weekday: weekdayName(
    new Date(`${nextEvent.startDate}T00:00:00Z`).getUTCDay(),
    locale,
    'short'
  ),
  month: monthName(Number(nextEvent.startDate.slice(5, 7)) - 1, lang, 'short'),
  title: nextEvent.title,
};

const icsUrl = new URL('/calendario-anual.ics', Astro.site).toString();
const googleHref = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(icsUrl.replace(/^https?:/, 'webcal:'))}`;
const path = localizePath('/calendario-anual', locale);

const calendarPage = {
  container: cn('ln bg-obra-paper pb-24'),
};
---

<Layout
  title={interpolate(copy.seo.title, { year })}
  description={copy.seo.description}
  keywords={copy.seo.keywords}
  breadcrumbs={[
    { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
    { name: copy.breadcrumbs.current, url: path },
  ]}
  locale={locale}
>
  <div class={calendarPage.container} data-year={year}>
    <CalendarHero copy={copy} locale={locale} next={next} year={year} />
    <CalendarWeekly calendar={calendar} copy={copy} locale={locale} today={today} />
    <CalendarMonths calendar={calendar} copy={copy} locale={locale} />
    <CalendarTakeHome copy={copy} year={year} />
    <CalendarSubscribe copy={copy} googleHref={googleHref} icsHref={icsUrl} />
  </div>
</Layout>

<script>
  import { initCalendar } from 'src/sections/calendar/CalendarPage/scripts/calendar';
  document.addEventListener('astro:page-load', initCalendar);
</script>
