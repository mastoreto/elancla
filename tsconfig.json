{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@ancla/utils": ["packages/utils/src"],
      "@ancla/content": ["packages/content/src"],
      "@ancla/db": ["packages/db/src"],
      "@ancla/env": ["packages/env/src"]
    },
    "types": ["node"]
  }
}
