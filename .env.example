# Shared environment variables for the monorepo.
# Copy to .env.local and fill in. Each app/package reads what it needs.

# App environment (used by db scripts: .env.${APP_ENV})
APP_ENV=local

# Database (custom CMS + finanzas) — used by @ancla/db
# Usada por herramientas que corren en el HOST (db:push, seed:admin, prisma studio).
# Apunta al Postgres de Docker por su puerto EXTERNO (POSTGRES_PORT).
# Los contenedores se conectan por la red interna a db:5432 (no usan esta URL).
DATABASE_URL=postgresql://ancla:ancla@localhost:5433/ancla

# Credenciales del Postgres de docker-compose (servicio `db`)
POSTGRES_USER=ancla
POSTGRES_PASSWORD=ancla
POSTGRES_DB=ancla
# Puerto EXTERNO publicado en el host (el interno siempre es 5432).
# 5433 evita conflictos con un Postgres local en 5432.
POSTGRES_PORT=5433

# Seed opcional del primer admin (usado por el servicio `migrate` de compose)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# --- apps/web (el ancla) ---
# Sitio público (Astro estático servido con nginx en docker-compose).
WEB_PORT=8080
# Opcional: DATABASE_URL accesible en build para hornear la config real de la BD
# en el HTML estático (ej. postgresql://ancla:ancla@host.docker.internal:5433/ancla).
# Vacío → el sitio se construye con los valores de fallback.
WEB_BUILD_DATABASE_URL=

# --- apps/admin (iEkklesia) ---
# Backoffice. Better Auth (login + sesiones):
#   BETTER_AUTH_SECRET: secreto >=32 chars (generar con `openssl rand -base64 32`)
#   BETTER_AUTH_URL / NEXT_PUBLIC_BETTER_AUTH_URL: URL base del admin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --- YouTube (apps/web: /sermones y detección de directo) ---
# API key de Google Cloud con "YouTube Data API v3" habilitada, y el ID del canal (empieza con UC).
# Sin estas dos variables /sermones muestra el estado vacío y el sitio nunca marca "en vivo".
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Opcional: playlist con solo las prédicas. Vacío → se usan todos los videos subidos del canal.
YOUTUBE_SERMONS_PLAYLIST_ID=
