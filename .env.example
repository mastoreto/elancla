# Shared environment variables for the monorepo.
# Copy to .env.local and fill in. Each app/package reads what it needs.

# App environment (used by db scripts: .env.${APP_ENV})
APP_ENV=local

# Database (custom CMS + finanzas) — used by @ancla/db
# Usada por herramientas que corren en el HOST (db:push, seed:admin, prisma studio).
# Apunta al Postgres de Docker por su puerto EXTERNO (POSTGRES_PORT).
# Los contenedores se conectan por la red interna a db:5432 (no usan esta URL).
# Runtime connection (apps): app_runtime role, data access only, RLS applies.
DATABASE_URL=postgresql://app_runtime:ancla_runtime@localhost:5433/ancla
# Migration connection (Prisma CLI): app_migrator role, owns the schema.
DATABASE_MIGRATION_URL=postgresql://app_migrator:ancla_migrator@localhost:5433/ancla
# Passwords of the application roles (created by packages/db/docker/init-roles.sh).
APP_RUNTIME_PASSWORD=ancla_runtime
APP_MIGRATOR_PASSWORD=ancla_migrator

# Credenciales del Postgres de docker-compose (servicio `db`)
POSTGRES_USER=ancla
POSTGRES_PASSWORD=ancla
POSTGRES_DB=ancla
# Puerto EXTERNO publicado en el host (el interno siempre es 5432).
# 5433 evita conflictos con un Postgres local en 5432.
POSTGRES_PORT=5433

# Primer admin: ya no hay seed con contraseña (el alta es solo por invitación).
# Crea la invitación con: bun run --filter @ancla/api invite <email> --role admin

# --- apps/web (el ancla) ---
# Sitio público (Astro SSR en un servidor Node en docker-compose).
WEB_PORT=8080
# Origen del CRM/API para el contenedor de la web (por defecto el servicio `admin` de compose).
WEB_API_URL=http://admin:3000

# --- apps/admin (iEkklesia) ---
# Backoffice. Better Auth (login + sesiones):
#   BETTER_AUTH_SECRET: secreto >=32 chars (generar con `openssl rand -base64 32`)
#   BETTER_AUTH_URL / NEXT_PUBLIC_BETTER_AUTH_URL: URL base del admin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --- apps/api ---
# Origin of the CRM (browser-facing). The API only accepts mutations coming from it (CSRF).
CRM_ORIGIN=http://localhost:3000
# Google OAuth client (origin http://localhost:3000, redirect http://localhost:3000/api/auth/callback/google).
# Sign-in with Google is disabled while both are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outgoing email. Local: Mailpit (`docker compose up -d mailpit`, UI on http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="El Ancla <no-reply@elancla.local>"

# --- API pública (apps/web) ---
# La web lee la configuración del sitio de /api/public/v1/<SITE_CHURCH_SLUG>/... con una site key.
# Solo servidor: nunca con prefijo PUBLIC_. Sin las tres variables la web usa los valores por defecto
# (SITE_FALLBACK) y no hace ninguna llamada de red.
# Origen del CRM/API en desarrollo local (en compose se usa WEB_API_URL).
API_URL=http://localhost:3000
# Site key `sk_<id>_<secreto>`: se muestra una sola vez al crearla en Configuración > Sitio web del CRM,
# o con `bun run --filter @ancla/api site-key:create -- --name "web local"`.
# Setup local en un paso (crea la key y escribe las tres variables en el .env raíz; `--api-url <origen>`
# cambia el origen, por defecto http://localhost:3000):
#   bun run --filter @ancla/api site-key:create -- --name "web local" --write-env
SITE_API_KEY=
SITE_CHURCH_SLUG=el-ancla
# Opcional: TTL (ms) del caché de la configuración del sitio en la web. Por defecto 60000; los E2E
# lo bajan para ver los cambios de estado al instante.
# SITE_CONFIG_TTL_MS=60000

# --- YouTube (apps/web: /sermones y detección de directo; apps/api: YOUTUBE_API_KEY) ---
# API key de Google Cloud con "YouTube Data API v3" habilitada, y el ID del canal (empieza con UC).
# La API (precarga de sermones, sugerencias, en vivo) lee la misma YOUTUBE_API_KEY; vacía → la
# precarga responde 503 `platform_unavailable` y el en vivo siempre dice "no".
# Sin estas dos variables /sermones muestra el estado vacío y el sitio nunca marca "en vivo".
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Opcional: playlist con solo las prédicas. Vacío → se usan todos los videos subidos del canal.
YOUTUBE_SERMONS_PLAYLIST_ID=

# --- SEO (apps/web) ---
# Search Console / Bing Webmaster verification codes (content of the meta tag). Optional.
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=

# --- Archivos y multimedia (apps/api, core/storage) ---
# Local: SeaweedFS en docker-compose (`docker compose up -d s3 s3-init`), API S3 en http://localhost:9000.
# Producción: Backblaze B2 con una key por bucket (capacidades mínimas) y media.<dominio> en Cloudflare.
# Endpoint que usa la API (desde un contenedor de compose sería http://s3:9000).
S3_ENDPOINT=http://localhost:9000
# Host que ve el navegador para subir (opcional; por defecto S3_ENDPOINT).
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Las subidas entran SIEMPRE al bucket privado (cuarentena); el público solo recibe variantes verificadas.
S3_PRIVATE_BUCKET=ancla-private
S3_PRIVATE_KEY_ID=ancla-private-key
S3_PRIVATE_SECRET=ancla-private-secret
S3_PUBLIC_BUCKET=ancla-public
S3_PUBLIC_KEY_ID=ancla-public-key
S3_PUBLIC_SECRET=ancla-public-secret
# Base pública de las variantes (el CDN en producción).
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/ancla-public
# Bearer del cron de limpieza (GET /api/internal/media/purge). >= 32 caracteres: `openssl rand -base64 32`.
CRON_SECRET=
# Secreto del hash anónimo de visitas del blog (HMAC de día + ip + user agent; nunca se guardan la IP ni el UA).
# >= 32 caracteres: `openssl rand -base64 32`.
VIEW_HASH_SECRET=
