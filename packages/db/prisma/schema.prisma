// @ancla/db — esquema de datos del monorepo (CMS custom + tesorería).
// SCAFFOLD: arranca con el dominio de contenido (lo que hoy sirve @ancla/content
// con datos seed) y stubs de finanzas. Se completa a medida que el CMS custom y
// la tesorería se construyen. el ancla lee contenido; iEkklesia lee/escribe todo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Contenido (custom CMS) ──────────────────────────────────────────────────

model Author {
  id        String   @id @default(cuid())
  name      String
  role      String?
  initials  String?
  bio       String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id     String @id @default(cuid())
  number String?
  name   String
  filter String @unique
  blurb  String?
  posts  Post[]
}

model Series {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  reference   String?
  description String?
  posts       Post[]
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String?
  description String?
  body        Json?
  status      PostStatus @default(DRAFT)
  featured    Boolean    @default(false)
  publishedAt DateTime?
  author      Author?    @relation(fields: [authorId], references: [id])
  authorId    String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  categoryId  String?
  series      Series?    @relation(fields: [seriesId], references: [id])
  seriesId    String?
  seriesOrder Int?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum PostStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

// ─── Tesorería (iEkklesia) — stubs iniciales ────────────────────────────────

model Ministry {
  id             String  @id @default(cuid())
  name           String
  budget         Float   @default(0)
  budgetCurrency String  @default("UYU")
}

model Movement {
  id       String       @id @default(cuid())
  date     DateTime
  concept  String
  type     MovementType
  currency String       @default("UYU")
  amount   Float
  createdAt DateTime    @default(now())
}

enum MovementType {
  INCOME
  EXPENSE
}

// ─── Configuración del sitio (el ancla lee en build; iEkklesia escribe) ───────
// Registro único (singleton, id fijo "singleton"). Los campos traducibles viven
// en SiteSettingsTranslation; el schedule del hero en ServiceTime.

enum Locale {
  ES
  PT
  EN
}

enum SiteStatus {
  ONLINE
  MAINTENANCE
  CLOSED
}

model SiteSettings {
  id        String     @id @default("singleton")
  name      String
  shortName String?
  subtitle  String?
  url       String
  status    SiteStatus @default(ONLINE)

  // Contacto / dirección (consumidos por schema.org)
  contactEmail   String?
  addressStreet  String?
  addressCity    String?
  addressRegion  String?
  addressCountry String?
  addressPostal  String?
  geoLat         Float?
  geoLng         Float?

  // Branding / metadatos
  themeColor          String?
  founded             String?
  serviceTimesSummary String?

  // Redes sociales (set fijo conocido)
  website   String?
  instagram String?
  youtube   String?
  facebook  String?
  twitter   String?
  spotify   String?
  linkedin  String?

  translations SiteSettingsTranslation[]
  serviceTimes ServiceTime[]
  updatedAt    DateTime                  @updatedAt
}

model SiteSettingsTranslation {
  id            String       @id @default(cuid())
  locale        Locale
  aboutRichText Json?
  settings      SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  settingsId    String

  @@unique([settingsId, locale])
}

model ServiceTime {
  id          String       @id @default(cuid())
  locale      Locale
  order       Int          @default(0)
  label       String
  time        String
  description String?
  settings    SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  settingsId  String
}

// ─── Autenticación (Better Auth, adaptador Prisma) ───────────────────────────
// Core schema de Better Auth + campo custom `role` (admin|treasurer|viewer).

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("viewer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
