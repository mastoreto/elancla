// @ancla/db — database schema.
// Conventions (mandatory for every model): docs/implementation/plans/0.1-db-rework.md
//   - PK: UUIDv7 (`@default(uuid(7)) @db.Uuid`).
//   - Domain models carry `organizationId` (tenant) and index by it first.
//   - Money: `Decimal @db.Decimal(19, 4)` + ISO 4217 currency; never Float.
//   - Translatable text lives in `<Model>Translation` tables keyed by (parentId, locale).
//   - Tables are snake_case plural via @@map.
// Feature models are added by their own phase, following these conventions.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique
  name          String
  /// ISO 3166-1 alpha-2.
  country       String   @db.Char(2)
  /// IANA time zone, e.g. America/Montevideo.
  timezone      String
  /// BCP 47 language code used when a translation is missing.
  defaultLocale String
  /// Enabled content locales; always includes defaultLocale.
  locales       String[]
  /// Enabled ISO 4217 currencies.
  currencies    String[]
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  siteSettings      SiteSettings?
  documentSequences DocumentSequence[]
  invitations       Invitation[]
  roles             Role[]
  ministries        Ministry[]

  @@map("organizations")
}

/// Gap-free human codes (MOV-2026-000123). Incremented with UPDATE … RETURNING inside the
/// same transaction as the insert that consumes the number.
model DocumentSequence {
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Document prefix, e.g. "MOV", "OC", "SOL".
  type           String
  year           Int
  last           Int          @default(0)

  @@id([organizationId, type, year])
  @@map("document_sequences")
}

// ─── Public site configuration ───────────────────────────────────────────────

enum SiteStatus {
  ONLINE
  MAINTENANCE
  CLOSED
}

model SiteSettings {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  shortName      String?
  subtitle       String?
  url            String
  status         SiteStatus   @default(ONLINE)

  contactEmail   String?
  addressStreet  String?
  addressCity    String?
  addressRegion  String?
  addressCountry String?
  addressPostal  String?
  geoLat         Float?
  geoLng         Float?

  themeColor          String?
  founded             String?
  /// Temporary until phase 1.6 derives service times from recurring activities.
  serviceTimesSummary String?

  website   String?
  instagram String?
  youtube   String?
  facebook  String?
  twitter   String?
  spotify   String?
  linkedin  String?

  version      Int                       @default(0)
  translations SiteSettingsTranslation[]
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

model SiteSettingsTranslation {
  id             String       @id @default(uuid(7)) @db.Uuid
  siteSettingsId String       @db.Uuid
  siteSettings   SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)
  /// BCP 47 language code.
  locale         String
  aboutRichText  Json?

  @@unique([siteSettingsId, locale])
  @@map("site_settings_translations")
}

// ─── Authentication (Better Auth core schema) ────────────────────────────────
// Authorization lives in the RBAC models below (roles, permissions, ministries).

model User {
  id               String       @id @default(uuid(7)) @db.Uuid
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  /// Better Auth two-factor plugin flag.
  twoFactorEnabled Boolean      @default(false)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  invitationsSent  Invitation[]
  userRoles        UserRole[]
  userMinistries   UserMinistry[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth two-factor plugin table (dist/plugins/two-factor/schema.mjs, v1.7.25).
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Encrypted TOTP secret.
  secret                  String
  /// Encrypted backup codes.
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

/// Better Auth rate limiter storage (core dist/db/get-tables.mjs, v1.7.25).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  /// Milliseconds since epoch.
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Invitations ─────────────────────────────────────────────────────────────

/// Sign-up is invitation-only. Only the SHA-256 of the token is stored.
model Invitation {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Lowercase.
  email          String
  tokenHash      String       @unique
  /// Roles and ministries assigned on acceptance. ponytail: validated when the invitation is
  /// created; on acceptance only the ones that still exist are assigned.
  roleIds        String[]     @default([]) @db.Uuid
  ministryIds    String[]     @default([]) @db.Uuid
  invitedById    String?      @db.Uuid
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime     @db.Timestamptz(3)
  acceptedAt     DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([organizationId, email])
  @@map("invitations")
}

// ─── Authorization (RBAC) ────────────────────────────────────────────────────

/// Minimal ministry (phase 0.4) so the `ministry` scope has something to point at; phase 1.5 extends it.
model Ministry {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  members        UserMinistry[]

  @@unique([organizationId, slug])
  @@map("ministries")
}

/// `key` is set only for seeded roles (`admin` has implicit full access and no permission rows).
model Role {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key               String?
  name              String
  description       String           @default("")
  /// When false, the session cookie is dropped when the browser closes.
  persistentSession Boolean          @default(true)
  /// Longest a session may live; null means the default.
  maxSessionSeconds Int?
  permissions       RolePermission[]
  members           UserRole[]
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, key])
  @@unique([organizationId, name])
  @@map("roles")
}

/// One cell of the grid. Validated against the code catalog (packages/contracts) on write.
model RolePermission {
  roleId   String @db.Uuid
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  action   String
  /// own | ministry | all
  scope    String

  @@id([roleId, resource, action])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserMinistry {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministryId String   @db.Uuid
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@id([userId, ministryId])
  @@index([ministryId])
  @@map("user_ministries")
}
