// @ancla/db — database schema.
// Conventions (mandatory for every model): docs/implementation/plans/0.1-db-rework.md
//   - PK: UUIDv7 (`@default(uuid(7)) @db.Uuid`).
//   - Domain models carry `organizationId` (tenant) and index by it first.
//   - Money: `Decimal @db.Decimal(19, 4)` + ISO 4217 currency; never Float.
//   - Translatable text lives in `<Model>Translation` tables keyed by (parentId, locale).
//   - Tables are snake_case plural via @@map.
// Feature models are added by their own phase, following these conventions.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique
  name          String
  /// ISO 3166-1 alpha-2.
  country       String   @db.Char(2)
  /// IANA time zone, e.g. America/Montevideo.
  timezone      String
  /// BCP 47 language code used when a translation is missing.
  defaultLocale String
  /// Enabled content locales; always includes defaultLocale.
  locales       String[]
  /// Enabled ISO 4217 currencies.
  currencies    String[]
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  siteSettings       SiteSettings?
  documentSequences  DocumentSequence[]
  invitations        Invitation[]
  roles              Role[]
  ministries         Ministry[]
  auditLogs          AuditLog[]
  mediaFiles         MediaFile[]
  siteApiKeys        SiteApiKey[]
  contentRevisions   ContentRevision[]
  editorialSettings  EditorialSettings[]
  personProfiles     PersonProfile[]
  visitFaqs          VisitFaq[]
  simplePages        SimplePage[]
  posts              Post[]
  categories         Category[]
  ministryCategories MinistryCategory[]
  series             Series[]

  @@map("organizations")
}

/// Gap-free human codes (MOV-2026-000123). Incremented with UPDATE … RETURNING inside the
/// same transaction as the insert that consumes the number.
model DocumentSequence {
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Document prefix, e.g. "MOV", "OC", "SOL".
  type           String
  year           Int
  last           Int          @default(0)

  @@id([organizationId, type, year])
  @@map("document_sequences")
}

// ─── Public site configuration ───────────────────────────────────────────────

enum SiteStatus {
  ONLINE
  MAINTENANCE
  CLOSED
}

model SiteSettings {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  shortName      String?
  subtitle       String?
  url            String
  status         SiteStatus   @default(ONLINE)

  contactEmail   String?
  addressStreet  String?
  addressCity    String?
  addressRegion  String?
  addressCountry String?
  addressPostal  String?
  geoLat         Float?
  geoLng         Float?

  themeColor      String?
  founded         String?
  // ponytail: temporary bridge until phase 1.6 derives service times from recurring activities.
  /// List of { kind: "worship" | "bibleSchool", weekday 0-6 (0 = Sunday), start "HH:mm", end "HH:mm" | null }.
  serviceTimes    Json    @default("[]")
  /// Map of section key -> "active" | "maintenance" | "outOfService"; a missing key means active.
  sectionStatuses Json    @default("{}")

  website   String?
  instagram String?
  youtube   String?
  facebook  String?
  twitter   String?
  spotify   String?
  linkedin  String?

  version      Int                       @default(0)
  translations SiteSettingsTranslation[]
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

model SiteSettingsTranslation {
  id                      String       @id @default(uuid(7)) @db.Uuid
  siteSettingsId          String       @db.Uuid
  siteSettings            SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)
  /// BCP 47 language code.
  locale                  String
  /// Default meta description of the public site (max 160 chars, validated by the contracts).
  seoDescription          String?
  /// Visit page directions (max 600 chars each, validated by the contracts).
  directionsParking       String?
  directionsTransit       String?
  directionsAccessibility String?

  @@unique([siteSettingsId, locale])
  @@map("site_settings_translations")
}

// ─── Visit page ──────────────────────────────────────────────────────────────

/// Editable FAQ of /visitanos. The schedule and address questions are generated by the web.
model VisitFaq {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @db.Uuid
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Int
  translations   VisitFaqTranslation[]

  @@index([organizationId, order])
  @@map("visit_faqs")
}

model VisitFaqTranslation {
  id         String   @id @default(uuid(7)) @db.Uuid
  visitFaqId String   @db.Uuid
  visitFaq   VisitFaq @relation(fields: [visitFaqId], references: [id], onDelete: Cascade)
  locale     String
  /// Max 200 chars (validated by the contracts).
  question   String
  /// Max 1000 chars (validated by the contracts).
  answer     String

  @@unique([visitFaqId, locale])
  @@map("visit_faq_translations")
}

// ─── Simple pages ────────────────────────────────────────────────────────────

/// A page at the site root (/privacidad). Only the identity lives here: title, slug and body are
/// in the snapshot of its ContentRevision (editorial workflow), so there is no translation table.
model SimplePage {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@map("simple_pages")
}

// ─── Blog ────────────────────────────────────────────────────────────────────

/// A blog post. Only the identity and what cannot change with revisions live here: title, slug,
/// body, author, category, series and cover are in the snapshot of its ContentRevision (editorial
/// workflow), so there is no translation table. Posts are never deleted, only paused.
model Post {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  /// Date of the post URL: set the first time the post goes live and fixed once it is visible.
  firstLiveAt    DateTime?         @db.Timestamptz(3)
  viewsDaily     PostViewDaily[]
  viewVisitors   PostViewVisitor[]

  @@index([organizationId])
  @@map("posts")
}

model Category {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @db.Uuid
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Int                   @default(0)
  /// Optimistic lock (409 stale_version).
  version        Int                   @default(1)
  /// Logical delete; slug uniqueness is checked in the use case so deleted rows never block it.
  deletedAt      DateTime?             @db.Timestamptz(3)
  translations   CategoryTranslation[]
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  @@index([organizationId])
  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(uuid(7)) @db.Uuid
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  /// Max 60 chars (validated by the contracts).
  name       String
  slug       String

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Series {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Optimistic lock (409 stale_version).
  version        Int                 @default(1)
  /// Logical delete; slug uniqueness is checked in the use case so deleted rows never block it.
  deletedAt      DateTime?           @db.Timestamptz(3)
  translations   SeriesTranslation[]
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  @@index([organizationId])
  @@map("series")
}

model SeriesTranslation {
  id          String  @id @default(uuid(7)) @db.Uuid
  seriesId    String  @db.Uuid
  series      Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  locale      String
  /// Max 80 chars (validated by the contracts).
  name        String
  slug        String
  /// Max 300 chars (validated by the contracts).
  description String?

  @@unique([seriesId, locale])
  @@map("series_translations")
}

/// Daily view counter per post. No visitor data: only the count.
model PostViewDaily {
  postId String   @db.Uuid
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Calendar day in the organization time zone.
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([postId, day])
  @@map("post_views_daily")
}

/// Anonymous dedupe marker: HMAC(day + ip + user agent). Neither IP nor user agent is stored, and
/// rows of past days are purged.
model PostViewVisitor {
  postId      String   @db.Uuid
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  visitorHash String

  @@id([postId, day, visitorHash])
  @@map("post_view_visitors")
}

// ─── People (public profiles) ────────────────────────────────────────────────

/// Where a public profile is shown. BLOG_AUTHOR, PREACHER and MINISTRY_LEADER are used by phases
/// 1.4, 1.7 and 1.5; they exist now so "visible in one context, hidden in another" is testable.
enum PersonContext {
  TEAM
  BLOG_AUTHOR
  PREACHER
  MINISTRY_LEADER
}

model PersonProfile {
  id             String                     @id @default(uuid(7)) @db.Uuid
  organizationId String                     @db.Uuid
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Max 120 chars (validated by the contracts).
  name           String
  photoId        String?                    @db.Uuid
  photo          MediaFile?                 @relation(fields: [photoId], references: [id], onDelete: SetNull)
  userId         String?                    @db.Uuid
  user           User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  translations   PersonProfileTranslation[]
  roles          PersonRole[]
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, userId])
  @@index([organizationId, name])
  @@map("person_profiles")
}

model PersonProfileTranslation {
  id              String        @id @default(uuid(7)) @db.Uuid
  personProfileId String        @db.Uuid
  personProfile   PersonProfile @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  locale          String
  /// Max 600 chars (validated by the contracts).
  bio             String?

  @@unique([personProfileId, locale])
  @@map("person_profile_translations")
}

model PersonRole {
  id              String                  @id @default(uuid(7)) @db.Uuid
  personProfileId String                  @db.Uuid
  personProfile   PersonProfile           @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  context         PersonContext
  visible         Boolean                 @default(true)
  order           Int                     @default(0)
  translations    PersonRoleTranslation[]
  /// Set only for MINISTRY_LEADER (CHECK in the migration); one role per person per ministry.
  ministryId      String?                 @db.Uuid
  ministry        Ministry?               @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([personProfileId, context, ministryId])
  @@map("person_roles")
}

model PersonRoleTranslation {
  id           String     @id @default(uuid(7)) @db.Uuid
  personRoleId String     @db.Uuid
  personRole   PersonRole @relation(fields: [personRoleId], references: [id], onDelete: Cascade)
  locale       String
  /// Max 80 chars (validated by the contracts).
  title        String
  /// Free-form author stats `[{ label, value }]`, max 4 (validated by the contracts).
  stats        Json       @default("[]")

  @@unique([personRoleId, locale])
  @@map("person_role_translations")
}

// ─── Authentication (Better Auth core schema) ────────────────────────────────
// Authorization lives in the RBAC models below (roles, permissions, ministries).

model User {
  id                 String            @id @default(uuid(7)) @db.Uuid
  name               String
  email              String            @unique
  emailVerified      Boolean           @default(false)
  image              String?
  /// Better Auth two-factor plugin flag.
  twoFactorEnabled   Boolean           @default(false)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  invitationsSent    Invitation[]
  siteApiKeysCreated SiteApiKey[]
  userRoles          UserRole[]
  userMinistries     UserMinistry[]
  mediaFiles         MediaFile[]
  authoredRevisions  ContentRevision[] @relation("RevisionAuthor")
  reviewedRevisions  ContentRevision[] @relation("RevisionReviewer")
  personProfiles     PersonProfile[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth two-factor plugin table (dist/plugins/two-factor/schema.mjs, v1.7.25).
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Encrypted TOTP secret.
  secret                  String
  /// Encrypted backup codes.
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

/// Better Auth rate limiter storage (core dist/db/get-tables.mjs, v1.7.25).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  /// Milliseconds since epoch.
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Invitations ─────────────────────────────────────────────────────────────

/// Sign-up is invitation-only. Only the SHA-256 of the token is stored.
model Invitation {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Lowercase.
  email          String
  tokenHash      String       @unique
  /// Roles and ministries assigned on acceptance. ponytail: validated when the invitation is
  /// created; on acceptance only the ones that still exist are assigned.
  roleIds        String[]     @default([]) @db.Uuid
  ministryIds    String[]     @default([]) @db.Uuid
  invitedById    String?      @db.Uuid
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime     @db.Timestamptz(3)
  acceptedAt     DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([organizationId, email])
  @@map("invitations")
}

// ─── Authorization (RBAC) ────────────────────────────────────────────────────

/// Minimal ministry (phase 0.4) so the `ministry` scope has something to point at; phase 1.5 extends it.
model Ministry {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Internal name (users, invitations, treasury); the public name lives in the profile snapshot.
  name           String
  slug           String
  /// Optimistic lock for the settings (409 stale_version).
  version        Int                 @default(1)
  categoryId     String?             @db.Uuid
  category       MinistryCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  destination    MinistryDestination @default(PAGE)
  /// https URL, required when `destination` is EXTERNAL.
  externalUrl    String?
  /// One of MINISTRY_ICONS (validated by the contracts).
  icon           String?
  /// One of MINISTRY_COLORS (validated by the contracts).
  color          String              @default("secondary-700")
  showOnLanding  Boolean             @default(false)
  landingOrder   Int                 @default(0)
  landingTile    MinistryLandingTile @default(COLOR)
  /// One of LANDING_TONES (validated by the contracts).
  landingTone    String              @default("mist")
  landingPhotoId String?             @db.Uuid
  landingPhoto   MediaFile?          @relation("MinistryLandingPhoto", fields: [landingPhotoId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  members        UserMinistry[]
  leaders        PersonRole[]

  @@unique([organizationId, slug])
  @@map("ministries")
}

enum MinistryDestination {
  PAGE
  EXTERNAL
  NONE
}

enum MinistryLandingTile {
  COLOR
  PHOTO
}

model MinistryCategory {
  id             String                        @id @default(uuid(7)) @db.Uuid
  organizationId String                        @db.Uuid
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Int                           @default(0)
  /// Optimistic lock (409 stale_version).
  version        Int                           @default(1)
  deletedAt      DateTime?                     @db.Timestamptz(3)
  translations   MinistryCategoryTranslation[]
  ministries     Ministry[]
  createdAt      DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                      @updatedAt @db.Timestamptz(3)

  @@index([organizationId])
  @@map("ministry_categories")
}

model MinistryCategoryTranslation {
  id         String           @id @default(uuid(7)) @db.Uuid
  categoryId String           @db.Uuid
  category   MinistryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  /// Max 60 chars (validated by the contracts).
  name       String

  @@unique([categoryId, locale])
  @@map("ministry_category_translations")
}

/// `key` is set only for seeded roles (`admin` has implicit full access and no permission rows).
model Role {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key               String?
  name              String
  description       String           @default("")
  /// When false, the session cookie is dropped when the browser closes.
  persistentSession Boolean          @default(true)
  /// Longest a session may live; null means the default.
  maxSessionSeconds Int?
  permissions       RolePermission[]
  members           UserRole[]
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, key])
  @@unique([organizationId, name])
  @@map("roles")
}

/// One cell of the grid. Validated against the code catalog (packages/contracts) on write.
model RolePermission {
  roleId   String @db.Uuid
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  action   String
  /// own | ministry | all
  scope    String

  @@id([roleId, resource, action])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserMinistry {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministryId String   @db.Uuid
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@id([userId, ministryId])
  @@index([ministryId])
  @@map("user_ministries")
}

enum AuditOutcome {
  success
  denied
  failure
}

/// Append-only: `app_runtime` can only INSERT and SELECT (see the audit_log migration).
/// `actorId` has no FK on purpose: the record outlives the user and test cleanup keeps working.
/// `organizationId` is `Restrict`: a cascade would let an organization delete erase its log.
model AuditLog {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  actorId        String?      @db.Uuid
  /// Email (or "cli") at the time of the event.
  actorLabel     String?
  action         String
  entityType     String?
  entityId       String?
  before         Json?
  after          Json?
  reason         String?
  outcome        AuditOutcome @default(success)
  ip             String?
  userAgent      String?
  requestId      String?
  metadata       Json?

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId])
  @@map("audit_logs")
}

// ─── Files and media ─────────────────────────────────────────────────────────

/// Decides the bucket, the allowed types and the permissions (see MEDIA_PURPOSES in contracts).
enum MediaPurpose {
  contentImage
  voucherDocument
}

enum MediaFileStatus {
  pending
  ready
}

/// Named `MediaFile` (not `File`): the generated type would shadow the global DOM/Node `File`.
/// The bucket is not stored: it is derived from the purpose. Every upload lands first in the
/// private bucket under `key`; `variants` hold the public keys generated by `finalize`.
model MediaFile {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @db.Uuid
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purpose          MediaPurpose
  status           MediaFileStatus @default(pending)
  /// Key of the original in the private bucket: `<organizationId>/<id>`.
  key              String          @unique
  contentType      String
  /// Declared at request time; the real size once `ready`.
  size             Int
  /// SHA-256 hex of the original, set by `finalize`.
  checksum         String?
  /// Sanitized, at most 200 characters.
  originalName     String
  /// `[{ width, height, format, key, size }]`, set by `finalize` for public images.
  variants         Json?
  uploadedById     String?         @db.Uuid
  uploadedBy       User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  finalizedAt      DateTime?       @db.Timestamptz(3)
  personProfiles   PersonProfile[]
  ministryLandings Ministry[]      @relation("MinistryLandingPhoto")

  @@index([organizationId, status, createdAt])
  @@map("media_files")
}

/// Read-only credential the public site uses against `/api/public/v1`. The secret is shown once
/// at creation; only its SHA-256 is stored. Revoked keys are kept (soft revoke) so they stay audited.
model SiteApiKey {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  secretHash     String
  createdById    String?      @db.Uuid
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)

  @@index([organizationId, revokedAt])
  @@map("site_api_keys")
}

// ─── Editorial workflow ──────────────────────────────────────────────────────

/// Each content type that goes through the workflow adds a value (with its migration).
enum EditorialContentType {
  BLOG_POST
  MINISTRY
  SIMPLE_PAGE
}

/// SUPERSEDED is internal: the live revision that a newer one replaced. History is never deleted.
enum EditorialState {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  PAUSED
  SUPERSEDED
}

/// The revisions are the content: the draft snapshot lives here and the "published" version of an
/// entity is its PUBLISHED/PAUSED revision. Partial unique indexes (see the migration) allow at
/// most one working and one live revision per entity. Rows are never deleted by `app_runtime`.
model ContentRevision {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @db.Uuid
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contentType    EditorialContentType
  /// Not a FK: the entity tables arrive with the phases that adopt the workflow.
  entityId       String               @db.Uuid
  number         Int
  state          EditorialState
  snapshot       Json
  authorId       String               @db.Uuid
  author         User                 @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewerId     String?              @db.Uuid
  reviewer       User?                @relation("RevisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  comment        String?
  submittedAt    DateTime?            @db.Timestamptz(3)
  decidedAt      DateTime?            @db.Timestamptz(3)
  publishedAt    DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, contentType, entityId, number])
  @@index([organizationId, state])
  @@map("content_revisions")
}

/// Who reviews, and who must be reviewed, per content type. The id arrays are not FKs: an id of a
/// deleted role or user simply stops matching and is filtered out when read.
/// ponytail: arrays, not join tables; move to FKs if stale ids ever matter.
model EditorialSettings {
  id                     String               @id @default(uuid(7)) @db.Uuid
  organizationId         String               @db.Uuid
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentType            EditorialContentType
  reviewerRoleIds        String[]             @default([]) @db.Uuid
  reviewerUserIds        String[]             @default([]) @db.Uuid
  mandatoryReviewRoleIds String[]             @default([]) @db.Uuid
  mandatoryReviewUserIds String[]             @default([]) @db.Uuid
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, contentType])
  @@map("editorial_settings")
}
