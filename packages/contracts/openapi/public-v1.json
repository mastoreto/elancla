{
  "openapi": "3.1.0",
  "info": {
    "title": "El Ancla public API",
    "version": "1.0.0",
    "description": "Read-only content for church sites. Every request carries `Authorization: Bearer sk_<keyId>_<secret>` (a site key) and the church slug in the path."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/{churchSlug}/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "The site settings of a church, in the requested language.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "churchSlug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            },
            "required": false,
            "name": "locale",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The site settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "locale": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "shortName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "subtitle": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "url": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "online",
                        "maintenance",
                        "closed"
                      ]
                    },
                    "contactEmail": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "address": {
                      "type": "object",
                      "properties": {
                        "street": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "city": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "region": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "country": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "postalCode": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "street",
                        "city",
                        "region",
                        "country",
                        "postalCode"
                      ],
                      "additionalProperties": false
                    },
                    "geo": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "latitude": {
                          "type": "number"
                        },
                        "longitude": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "latitude",
                        "longitude"
                      ],
                      "additionalProperties": false
                    },
                    "themeColor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "founded": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "serviceTimes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "worship",
                              "bibleSchool"
                            ]
                          },
                          "weekday": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 6
                          },
                          "start": {
                            "type": "string",
                            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                          },
                          "end": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                          }
                        },
                        "required": [
                          "kind",
                          "weekday",
                          "start",
                          "end"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "sections": {
                      "type": "object",
                      "properties": {
                        "blog": {
                          "type": "string",
                          "enum": [
                            "active",
                            "maintenance",
                            "outOfService"
                          ]
                        },
                        "calendar": {
                          "type": "string",
                          "enum": [
                            "active",
                            "maintenance",
                            "outOfService"
                          ]
                        },
                        "sermons": {
                          "type": "string",
                          "enum": [
                            "active",
                            "maintenance",
                            "outOfService"
                          ]
                        },
                        "ministries": {
                          "type": "string",
                          "enum": [
                            "active",
                            "maintenance",
                            "outOfService"
                          ]
                        },
                        "visit": {
                          "type": "string",
                          "enum": [
                            "active",
                            "maintenance",
                            "outOfService"
                          ]
                        }
                      },
                      "required": [
                        "blog",
                        "calendar",
                        "sermons",
                        "ministries",
                        "visit"
                      ],
                      "additionalProperties": false
                    },
                    "seoDescription": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "social": {
                      "type": "object",
                      "properties": {
                        "website": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "instagram": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "youtube": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "facebook": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "twitter": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "spotify": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "linkedin": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "website",
                        "instagram",
                        "youtube",
                        "facebook",
                        "twitter",
                        "spotify",
                        "linkedin"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "locale",
                    "name",
                    "shortName",
                    "subtitle",
                    "url",
                    "status",
                    "contactEmail",
                    "address",
                    "geo",
                    "themeColor",
                    "founded",
                    "serviceTimes",
                    "sections",
                    "seoDescription",
                    "social"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The locale is not valid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "requestId"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "The site key is missing, invalid or not for this church",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "requestId"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The church has no site settings",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "requestId"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
