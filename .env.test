# Variables for tests and E2E (versioned on purpose: only non-secret test values).
# Loaded by the test preloads and by Playwright; never used by dev or production.
APP_ENV=test

# Ephemeral database (docker compose --profile test, service db-test, host port 5434).
DATABASE_URL=postgresql://app_runtime:ancla_runtime@localhost:5434/ancla
DATABASE_MIGRATION_URL=postgresql://app_migrator:ancla_migrator@localhost:5434/ancla

# Auth. The CRM runs on 3100 during E2E so it never collides with a dev server on 3000.
BETTER_AUTH_SECRET=test-only-secret-0123456789abcdef-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3100
CRM_ORIGIN=http://localhost:3100

# Mail (Mailpit) and storage (local S3), same services as development.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="El Ancla <no-reply@elancla.local>"
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PRIVATE_BUCKET=ancla-private
S3_PRIVATE_KEY_ID=ancla-private-key
S3_PRIVATE_SECRET=ancla-private-secret
S3_PUBLIC_BUCKET=ancla-public
S3_PUBLIC_KEY_ID=ancla-public-key
S3_PUBLIC_SECRET=ancla-public-secret
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/ancla-public
CRON_SECRET=test-only-cron-secret-0123456789abcdef-0123456789
VIEW_HASH_SECRET=test-only-view-hash-secret-0123456789abcdef-0123456789

# Public web served by Playwright (apps/web build on 4398) reads the CRM/API through a fixed site key.
# Not a secret: the e2e seed (seed:e2e) registers exactly this key in the test database.
API_URL=http://localhost:3100
SITE_API_KEY=sk_01900000-0000-7000-8000-00000000e2e1_e2eTestSiteKeySecretNotARealSecret_01234567
SITE_CHURCH_SLUG=el-ancla
# Short cache so a status change in the CRM reaches the web within a second.
SITE_CONFIG_TTL_MS=500
