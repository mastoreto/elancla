# syntax=docker/dockerfile:1
# Sitio público "el ancla" (apps/web, Astro SSR) en un servidor Node.
# Build con Bun desde el monorepo → dist/ → imagen Node.

# ─── Base ────────────────────────────────────────────────────────────────────
FROM oven/bun:1.2.4-debian AS base
WORKDIR /app

# ─── deps: dependencias del workspace (capa cacheable) ───────────────────────
FROM base AS deps
COPY package.json bun.lock turbo.json ./
COPY apps/crm/package.json apps/crm/
COPY apps/web/package.json apps/web/
COPY packages/emails/package.json packages/emails/
COPY apps/api/package.json apps/api/
COPY packages/db/package.json packages/db/
COPY packages/contracts/package.json packages/contracts/
COPY packages/content/package.json packages/content/
COPY packages/env/package.json packages/env/
COPY packages/utils/package.json packages/utils/
COPY packages/biome-config/package.json packages/biome-config/
COPY packages/typescript-config/package.json packages/typescript-config/
RUN bun install --frozen-lockfile

# ─── builder: compila el sitio ───────────────────────────────────────────────
FROM base AS builder
# La web no usa la BD ni Prisma: lee la config de la API pública en runtime
# (API_URL, SITE_API_KEY, SITE_CHURCH_SLUG); sin ellas usa los valores de fallback.
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN bun run --filter web build

# ─── runner: servidor Node de Astro (SSR, adapter standalone) ─────────────────
# Node, no nginx: la config del sitio se pide a la API pública en runtime.
FROM node:22-alpine AS runner
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321
WORKDIR /app/apps/web
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/apps/web/node_modules ./node_modules
COPY --from=builder /app/apps/web/dist ./dist
EXPOSE 4321
CMD ["node", "dist/server/entry.mjs"]
