---
import cn from '../utils/cn.ts';

const styles = {
  section: cn('relative py-24 md:py-36'),
  container: cn('mx-auto max-w-[1600px] px-6 md:px-10'),
  sectionHeader: cn('flex items-baseline gap-6 mb-14 md:mb-20'),
  headerLine: cn('flex-1 h-px bg-ink/15'),
  grid: cn('grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start'),
  colLeft: cn('lg:col-span-5 reveal'),
  headline: cn('font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] tracking-tight'),
  lead: cn('mt-8 font-ui text-[16px] md:text-[17px] leading-relaxed text-ink/70 max-w-md'),
  infoStack: cn('mt-12 space-y-6 font-ui'),
  infoLabel: cn('font-ui text-[10px] tracking-[0.25em] uppercase text-ink/50 mb-2'),
  infoValue: cn('text-lg'),
  infoSub: cn('text-sm text-ink/60'),
  socialList: cn('flex flex-col gap-3'),
  socialLink: cn('flex items-center gap-3 text-[15px] ulink w-fit'),
  socialIcon: cn('w-9 h-9 rounded-full bg-ink/5 flex items-center justify-center'),
  colRight: cn('lg:col-span-7 reveal reveal-delay-2'),
  mapWrap: cn('relative'),
  map: cn('w-full h-[480px] md:h-[560px] grayscale'),
};

const socials = [
  {
    label: '@iglesiaelanclauy',
    href: '#',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814M9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
  {
    label: '@iglesiaelancla',
    href: '#',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.849.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849s-.012 3.584-.069 4.849c-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.849.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`,
  },
  {
    label: '@iglesiabautistaelancla',
    href: '#',
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
];
---

<!-- CONTACT -->
<section id="visitanos" class={styles.section}>
  <div class={styles.container}>
    <div class={styles.sectionHeader}>
      <span class="section-counter">[ 05 — Visítanos ]</span>
      <span class={styles.headerLine}></span>
    </div>

    <div class={styles.grid}>
      <!-- info -->
      <div class={styles.colLeft}>
        <h2 class={styles.headline}>
          Te esperamos <em class="italic text-primary">el domingo.</em>
        </h2>
        <p class={styles.lead}>
          Si necesitas más información puedes contactarnos por nuestras
          redes sociales. Nos encanta recibir visitas.
        </p>

        <div class={styles.infoStack}>
          <div>
            <div class={styles.infoLabel}>Dirección</div>
            <div class={styles.infoValue}>Av. Dr. Luis A. de Herrera 3101</div>
            <div class={styles.infoSub}>Esq. Juan Arrieta · Montevideo, Uruguay</div>
          </div>
          <div>
            <div class={styles.infoLabel}>Horarios</div>
            <div class={styles.infoValue}>Dom 10:00 · 11:15 — Mié 19:00</div>
          </div>
          <div>
            <div class={styles.infoLabel}>Redes</div>
            <div class={styles.socialList}>
              {socials.map((s) => (
                <a href={s.href} class={styles.socialLink}>
                  <span class={styles.socialIcon} set:html={s.icon}></span>
                  {s.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- mapa -->
      <div class={styles.colRight}>
        <div class={styles.mapWrap}>
          <div class="corner tl"></div>
          <div class="corner tr"></div>
          <div class="corner bl"></div>
          <div class="corner br"></div>
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3273.3336069700877!2d-56.1614292!3d-34.872968199999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x959f80619e924ca9%3A0xb604f8c13a196671!2sIglesia%20Bautista%20El%20Ancla!5e0!3m2!1ses-419!2suy!4v1740605934485!5m2!1ses-419!2suy"
            class={styles.map}
            style="border:0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
