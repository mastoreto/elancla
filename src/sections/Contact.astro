---
import { Icon } from 'astro-icon/components';
import cn from '../utils/cn.ts';

const classes = {
  section: cn(
    'flex flex-col xl:flex-row w-screen h-auto',
    'px-5 sm:px-8 md:px-16 xl:px-[10rem]',
    'py-16 md:py-20 xl:py-16',
    'mt-12 md:mt-16 xl:mt-10'
  ),
  title: cn('text-6xl sm:text-7xl font-barastika leading-tight'),
  paragraph: cn('text-lg sm:text-xl md:text-2xl font-montserrat mt-4 md:mt-6'),
  visitus: cn('flex flex-col justify-center w-full xl:w-1/2'),
  maps: cn('w-full xl:w-1/2 mt-10 xl:mt-0'),
  map: cn(
    'rounded-xl mx-auto',
    'h-64 sm:h-80 md:h-96 xl:h-[28rem] w-full xl:w-[90%]'
  ),
  ul: cn(
    'text-primary-800 font-bold flex flex-col sm:flex-row gap-3 sm:gap-6',
    'font-montserrat mt-6'
  ),
};
---

<section class={classes.section} id="visitanos">
  <div class={classes.visitus}>
    <h2 class={classes.title}>Visitanos</h2>
    <p class={classes.paragraph}>
      Si necesitas más información puedes contactarnos por nuestras redes
      sociales.
    </p>
    <ul class={classes.ul}>
      <li class="flex flex-row items-center gap-2 text-primary-800 text-lg sm:text-xl">
        <Icon name="mdi:youtube" class="text-3xl shrink-0" />
        @iglesiaelanclauy
      </li>
      <li class="flex flex-row items-center gap-2 text-primary-800 text-lg sm:text-xl">
        <Icon name="mdi:instagram" class="text-3xl shrink-0" />
        @iglesiaelancla
      </li>
    </ul>
  </div>
  <div class={classes.maps}>
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3273.3336069700877!2d-56.1614292!3d-34.872968199999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x959f80619e924ca9%3A0xb604f8c13a196671!2sIglesia%20Bautista%20El%20Ancla!5e0!3m2!1ses-419!2suy!4v1740605934485!5m2!1ses-419!2suy"
      width="600"
      height="300"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      class={classes.map}
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</section>
