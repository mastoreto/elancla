---
import Card from '../components/Card.astro';
import cn from '../utils/cn.ts';

import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const classes = {
    section: cn(
        'flex flex-col mt-[25rem]',
    ),
    title: cn(
        'font-barastika text-primary-500 text-4xl',
        'md:text-[5rem] font-bold my-5 mx-8 md:mx-24'
    )
}


const {size} = Astro.props;
---
<section class={`${size} ${classes.section}`} id="sermones">
    <h2 class={classes.title}>Sermones</h2>
    <div class="swiper">
        <div class="swiper-wrapper">
            <Card swiper="swipper-slide"/>
            <Card swiper="swipper-slide"/>
            <Card swiper="swipper-slide"/>
            <Card swiper="swipper-slide"/>
            <Card swiper="swipper-slide"/>
        </div>
        <div class="swiper-scrollbar"></div>
    </div>
</section>
<style>
    .swiper {
        width: 100%;
        height: 100%;
    }
</style>
<script type="module" is:inline>
import Swiper from '';
const swiper = new Swiper('.swiper', {
      // Optional parameters
      direction: 'vertical',
      loop: true,
    
      // And if we need scrollbar
      scrollbar: {
        el: '.swiper-scrollbar',
      },
    });
</script>