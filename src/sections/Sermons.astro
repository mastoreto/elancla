---
import Card from '../components/Card.astro';
import cn from '../utils/cn.ts';

const classes = {
  section: cn('flex flex-col mt-20 md:mt-28 xl:mt-32 fade-sermons'),
  title: cn(
    'font-barastika text-primary-500 font-bold',
    'text-5xl sm:text-6xl md:text-[4.5rem] xl:text-[5rem]',
    'my-5 mx-6 sm:mx-10 md:mx-20 xl:mx-24',
    'leading-tight'
  ),
};
---

<section class={classes.section} id="sermones">
  <h2 class={classes.title}>Sermones</h2>
  <div class="swiper sermon-swiper mt-5">
    <div class="swiper-wrapper">
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
      <div class="swiper-slide"><Card /></div>
    </div>
  </div>
</section>
<style>
  .swiper {
    width: 100%;
    height: 100%;
    padding: 0 0 0 6rem;

    @media screen and (min-width: 1280px) {
      padding: 0 0 0 13rem;
    }
    @media screen and (max-width: 1023px) {
      padding: 0 0 0 2rem;
    }
    @media screen and (max-width: 639px) {
      padding: 0 0 0 1rem;
    }
  }
  .swiper-wrapper {
    padding: 4rem 0;
  }
</style>
<script>
  import Swiper from 'swiper/bundle';
  import 'swiper/css/bundle';

  const swiper = new Swiper('.sermon-swiper', {
    direction: 'horizontal',
    slidesPerView: 3,
    spaceBetween: 12,
    loop: true,
    autoplay: {
      delay: 7500,
    },
    breakpoints: {
      1440: {
        slidesPerView: 3,
        spaceBetween: 12,
      },
      1280: {
        slidesPerView: 3,
        spaceBetween: 8,
      },
      1024: {
        slidesPerView: 2,
        spaceBetween: 8,
      },
      768: {
        slidesPerView: 2,
        spaceBetween: 6,
      },
      480: {
        slidesPerView: 1.2,
        spaceBetween: 8,
      },
      0: {
        slidesPerView: 1,
        spaceBetween: 8,
      },
    },
  });
</script>
