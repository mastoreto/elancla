---
import Card from '../components/Card.astro';
import cn from '../utils/cn.ts';

const classes = {
  section: cn('flex flex-col mt-[10rem] fade-sermons'),
  title: cn(
    'font-barastika text-primary-500 text-6xl md:text-4xl',
    'md:text-[5rem] font-bold my-5 mx-8 md:mx-24'
  ),
};
---

<section class={classes.section} id="sermones">
  <h2 class={classes.title}>Sermones</h2>
  <div class="swiper sermon-swiper mt-5">
    <div class="swiper-wrapper">
      <div class="swiper-slide">
        <Card />
      </div>
      <div class="swiper-slide">
        <Card />
      </div>

      <div class="swiper-slide">
        <Card />
      </div>

      <div class="swiper-slide">
        <Card />
      </div>

      <div class="swiper-slide">
        <Card />
      </div>

      <div class="swiper-slide">
        <Card />
      </div>
      <div class="swiper-slide">
        <Card />
      </div>
      <div class="swiper-slide">
        <Card />
      </div>
      <div class="swiper-slide">
        <Card />
      </div>
    </div>
  </div>
</section>
<style>
  .swiper {
    width: 100%;
    height: 100%;
    padding: 0 0 0 13rem;

    @media screen and (max-width: 1024px) {
      padding: 0 0 0 2rem;
    }
    @media screen and (max-width: 768px) {
      padding: 0 0 0 1.4rem;
    }
  }
  .swiper-wrapper {
    padding: 5rem 0;
  }
</style>
<script>
  import Swiper from 'swiper/bundle';
  import 'swiper/css/bundle';

  const swiper = new Swiper('.sermon-swiper', {
    direction: 'horizontal',
    slidesPerView: 3,
    spaceBetween: 3,
    loop: true,
    autoplay: {
      delay: 7500,
    },
    breakpoints: {
      1440: {
        slidesPerView: 3,
        spaceBetween: 3,
      },
      1360: {
        slidesPerView: 2,
        spaceBetween: 5,
      },
      1024: {
        slidesPerView: 2,
        spaceBetween: 8,
      },
      768: {
        slidesPerView: 2,
        spaceBetween: 3,
      },
      320: {
        slidesPerView: 1,
        spaceBetween: 5,
      },
    },
  });
</script>
