---
import cn from '../utils/cn.ts';

const styles = {
  section: cn('relative py-24 md:py-36 invert-block'),
  container: cn('mx-auto max-w-[1600px] px-6 md:px-10'),
  sectionHeader: cn('flex items-baseline gap-6 mb-14 md:mb-20'),
  headerLine: cn('flex-1 h-px'),
  introGrid: cn('grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 mb-14 md:mb-20'),
  colLeft: cn('lg:col-span-7 reveal'),
  headline: cn('font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] tracking-tight'),
  colRight: cn('lg:col-span-5 flex items-end reveal reveal-delay-2'),
  lead: cn('font-ui text-[15px] md:text-[16px] leading-relaxed opacity-75'),
  grid: cn('grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-0 border-t border-l'),
  cell: cn(
    'mini-cell group relative flex flex-col justify-between',
    'p-6 md:p-7 border-r border-b min-h-[180px] md:min-h-[200px]'
  ),
  cellTop: cn('flex items-start justify-between'),
  cellNum: cn('mini-num font-ui text-[11px] tracking-[0.22em] uppercase opacity-50 transition-colors'),
  cellTitle: cn('font-display text-2xl md:text-[1.7rem] leading-tight'),
  cellDesc: cn('font-ui text-[12.5px] opacity-55 mt-1.5'),
};

const ministerios = [
  { nom: 'Predicación', desc: 'La Palabra, expuesta fielmente', href: '/ministerios/predicacion' },
  { nom: 'Enseñanza', desc: 'Crecer en entendimiento', href: '/ministerios/ensenanza' },
  { nom: 'Misiones', desc: 'Al fin del mundo', href: '/ministerios/misiones' },
  { nom: 'Alabanza', desc: 'Cantar con entendimiento', href: '/ministerios/alabanza' },
  { nom: 'Oración', desc: 'Clamar juntos', href: '/#visitanos' },
  { nom: 'Espacio Mujer', desc: 'Mujeres en la Palabra', href: 'https://emujer.elancla.uy/' },
  { nom: 'Hombres', desc: 'Discipulado entre varones', href: '/ministerios/hombres' },
  { nom: 'Jóvenes', desc: 'Una generación para Cristo', href: '/ministerios/jovenes' },
  { nom: 'Adolescentes', desc: 'Raíces en la adolescencia', href: '/ministerios/adolescentes' },
  { nom: 'Servicio', desc: 'Manos que cuidan', href: '/ministerios/servicio' },
  { nom: 'Multimedia', desc: 'Contar la historia', href: '/ministerios/multimedia' },
];

const borderColor = 'rgba(245,243,238,0.12)';
---

<!-- MINISTERIOS -->
<section id="ministerios" class={styles.section}>
  <div class={styles.container}>
    <div class={styles.sectionHeader}>
      <span class="section-counter" style="color: rgba(245,243,238,0.5)">[ 04 — Ministerios ]</span>
      <span class={styles.headerLine} style={`background: ${borderColor}`}></span>
    </div>

    <div class={styles.introGrid}>
      <div class={styles.colLeft}>
        <h2 class={styles.headline}>
          Diez maneras de servir <em class="italic text-primary">juntos.</em>
        </h2>
      </div>
      <div class={styles.colRight}>
        <p class={styles.lead}>
          Cada ministerio es una invitación: un lugar para crecer, usar tus
          dones, y servir a otros en nombre de Cristo. Encuentra el tuyo.
        </p>
      </div>
    </div>

    <div class={styles.grid} style={`border-color: ${borderColor}`}>
      {ministerios.map((m, i) => (
        <a
          href={m.href}
          class={styles.cell}
          target={m.href.startsWith('http') ? '_blank' : undefined}
          rel={m.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          style={`border-color: ${borderColor}`}
        >
          <div class={styles.cellTop}>
            <span class={styles.cellNum}>{String(i + 1).padStart(2, '0')}</span>
            <svg class="mini-arrow" width="14" height="14" viewBox="0 0 12 12" fill="none">
              <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <div class={styles.cellTitle}>{m.nom}</div>
            <div class={styles.cellDesc}>{m.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
