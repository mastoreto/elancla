---
import cn from '../utils/cn.ts';
import ministries from '../utils/ministriesData.json';

const classes = {
  section: cn(
    'w-screen min-h-screen',
    'px-5 sm:px-10 md:px-16 xl:px-[12rem] 2xl:px-[25rem]',
    'py-16 md:py-20'
  ),
  title: cn('mcard-text text-6xl sm:text-7xl font-barastika text-center'),
  ministries: cn('grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 mt-16 md:mt-24'),
  card: cn(
    'mcard flex items-center justify-between bg-secondary-100 hover:cursor-pointer',
    'p-4 sm:p-5 rounded-xl',
    'font-montserrat',
    'transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-md active:scale-[0.99]'
  ),
};
---

<section class={classes.section} id="ministerios">
  <h2 class={classes.title}>Ministerios</h2>
  <div class={classes.ministries}>
    {
      ministries.map((ministry) => (
        <a href={ministry.url} class={classes.card}>
          <img
            src={ministry.icon}
            alt={ministry.name}
            class="w-12 h-12 sm:w-16 sm:h-16 md:w-20 md:h-20 mcard-img"
          />
          <h3 class="text-3xl sm:text-4xl mcard-text font-montserrat">{ministry.name}</h3>
        </a>
      ))
    }
  </div>
</section>
<script>
  import { animateMinistries } from '../scripts/animations.ts';
  setTimeout(animateMinistries, 100);
</script>
