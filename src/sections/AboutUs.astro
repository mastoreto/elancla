---
import cn from "../utils/cn.ts";
    interface Props {
    size: string;
    }

    const classes = {
        section: cn(
            'flex',
            'flex-col',
            'px-[2rem]',
            'md:pt-28',
            'md:px-[15rem]'
        ),
        title: cn(
            'text-3xl', 
            'md:text-6xl',
            'text-red-500',
            'font-bold', 
            'font-montserrat',
            'mt-10', 
            'mb-5', 
            'md:my-10',
            'font-barastika'
        ),
        bg: cn(
            'bg-aboutus',
            'relative',
            'bg-cover',
            'bg-center',
            'rounded-[3rem]',
            'my-5',
            'h-[100rem]'
        ),
        overlay: cn(
            'absolute',
            'h-full',
            'w-full',
            'backdrop-blur',
            'bg-primary-500',
            'bg-opacity-50',
            'rounded-[3rem]',
            'flex',
            'items-center',
            'justify-center'
        ),
        text: cn(
            'font-montserrat',
            'text-[1.5rem]',
            'my-5',
            'md:text-xl',
            'md:text-wrap',
            'md:w-4/5',
            'xl:text-[1.5rem]',
        ),
    }

    const { size } = Astro.props;
---
<section class=`${size} ${classes.section}` id="elancla">
    <h2 class={classes.title}>¡Gracias por querer conocernos! </h2>
    <div class={classes.bg}>
        <div class={classes.overlay}></div>
        <p class="font-montserrat text-white text-[3.125rem] font-bold absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-20">Nuestra Historia</p>
    </div>
    <p class={classes.text}>
        Conocer una iglesia es un gran desafió en estos tiempos,
        esperamos que con la información que encuentres aquí,
        puedas tener un mayor panorama de quienes somos y lo
        que creemos. Eres bienvenido a visitarnos cuando quieras. 
    </p>
</section>