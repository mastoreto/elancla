---
import cn from '../utils/cn.ts';

const classes = {
  section: cn(
    'w-screen min-h-screen',
    'flex flex-col xl:flex-row',
    'px-5 md:px-12 xl:pt-28 xl:px-[5rem]',
    'mb-0 xl:mb-0 fade-in'
  ),
  title: cn(
    'w-auto h-auto',
    'text-4xl sm:text-5xl md:text-6xl',
    'text-red-500 font-bold font-futura-bold',
    'mt-10 mb-4 md:my-10',
    'leading-tight'
  ),
  overlay: cn(
    'w-full h-56 sm:h-72 md:h-96 xl:h-full',
    'm-0 rounded-xl',
    'bg-home-banner bg-cover bg-center',
    'grayscale'
  ),
  text: cn(
    'font-boston-angel leading-relaxed',
    'text-base sm:text-lg md:text-xl xl:text-[1.4rem]',
    'my-4 md:my-6',
    'w-full md:w-4/5'
  ),
  description: cn(
    'w-full h-full flex flex-col justify-center items-center',
    'md:justify-center md:items-start',
    'md:pl-10 md:pr-5',
    'xl:pl-20 xl:pr-10'
  ),
  image: cn(
    'w-full flex flex-col justify-center items-center',
    'xl:h-full',
    'mt-8 xl:mt-0',
    'md:justify-end md:items-end',
    'md:pr-0 xl:pr-20'
  ),
};
---

<section class={classes.section} id="elancla">
  <div class={classes.description}>
    <h2 class={classes.title}>¡Gracias por querer conocernos!</h2>
    <p class={classes.text}>
      Conocer una iglesia es un gran desafío en estos tiempos, esperamos que con
      la información que encuentres aquí, puedas tener un mayor panorama de
      quienes somos y lo que creemos. Eres bienvenido a visitarnos cuando
      quieras.
    </p>
  </div>
  <div class={classes.image}>
    <div class={classes.overlay}></div>
  </div>
</section>
