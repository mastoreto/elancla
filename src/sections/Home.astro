---
import Decorators from 'src/components/Decorators.astro';
import cn from '../utils/cn.ts';

const classes = {
  section: cn(
    'w-screen h-screen',
    'flex flex-col md:flex-row',
    'bg-secondary-100',
    'relative'
  ),
  logo: cn('flex', 'flex-col', 'justify-center', 'items-center'),
  opImg: cn(
    'w-[30rem]',
    'absolute',
    'top-[-15rem]',
    'right-[-10rem]',
    'transform rotate-[160deg]'
  ),
  welcomeDiv: cn(
    'w-full',
    'h-full',
    'flex',
    'flex-col',
    'justify-center',
    'items-center'
  ),
  title: cn(
    'font-barastika',
    'text-primary-800',
    'text-[4.5rem]',
    'sm:text-[4rem]',
    'md:text-[7rem]',
    'xl:text-[8rem]',
    'font-bold',
    'h-auto',
    'leading-[8rem]'
  ),
  anchorImg: cn('w-14', 'h-15', 'mr-2'),
  anchor: cn('font-futura-bold', 'text-3xl', 'leading-3'),
  church: cn('font-futura', 'text-[1.1rem]'),
  decoratorOne: cn('absolute right-0'),
};
---

<section class={classes.section} id="inicio">
  <Decorators type="top" customClass={classes.decoratorOne} />
  <div class={classes.welcomeDiv}>
    <div class=`${classes.logo}`>
      <img
        src="/images/anclarojo.png"
        alt="logo"
        width="100"
        height="150"
        class={classes.anchorImg}
      />
      <div>
        <p class={classes.church}>IGLESIA BAUTISTA</p>
        <p class={classes.anchor}>EL ANCLA</p>
      </div>
    </div>
    <h1 class={classes.title}>Bienvenidos</h1>
  </div>
</section>
