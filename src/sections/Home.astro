---
import { Icon } from 'astro-icon/components';
import cn from '../utils/cn.ts';
interface Props{
    size: string;
}

const classes = {
    section: cn(
        'flex',
        'flex-col',
        'md:flex-row',
        'relative'
    ),
    imgDiv: cn(
        'absolute',
        'bg-white',
        'p-5',
        'rounded-xl',
        'top-[16rem]',
        'sm:top-[20rem]',
        'md:top-1/2',
        'left-1/2',
        'transform',
        '-translate-x-1/2',
        '-translate-y-1/2',
        'z-10'
    ),
    img: cn(
        'px-4',
        'py-1'
    ),
    welcomeDiv: cn(
        'w-full',
        'md:w-1/2',
        'h-full',
        'flex',
        'flex-col',
        'justify-center',
        'items-center',
        'relative'
    ),
    title: cn(
        'font-barastika',
        'text-primary-500',
        'text-[3rem]',
        'sm:text-[4rem]',
        'md:text-[4rem]',
        'xl:text-[6rem]',
        'font-bold',
        'h-auto'
    ),
    p: cn(
        'font-montserrat',
        'text-2xl',
        'text-black',
        'font-bold',
        'font-futura-bold',
        'absolute',
        'bottom-[25rem]',
    ),
    imgDiv2: cn(
        'w-[21-5rem]',
        'h-[100rem]',
        'sm:h-[150rem]',
        'm-5',
        'rounded-xl',
        'md:rounded-none',
        'md:m-0',
        'xl:w-1/2',
        'xl:h-full',
        'bg-home-banner',
        'bg-cover',
        'bg-center',
        'grayscale'
    ),
    ul: cn(
        'flex',
        'flex-row',
        'text-primary-500',
        'font-bold',
        'font-montserrat',
        'mx-auto',
        'mb-5',
        'mt-2'
    ),
    li: cn(
        'text-sm',
        'flex',
        'flex-row',
        'justify-center',
        'items-center',
        'mx-2',
        'md:hidden'
    )
}

const {size} = Astro.props;
---
<section class=`${size} ${classes.section}` id="inicio">
    <div class=`${classes.imgDiv}`>
        <img src="/images/anclarojo.png" alt="logo" width="99" height="127" class={classes.img}/>
    </div>
    <div class={classes.welcomeDiv}>
        
        <h1 class={classes.title}>Bienvenidos</h1>
        <p class={classes.p}>Iglesia Bautista El Ancla</p>
   
    </div>
    <div class="w-[21-5rem] h-[100rem] sm:h-[150rem] m-5 rounded-xl md:rounded-none md:m-0 xl:w-1/2 xl:h-full bg-home-banner bg-cover bg-center grayscale"></div>
    <ul class="flex flex-row text-primary-500 font-bold font-montserrat mx-auto mb-5 mt-2">
        <li class="text-sm flex flex-row justify-center items-center mx-2 md:hidden"><Icon name="mdi:google-maps" class="text-md" /> Av Dr Luis Alberto de Herrera 3101</li>
    </ul>
</section>