---
import cn from '../utils/cn.ts';

const styles = {
  section: cn('relative min-h-screen pt-32 pb-16 overflow-hidden grain'),
  gridBg: cn('absolute inset-0 grid-bg opacity-60'),
  decorSvg: cn(
    'absolute top-[20%] right-[-10%] w-[55vw] h-[55vw]',
    'opacity-[0.05] pointer-events-none'
  ),
  container: cn('relative mx-auto max-w-[1600px] px-6 md:px-10'),
  labelRow: cn('flex items-center justify-between mb-10 md:mb-16'),
  labelLeft: cn(
    'flex items-center gap-3 font-ui text-[11px]',
    'tracking-[0.2em] uppercase text-ink/60'
  ),
  labelLine: cn('w-8 h-px bg-ink/40'),
  labelRight: cn('hidden md:block font-ui text-[11px] tracking-[0.2em] uppercase text-ink/60'),
  heroLeft: cn('hero-left flex flex-col'),
  heroTitle: cn('hero-title text-[18vw] md:text-[14vw] lg:text-[12vw] text-ink'),
  metaRow: cn(
    'hero-meta-row mt-10 md:mt-14',
    'flex flex-col md:flex-row md:items-end md:justify-between gap-8'
  ),
  metaLeft: cn('max-w-md'),
  metaDivider: cn('h-px bg-ink/30 line-grow origin-left w-24 mb-5'),
  metaText: cn('font-ui text-[15px] md:text-[17px] leading-relaxed text-ink/75'),
  ctaRow: cn('flex items-center gap-4'),
  ctaPrimary: cn(
    'cta-btn btn-primary inline-flex items-center gap-3',
    'rounded-full bg-primary text-white',
    'px-7 py-4 font-ui text-[13px] font-semibold tracking-wide uppercase'
  ),
  ctaSecondary: cn(
    'hidden md:inline-flex items-center gap-2',
    'font-ui text-[13px] font-semibold tracking-wide uppercase ulink arrow-link'
  ),
  scheduleGrid: cn(
    'mt-16 md:mt-24 grid grid-cols-2 md:grid-cols-4',
    'gap-[1px] bg-ink/10 border border-ink/10 rounded-2xl overflow-hidden'
  ),
  scheduleCell: cn('bg-paper p-6 md:p-7 reveal'),
  scheduleCellHighlight: cn('bg-primary text-white p-6 md:p-7 reveal reveal-delay-3 relative group'),
  cellLabel: cn('font-ui text-[10px] tracking-[0.2em] uppercase text-ink/50 mb-2'),
  cellLabelLight: cn('font-ui text-[10px] tracking-[0.2em] uppercase text-white/70 mb-2'),
  cellTime: cn('font-display text-2xl md:text-3xl leading-none'),
  cellDesc: cn('mt-3 font-ui text-[13px] text-ink/70'),
  cellDescLight: cn('mt-3 font-ui text-[13px] text-white/90 flex items-center gap-2'),
  scrollCue: cn(
    'hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2',
    'flex-col items-center gap-2'
  ),
  scrollLabel: cn('font-ui text-[10px] tracking-[0.25em] uppercase text-ink/50'),
  scrollTrack: cn('block w-px h-10 bg-ink/20 relative overflow-hidden'),
};
---

<!-- HERO -->
<section id="inicio" class={styles.section}>
  <div class={styles.gridBg}></div>

  <!-- círculo decorativo -->
  <svg class={styles.decorSvg} viewBox="0 0 200 200">
    <circle cx="100" cy="100" r="100" fill="none" stroke="#141414" stroke-width="0.4"/>
    <circle cx="100" cy="100" r="70"  fill="none" stroke="#141414" stroke-width="0.4"/>
    <circle cx="100" cy="100" r="40"  fill="none" stroke="#141414" stroke-width="0.4"/>
  </svg>

  <div class={styles.container}>
    <!-- label row -->
    <div class={styles.labelRow}>
      <div class={styles.labelLeft}>
        <span class={styles.labelLine}></span>
        <span>Montevideo · Uruguay</span>
      </div>
      <div class={styles.labelRight}>Fundada · MCMXCVII</div>
    </div>

    <!-- título hero -->
    <div class={styles.heroLeft}>
      <h1 class={styles.heroTitle}>
        <span class="hero-line"><span>Una iglesia</span></span>
        <span class="hero-line"><span>con <em>ancla</em> en</span></span>
        <span class="hero-line"><span>el evangelio.</span></span>
      </h1>

      <div class={styles.metaRow}>
        <div class={styles.metaLeft}>
          <div class={styles.metaDivider}></div>
          <p class={styles.metaText}>
            Somos una comunidad cristiana bautista en el corazón de
            Montevideo. Creemos en la gracia, la Palabra y la familia de
            la fe.
          </p>
        </div>

        <div class={styles.ctaRow}>
          <a href="#nosotros" class={styles.ctaPrimary}>
            Conocer más
            <svg class="cta-arrow" width="14" height="14" viewBox="0 0 12 12" fill="none">
              <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
          <a href="#sermones" class={styles.ctaSecondary}>
            Últimos sermones
            <svg class="arrow-ico" width="14" height="14" viewBox="0 0 12 12" fill="none">
              <path d="M2 6H10M10 6L6 2M10 6L6 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- grid de horarios -->
    <div class={styles.scheduleGrid}>
      <div class={styles.scheduleCell}>
        <div class={styles.cellLabel}>01 · Domingos</div>
        <div class={styles.cellTime}>11:15</div>
        <div class={styles.cellDesc}>Culto de celebración</div>
      </div>
      <div class={cn(styles.scheduleCell, 'reveal-delay-1')}>
        <div class={styles.cellLabel}>02 · Domingos</div>
        <div class={styles.cellTime}>10:00</div>
        <div class={styles.cellDesc}>Escuela bíblica</div>
      </div>
      <div class={cn(styles.scheduleCell, 'reveal-delay-2')}>
        <div class={styles.cellLabel}>03 · Miércoles</div>
        <div class={styles.cellTime}>19:00</div>
        <div class={styles.cellDesc}>Reunión de oración</div>
      </div>
      <div class={styles.scheduleCellHighlight}>
        <div class={styles.cellLabelLight}>En vivo</div>
        <div class={styles.cellTime}>YouTube</div>
        <div class={styles.cellDescLight}>
          Transmisión dominical
          <svg class="transition-transform group-hover:translate-x-1" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 6H10M10 6L6 2M10 6L6 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- scroll cue -->
    <div class={styles.scrollCue}>
      <span class={styles.scrollLabel}>Descubre</span>
      <span class={styles.scrollTrack}>
        <span class="block w-px h-full bg-ink scroll-bar"></span>
      </span>
    </div>
  </div>
</section>
