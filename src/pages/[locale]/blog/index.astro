---
import BlogPageTemplate from 'src/components/Blog/BlogPageTemplate.astro';
import { nonDefaultLocales, type Locale } from 'src/i18n/config';
import { getMessages } from 'src/i18n/messages';
import { localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout.astro';
import {
  buildBlogPageData,
  getAllCategories,
  getAllPostCards,
  getAllSeriesWithPosts,
} from 'src/lib/sanity';

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const [posts, categories, allSeries] = await Promise.all([
  getAllPostCards(),
  getAllCategories(),
  getAllSeriesWithPosts(),
]);

const { articles, featured, marqueeItems, series, popular, tags, archive, categories: blogCategories } =
  buildBlogPageData(posts, categories, allSeries);
if (!featured) {
  throw new Error('Blog requires at least one featured article.');
}
const copy = getMessages(locale).blog;
---

<Layout
  title={copy.seo.title}
  description={copy.seo.description}
  isBlog={true}
  keywords={copy.seo.keywords}
  breadcrumbs={[
    { name: copy.breadcrumbs.home, url: localizePath('/', locale) },
    { name: copy.breadcrumbs.blog, url: localizePath('/blog', locale) },
  ]}
  canonical={new URL(localizePath('/blog', locale), Astro.site).toString()}
  locale={locale}
>
  <BlogPageTemplate
    articles={articles}
    categories={blogCategories}
    featured={featured}
    marqueeItems={marqueeItems}
    series={series}
    popular={popular}
    tags={tags}
    archive={archive}
    copy={copy}
    locale={locale}
  />
</Layout>

<script>
  import { initBlog } from 'src/scripts/blog';

  initBlog();
</script>
