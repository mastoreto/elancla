---
import Layout from '../layouts/Layout.astro';
import AboutUs from '../sections/AboutUs.astro';
import Activities from '../sections/Activities.astro';
import Contact from '../sections/Contact.astro';
import Home from '../sections/Home.astro';
import Marquee from '../sections/Marquee.astro';
import Ministries from '../sections/Ministries.astro';
import Sermons from '../sections/Sermons.astro';
import { getMessages } from 'src/i18n/messages';
import { getLocaleFromUrl } from 'src/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const copy = getMessages(locale);
---

<Layout
  title={copy.home.seo.title}
  description={copy.home.seo.description}
  keywords={copy.home.seo.keywords}
  locale={locale}
>
  <Home copy={copy.home.hero} locale={locale} />
  <Marquee words={copy.home.marquee.words} />
  <AboutUs copy={copy.aboutUs} locale={locale} />
  <Activities copy={copy.activities} />
  <Sermons copy={copy.sermons} />
  <Ministries copy={copy.ministries} locale={locale} />
  <Contact copy={copy.contact} />
</Layout>

<script>
  import { initLanding } from '../scripts/landing.ts';
  initLanding();
</script>
