---
import cn from '../utils/cn';
import Decorators from 'src/components/Decorators.astro';
import Layout from '../layouts/Layout.astro';
import Home from '../sections/Home.astro';
import AboutUs from '../sections/AboutUs.astro';
import Activities from '../sections/Activities.astro';
import Sermons from '../sections/Sermons.astro';
import Ministries from 'src/sections/Ministries.astro';
import Contact from '../sections/Contact.astro';

const classes = {
  decoratorTwo: cn(
    'absolute',
    'top-[-5rem]',
    'left-[-10rem]',
    'w-[35%]',
    'h-[35%]',
    'z-0'
  ),
};
---

<Layout title="Iglesia Bautista El Ancla">
  <Home />
  <Decorators type="bottom" customClass={classes.decoratorTwo} />
  <AboutUs />
  <Activities />
  <Sermons />
  <Ministries />
  <Contact />
</Layout>
<script>
  import { initAnimations } from '../scripts/animations.ts';
  setTimeout(initAnimations, 100);
</script>
