---
import BlogPageTemplate from 'src/components/Blog/BlogPageTemplate.astro';
import {
  blogArchive,
  blogArticles,
  blogCategories,
  blogMarqueeItems,
  blogPopularItems,
  blogSeries,
  blogTags,
  featuredArticle,
} from 'src/data/blog';
import Layout from 'src/layouts/Layout.astro';
---

<Layout
  title="Blog"
  description="Reflexiones, estudios bíblicos, sermones y crónicas de la vida de Iglesia Bautista El Ancla en Montevideo."
  isBlog={true}
  keywords={[
    'blog cristiano',
    'estudios bíblicos',
    'reflexiones cristianas',
    'sermones',
    'Iglesia Bautista El Ancla',
  ]}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
>
  <BlogPageTemplate
    articles={blogArticles}
    categories={blogCategories}
    featured={featuredArticle}
    marqueeItems={blogMarqueeItems}
    series={blogSeries}
    popular={blogPopularItems}
    tags={blogTags}
    archive={blogArchive}
  />
</Layout>

<script>
  import { initBlog } from 'src/scripts/blog';

  initBlog();
</script>
