---
import BlogPageTemplate from 'src/components/Blog/BlogPageTemplate.astro';
import {
  blogArchive,
  blogArticles,
  blogCategories,
  blogMarqueeItems,
  blogPopularItems,
  blogSeries,
  blogTags,
  featuredArticle,
} from 'src/data/blog';
import Layout from 'src/layouts/Layout.astro';
---

<Layout
  title="Blog | Iglesia Bautista El Ancla"
  description="Reflexiones, estudios bíblicos y crónicas de la vida de Iglesia Bautista El Ancla."
  isBlog={true}
>
  <BlogPageTemplate
    articles={blogArticles}
    categories={blogCategories}
    featured={featuredArticle}
    marqueeItems={blogMarqueeItems}
    series={blogSeries}
    popular={blogPopularItems}
    tags={blogTags}
    archive={blogArchive}
  />
</Layout>

<script>
  import { initBlog } from 'src/scripts/blog';

  initBlog();
</script>
