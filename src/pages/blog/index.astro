---

<Layout title="Blog - El Ancla" isBlog={true}>
  <section
    class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center mt-20"
  >
    <div class="flex flex-col items-center justify-center gap-6 pb-8">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-primary text-3xl"
          >auto_stories</span
        >
        <p class="text-primary font-bold tracking-widest text-sm uppercase">
          Nuestro Blog
        </p>
      </div>
      <h1
        class="text-6xl md:text-8xl font-display font-black tracking-tight text-primary mb-2"
      >
        Artículos & <span class="text-neutral-900 dark:text-white"
          >Reflexiones</span
        >
      </h1>
      <p
        class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 font-sans font-medium leading-relaxed max-w-2xl"
      >
        Recursos para fortalecer tu fe, conocer más de Dios y vivir el evangelio
        en comunidad.
      </p>
    </div>
  </section>

  <div
    class="sticky top-20 z-40 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-md border-b border-primary/10 mb-12 shadow-sm"
  >
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-x-auto no-scrollbar py-4"
    >
      <div class="flex justify-center w-full">
        <div class="flex gap-3 items-center">
          <button
            class="whitespace-nowrap rounded-lg bg-primary text-white px-6 py-2.5 text-sm font-bold tracking-wide transition-all shadow-lg shadow-primary/30 hover:bg-primary-dark"
            >Todos</button
          >
          <button
            class="whitespace-nowrap rounded-lg bg-white dark:bg-surface-dark text-neutral-600 dark:text-neutral-300 border border-transparent hover:border-primary/20 hover:text-primary px-6 py-2.5 text-sm font-bold shadow-sm hover:shadow-md transition-all"
            >Teología</button
          >
          <button
            class="whitespace-nowrap rounded-lg bg-white dark:bg-surface-dark text-neutral-600 dark:text-neutral-300 border border-transparent hover:border-primary/20 hover:text-primary px-6 py-2.5 text-sm font-bold shadow-sm hover:shadow-md transition-all"
            >Vida Cristiana</button
          >
          <button
            class="whitespace-nowrap rounded-lg bg-white dark:bg-surface-dark text-neutral-600 dark:text-neutral-300 border border-transparent hover:border-primary/20 hover:text-primary px-6 py-2.5 text-sm font-bold shadow-sm hover:shadow-md transition-all"
            >Alabanza</button
          >
          <button
            class="whitespace-nowrap rounded-lg bg-white dark:bg-surface-dark text-neutral-600 dark:text-neutral-300 border border-transparent hover:border-primary/20 hover:text-primary px-6 py-2.5 text-sm font-bold shadow-sm hover:shadow-md transition-all"
            >Misiones</button
          >
        </div>
      </div>
    </div>
  </div>

  <section class="px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto pb-32">
    <div class="masonry-grid">
      {
        articles.map((article) => (
          <>
            {article.type === 'quote' ? (
              <article class="break-inside-avoid mb-10 group flex flex-col justify-center bg-primary text-white rounded-3xl shadow-card p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-xl relative overflow-hidden">
                <span class="material-symbols-outlined absolute -top-4 -left-4 text-9xl text-white/10 rotate-12">
                  format_quote
                </span>
                <div class="relative z-10 flex flex-col gap-4">
                  <div class="text-xs font-black tracking-widest uppercase text-white/70">
                    {article.label}
                  </div>
                  <blockquote class="text-2xl font-display font-bold leading-tight italic">
                    "{article.quote}"
                  </blockquote>
                  <p class="text-white/80 text-sm font-bold mt-2">
                    — {article.author}
                  </p>
                </div>
              </article>
            ) : (
              <a
                href={`/blog/${article.year}/${article.month}/${article.day}/${article.slug}`}
                class="block break-inside-avoid mb-10 group no-underline"
              >
                <article class="flex flex-col bg-white dark:bg-surface-dark rounded-3xl shadow-card overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ring-1 ring-neutral-100 dark:ring-neutral-800">
                  <div
                    class={`relative overflow-hidden ${article.featured ? 'h-64' : 'h-56'}`}
                  >
                    {article.featured && (
                      <div class="absolute top-4 right-4 z-10">
                        <span class="inline-flex items-center rounded-full bg-primary px-3 py-1 text-[10px] font-black uppercase tracking-wider text-white shadow-lg">
                          Destacado
                        </span>
                      </div>
                    )}
                    <div
                      class="w-full h-full bg-cover bg-center transform transition-transform duration-700 ease-out group-hover:scale-110"
                      style={`background-image: url('${article.image}')`}
                    />
                  </div>
                  <div class="p-6 flex flex-col gap-3">
                    <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-neutral-400">
                      <span>{article.category}</span>
                      <span>{article.date || article.readTime}</span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-display font-black leading-tight text-neutral-900 dark:text-white group-hover:text-primary transition-colors">
                      {article.title}
                    </h2>
                    <p class="text-neutral-600 dark:text-neutral-400 text-base leading-relaxed line-clamp-3">
                      {article.description}
                    </p>
                    {article.author && (
                      <div class="mt-4 pt-4 border-t border-neutral-100 dark:border-neutral-700 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <img
                            alt="Author"
                            class="size-8 rounded-full border-2 border-white shadow-sm"
                            src={article.authorImg}
                          />
                          <span class="text-xs font-bold text-neutral-700 dark:text-neutral-300">
                            {article.author}
                          </span>
                        </div>
                      </div>
                    )}
                    <div class="mt-4 w-full bg-primary hover:bg-primary-dark text-white font-bold py-3 rounded-xl transition-colors shadow-lg shadow-primary/20 text-center">
                      {article.cta || 'Leer Artículo'}
                    </div>
                  </div>
                </article>
              </a>
            )}
          </>
        ))
      }
    </div>
    <div class="mt-8 flex justify-center pb-8">
      <button
        class="group flex items-center gap-3 rounded-full border-2 border-primary bg-transparent px-8 py-3 text-sm font-bold uppercase tracking-widest text-primary transition-all hover:bg-primary hover:text-white hover:shadow-lg hover:shadow-primary/30"
      >
        Cargar Más Artículos
        <span
          class="material-symbols-outlined transition-transform duration-300 group-hover:translate-y-1"
          >expand_more</span
        >
      </button>
    </div>
  </section>
</Layout>
