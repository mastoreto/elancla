---
import BlogArticleTemplate from 'src/components/Blog/BlogArticleTemplate.astro';
import {
  blogArticles,
  getPreviousNextArticles,
  getRelatedArticles,
  type BlogArticle,
} from 'src/data/blog';
import Layout from 'src/layouts/Layout.astro';

interface Props {
  article: BlogArticle;
}

export function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: {
      year: article.year,
      month: article.month,
      day: article.day,
      slug: article.slug,
    },
    props: { article },
  }));
}

const { article } = Astro.props;
const related = getRelatedArticles(article);
const { previous, next } = getPreviousNextArticles(article);

const articleUrl = `/blog/${article.year}/${article.month}/${article.day}/${article.slug}`;
const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: article.title, url: articleUrl },
];
---

<Layout
  title={article.seoTitle ?? article.title}
  description={article.description}
  isBlog={true}
  pageType="article"
  breadcrumbs={breadcrumbs}
  keywords={article.tags}
  article={{
    publishedAt: article.publishedAt,
    authorName: article.author.name,
    section: article.category,
    tags: article.tags,
  }}
>
  <BlogArticleTemplate
    article={article}
    related={related}
    previous={previous}
    next={next}
  />
</Layout>

<script>
  import { initBlog } from 'src/scripts/blog';

  initBlog();
</script>
