---
import ContentPageTemplate from 'src/components/ContentPage/ContentPageTemplate.astro';
import { getContentPageStaticPaths, type ContentPage } from 'src/data/contentPages';
import { defaultLocale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';
import Layout from 'src/layouts/Layout.astro';

interface Props {
  page: ContentPage;
  isAlias?: boolean;
}

export function getStaticPaths() {
  return getContentPageStaticPaths('ministerios', defaultLocale);
}

const { page, isAlias = false } = Astro.props;
const locale = defaultLocale;

const canonicalPath = `/ministerios/${page.slug}`;
const canonical = new URL(localizePath(canonicalPath, locale), Astro.site).toString();
const breadcrumbs = page.hero.breadcrumbs.map((item) => ({
  name: item.label,
  url: item.href ?? canonicalPath,
}));
---

<Layout
  title={page.seoTitle ?? page.title}
  description={page.description}
  breadcrumbs={breadcrumbs}
  image={page.featuredImage?.src}
  imageAlt={page.featuredImage?.alt}
  canonical={canonical}
  noindex={isAlias}
  locale={locale}
>
  <ContentPageTemplate page={page} />
</Layout>

<script>
  import { initContentPage } from 'src/scripts/contentPage';

  initContentPage();
</script>
