---
import Layout from 'src/layouts/Layout.astro';
import { doctrines, solas } from 'src/data/doctrines';
import ConfesionHero from 'src/components/ConfesionDeFe/ConfesionHero.astro';
import ConfesionMarquee from 'src/components/ConfesionDeFe/ConfesionMarquee.astro';
import ConfesionQuote from 'src/components/ConfesionDeFe/ConfesionQuote.astro';
import DoctrineList from 'src/components/ConfesionDeFe/DoctrineList.astro';
import ConfesionChristus from 'src/components/ConfesionDeFe/ConfesionChristus.astro';
import ConfesionCTA from 'src/components/ConfesionDeFe/ConfesionCTA.astro';
import 'src/styles/ConfesionDeFe.css';

const total = String(doctrines.length).padStart(2, '0');
---

<Layout
  title="Confesión de fe"
  description="Confesión de fe de Iglesia Bautista El Ancla: doce artículos doctrinales y los cinco solas de la Reforma que guían nuestra vida y enseñanza."
  keywords={[
    'confesión de fe',
    'doctrina bautista',
    'cinco solas',
    'reforma protestante',
    'Iglesia Bautista El Ancla',
  ]}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Confesión de fe', url: '/confesion-de-fe' },
  ]}
>
  <ConfesionHero />
  <ConfesionMarquee solas={solas} />
  <ConfesionQuote />
  <DoctrineList doctrines={doctrines} total={total} />
  <ConfesionChristus />
  <ConfesionCTA />
</Layout>

<script>
  import 'src/scripts/confesion.ts';
</script>
