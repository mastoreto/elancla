---
import ContentPageTemplate from 'src/components/ContentPage/ContentPageTemplate.astro';
import { getContentPageStaticPaths, type ContentPage } from 'src/data/contentPages';
import Layout from 'src/layouts/Layout.astro';

interface Props {
  page: ContentPage;
}

export function getStaticPaths() {
  return getContentPageStaticPaths('root');
}

const { page } = Astro.props;
---

<Layout title={page.seoTitle ?? page.title} description={page.description}>
  <ContentPageTemplate page={page} />
</Layout>

<script>
  import { initContentPage } from 'src/scripts/contentPage';

  initContentPage();
</script>
