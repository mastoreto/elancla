---
import Footer from '../components/Footer.astro';
import LoadingOverlay from '../components/LoadingOverlay.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from 'src/i18n/config';
import {
  getHtmlLang,
  getLanguageAlternates,
  getLocaleFromUrl,
  getLocaleSeo,
  localizePath,
  stripLocaleFromPath,
} from 'src/i18n/utils';
import {
  SITE,
  absoluteUrl,
  buildArticleLd,
  buildBreadcrumbsLd,
  buildOrganizationLd,
  buildWebsiteLd,
  type SEOArticleMeta,
  type SEOBreadcrumb,
  type PageType,
} from '../utils/seo';

interface Props {
  title: string;
  description?: string;
  isBlog?: boolean;
  pageType?: PageType;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  canonical?: string;
  keywords?: string[];
  breadcrumbs?: SEOBreadcrumb[];
  article?: SEOArticleMeta;
  locale?: Locale;
}

const {
  title,
  description = SITE.defaultDescription,
  pageType = 'website',
  image = SITE.defaultImage,
  imageAlt = 'Iglesia Bautista El Ancla — Montevideo, Uruguay',
  noindex = false,
  canonical,
  keywords,
  breadcrumbs,
  article,
  locale: localeProp,
} = Astro.props;

const locale = localeProp ?? getLocaleFromUrl(Astro.url);
const localeSeo = getLocaleSeo(locale);
const canonicalPath = stripLocaleFromPath(Astro.url.pathname);
const localizedPath = localizePath(canonicalPath, locale);
const pageUrl = canonical ?? new URL(localizedPath, SITE.url).toString();
const alternatesPath = canonical ? new URL(canonical).pathname : Astro.url.pathname;
const ogImage = absoluteUrl(image);

// Evitar duplicar la marca si el título ya la incluye.
const brandRegex = /(El Ancla|Iglesia Bautista)/i;
const fullTitle =
  title === SITE.defaultTitle || brandRegex.test(title)
    ? title
    : `${title} | ${SITE.shortName}`;

const jsonLd: Record<string, unknown>[] = [
  buildOrganizationLd(),
  buildWebsiteLd(localeSeo.htmlLang),
];

const breadcrumbLd = buildBreadcrumbsLd(breadcrumbs ?? []);
if (breadcrumbLd) jsonLd.push(breadcrumbLd);

if (pageType === 'article' && article) {
  jsonLd.push(
    buildArticleLd({
      url: pageUrl,
      title,
      description,
      image: ogImage,
      publishedAt: article.publishedAt,
      modifiedAt: article.modifiedAt,
      authorName: article.authorName,
      section: article.section,
      tags: article.tags,
      language: localeSeo.htmlLang,
    })
  );
}
---

<!doctype html>
<html lang={getHtmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Iconos -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/anclarojo.png" />
    <link rel="mask-icon" href="/favicon.svg" color={SITE.themeColor} />

    <script is:inline>
      (() => {
        const storageKey = 'elancla:theme';
        try {
          const preference = localStorage.getItem(storageKey) || 'system';
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const resolved = preference === 'dark' || (preference !== 'light' && systemDark) ? 'dark' : 'light';
          document.documentElement.classList.toggle('dark', resolved === 'dark');
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePreference = preference;
        } catch {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.dataset.themePreference = 'system';
        }
      })();
    </script>

    <SEO
      title={fullTitle}
      description={description}
      canonical={pageUrl}
      noindex={noindex}
      nofollow={noindex}
      languageAlternates={getLanguageAlternates(alternatesPath, SITE.url)}
      openGraph={{
        basic: {
          title: fullTitle,
          type: pageType,
          image: ogImage,
          url: pageUrl,
        },
        image: {
          alt: imageAlt,
          width: 1200,
          height: 630,
          type: 'image/jpeg',
        },
        optional: {
          siteName: SITE.name,
          locale: localeSeo.ogLocale,
          description,
        },
        ...(pageType === 'article' && article
          ? {
              article: {
                publishedTime: article.publishedAt,
                modifiedTime: article.modifiedAt,
                authors: article.authorName ? [article.authorName] : undefined,
                section: article.section,
                tags: article.tags,
              },
            }
          : {}),
      }}
      twitter={{
        card: 'summary_large_image',
        site: SITE.twitter,
        creator: SITE.twitter,
        title: fullTitle,
        description,
        image: ogImage,
        imageAlt,
      }}
      extend={{
        meta: [
          ...(keywords?.length
            ? [{ name: 'keywords', content: keywords.join(', ') }]
            : []),
          { name: 'author', content: SITE.name },
          { name: 'publisher', content: SITE.name },
          { name: 'application-name', content: SITE.shortName },
          { name: 'apple-mobile-web-app-title', content: SITE.shortName },
          { name: 'apple-mobile-web-app-capable', content: 'yes' },
          { name: 'mobile-web-app-capable', content: 'yes' },
          { httpEquiv: 'content-language', content: localeSeo.htmlLang },
          { name: 'geo.region', content: 'UY-MO' },
          { name: 'geo.placename', content: 'Montevideo' },
          {
            name: 'geo.position',
            content: `${SITE.geo.latitude};${SITE.geo.longitude}`,
          },
          {
            name: 'ICBM',
            content: `${SITE.geo.latitude}, ${SITE.geo.longitude}`,
          },
        ],
        link: [
          {
            rel: 'sitemap',
            type: 'application/xml',
            href: '/sitemap-index.xml',
          },
        ],
      }}
    />

    {
      jsonLd.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }

    <script is:inline>
      (() => {
        const storageKey = 'elancla:loader-seen';
        try {
          const hasSeenLoader = sessionStorage.getItem(storageKey) === 'true';
          document.documentElement.classList.add(
            hasSeenLoader ? 'site-loader-skip-initial' : 'site-loader-pending'
          );
        } catch {
          document.documentElement.classList.add('site-loader-pending');
        }
      })();
    </script>
    <ClientRouter fallback="animate" />

    <script is:inline>
      (() => {
        const storageKey = 'elancla:theme';
        const systemQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const getPreference = () => localStorage.getItem(storageKey) || 'system';
        const resolveTheme = (preference) =>
          preference === 'dark' || (preference !== 'light' && systemQuery.matches) ? 'dark' : 'light';

        const applyTheme = (preference = getPreference()) => {
          const resolved = resolveTheme(preference);
          document.documentElement.classList.toggle('dark', resolved === 'dark');
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePreference = preference;
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            const isDark = resolved === 'dark';
            button.setAttribute('aria-pressed', String(isDark));
            button.setAttribute(
              'aria-label',
              isDark ? button.dataset.labelLight || 'Use light mode' : button.dataset.labelDark || 'Use dark mode'
            );
            button.querySelectorAll('[data-theme-icon]').forEach((icon) => {
              icon.style.display = icon.getAttribute('data-theme-icon') === (isDark ? 'sun' : 'moon') ? '' : 'none';
            });
          });
        };

        const bindThemeControls = () => {
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            if (button.dataset.themeBound === 'true') return;
            button.dataset.themeBound = 'true';
            button.addEventListener('click', () => {
              const nextPreference = resolveTheme(getPreference()) === 'dark' ? 'light' : 'dark';
              localStorage.setItem(storageKey, nextPreference);
              applyTheme(nextPreference);
            });
          });
          applyTheme();
        };

        systemQuery.addEventListener?.('change', () => {
          if (getPreference() === 'system') applyTheme('system');
        });
        document.addEventListener('DOMContentLoaded', bindThemeControls);
        document.addEventListener('astro:page-load', bindThemeControls);
        bindThemeControls();
      })();
    </script>

    <!-- Fuentes consolidadas en una sola petición con display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700;9..144,800&family=Libre+Franklin:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Noto+Sans:wght@400;500;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
  </head>
  <body class="overflow-x-hidden selection:bg-primary selection:text-white">
    <LoadingOverlay />
    <div id="readprog"></div>
    <Nav locale={locale} />
    <main class="max-w-full flex flex-col relative overflow-x-hidden">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.05);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #ff2e34;
    border-radius: 4px;
  }
</style>
