---
import cn from 'src/utils/cn';

const container = cn('mx-auto max-w-[1600px] px-6 md:px-10');
---

<section class="relative py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-ink"></div>
  <div class={container + ' relative text-white'}>

    <div class="flex items-baseline gap-6 mb-14 md:mb-20">
      <span class="section-counter" style="color: rgba(245,243,238,0.5)">[ 02 — En el centro ]</span>
      <span class="flex-1 h-px" style="background: rgba(245,243,238,0.15)"></span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7 reveal">
        <div class="font-ui text-[11px] tracking-[0.25em] uppercase text-primary mb-4 font-semibold">Cristocentrismo</div>
        <h2 class="font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] tracking-tight font-light">
          Toda nuestra fe se sostiene en una sola <em class="italic text-primary">Persona.</em>
        </h2>
        <p class="mt-8 font-ui text-[16px] md:text-[18px] leading-relaxed text-white/75 max-w-xl">
          Jesucristo es el eterno Hijo de Dios, nacido de María, que vivió sin pecado, murió en la cruz
          por su pueblo, resucitó al tercer día y volverá en gloria. Él es el centro absoluto de la
          Escritura, de la historia y de nuestra confesión.
        </p>
        <a
          href="#doctrine-jesucristo"
          data-open-doctrine="jesucristo"
          class="mt-10 inline-flex items-center gap-3 font-ui text-[13px] font-semibold tracking-wide uppercase ulink text-primary"
        >
          Leer la doctrina completa
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none">
            <path d="M2 6H10M10 6L6 2M10 6L6 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </a>
      </div>

      <div class="lg:col-span-5 reveal reveal-delay-2">
        <div class="relative fig-frame">
          <div class="corner tl" style="border-color: #f5f3ee"></div>
          <div class="corner tr" style="border-color: #f5f3ee"></div>
          <div class="corner bl" style="border-color: #f5f3ee"></div>
          <div class="corner br" style="border-color: #f5f3ee"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="relative w-full h-full flex items-center justify-center">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1px] h-[62%] bg-white/80"></div>
              <div class="absolute top-[42%] left-1/2 -translate-x-1/2 w-[34%] h-[1px] bg-white/80"></div>
              <div class="absolute bottom-6 left-6 font-mono text-[10px] tracking-[0.22em] uppercase text-white/50">1 Timoteo 2:5</div>
              <div class="absolute top-6 left-6 font-display italic text-white/30 text-xl">✦</div>
              <div class="absolute top-6 right-6 font-mono text-[10px] tracking-[0.2em] uppercase text-white/50 text-right">
                02<br /><span class="text-white/30">Christus</span>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-6 font-display italic font-light text-xl md:text-2xl text-white/85 leading-relaxed">
          "Porque hay un solo Dios, y un solo mediador entre Dios y los hombres, Jesucristo hombre."
        </div>
      </div>
    </div>
  </div>
</section>
