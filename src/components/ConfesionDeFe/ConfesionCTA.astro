---
import cn from 'src/utils/cn';
import type { Locale } from 'src/i18n/config';
import { localizePath } from 'src/i18n/utils';

interface Props {
  copy: any;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const container = cn('mx-auto max-w-[1600px] px-6 md:px-10');
---

<section class="relative py-24 md:py-32">
  <div class={container}>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7 reveal">
        <h3 class="font-display text-[clamp(2.2rem,5vw,4.2rem)] leading-[0.96] tracking-tight font-light">
          {copy.headlineBefore}<em class="italic text-primary">{copy.headlineEmphasis}</em>{copy.headlineAfter}
        </h3>
        <p class="mt-8 font-ui text-[15px] md:text-[17px] leading-relaxed text-ink/70 max-w-xl">
          {copy.body}
        </p>
      </div>
      <div class="lg:col-span-5 flex flex-col gap-4 reveal reveal-delay-2">
        <a href={localizePath('/#visitanos', locale)} class="cta-btn btn-primary flex items-center justify-between gap-3 rounded-2xl bg-ink text-paper px-7 py-6 font-ui text-[14px] font-semibold tracking-wide uppercase">
          <span class="flex flex-col gap-1 items-start">
            <span class="text-[10px] tracking-[0.25em] opacity-70">01</span>
            {copy.primary}
          </span>
          <svg class="cta-arrow" width="18" height="18" viewBox="0 0 12 12" fill="none">
            <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </a>
        <a href={localizePath('/#sermones', locale)} class="flex items-center justify-between gap-3 rounded-2xl border border-ink/15 px-7 py-6 font-ui text-[14px] font-semibold tracking-wide uppercase hover:bg-ink/5 transition-colors">
          <span class="flex flex-col gap-1 items-start">
            <span class="text-[10px] tracking-[0.25em] text-ink/50">02</span>
            {copy.secondary}
          </span>
          <svg width="18" height="18" viewBox="0 0 12 12" fill="none">
            <path d="M2 6H10M10 6L6 2M10 6L6 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
