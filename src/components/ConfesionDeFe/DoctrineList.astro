---
import cn from 'src/utils/cn';
import type { Doctrine } from 'src/data/doctrines';
import DoctrineRow from './DoctrineRow.astro';

interface Props {
  doctrines: Doctrine[];
  total: string;
}

const { doctrines, total } = Astro.props;
const container = cn('mx-auto max-w-[1600px] px-6 md:px-10');
---

<section id="doctrinas" class="relative py-20 md:py-28 bg-surface border-t border-ink/10">
  <div class={container}>
    <div class="flex items-baseline gap-6 mb-14 md:mb-20">
      <span class="section-counter">[ 01 — Nueve doctrinas ]</span>
      <span class="flex-1 h-px bg-ink/15"></span>
      <span class="section-counter hidden md:inline">Haz clic para expandir</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <!-- Sticky sidebar index -->
      <aside class="lg:col-span-3">
        <div class="lg:sticky lg:top-32">
          <div class="font-ui text-[10px] tracking-[0.25em] uppercase text-ink/50 mb-6">Índice</div>
          <ul id="doctIndex" class="flex flex-col gap-3 font-ui text-[14px] text-ink/60">
            {doctrines.map((d) => (
              <li>
                <a href={`#doctrine-${d.id}`} class="idx-item block" data-id={d.id}>
                  <span class="idx-num font-mono text-[11px] text-ink/40 mr-2">{d.number}</span>
                  <span>{d.title}</span>
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-12 pt-8 border-t border-ink/10">
            <div class="font-ui text-[10px] tracking-[0.25em] uppercase text-ink/50 mb-3">Recursos</div>
            <a href="#" class="block font-ui text-[13px] text-ink/60 ulink mb-2 w-fit">Descargar PDF</a>
            <a href="#" class="block font-ui text-[13px] text-ink/60 ulink mb-2 w-fit">Estudios bíblicos</a>
            <a href="#" class="block font-ui text-[13px] text-ink/60 ulink w-fit">Contactar al pastor</a>
          </div>
        </div>
      </aside>

      <!-- Accordion rows -->
      <div class="lg:col-span-9">
        {doctrines.map((d) => (
          <DoctrineRow doctrine={d} total={total} />
        ))}
      </div>

    </div>
  </div>
</section>
