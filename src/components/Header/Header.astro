---
import { Icon } from 'astro-icon/components';
import Nav from './Nav.astro';
import cn from '../../utils/cn.ts';

const classes = {
  header: cn(
    'fixed',
    'flex',
    'flex-col',
    'justify-end',
    'md:justify-center',
    'px-5',
    'md:px-0',
    'md:border-b-[0.1rem]',
    'md:border-primary-500',
    'h-[8rem]',
    'bg-transparent',
    'md:bg-white',
    'w-screen',
    'z-50'
  ),
  ul: cn(
    'flex',
    'flex-row',
    'text-primary-500',
    'font-bold',
    'font-montserrat',
    'justify-between'
  ),
  li: cn(
    'text-sm',
    'md:flex',
    'flex-row',
    'justify-center',
    'items-center',
    'mx-2',
    'hidden'
  ),
};
---

<header class={classes.header}>
  <div class="w-full h-2/3">
    <img
      src="/images/anclarojo.png"
      alt="logo"
      class="w-[3rem] h-[3rem] mt-[1rem] mb-[1rem] hidden"
    />
    <Icon
      name="mdi:menu"
      id="menu-toggle"
      class="w-[5rem] h-[3rem] mt-[1rem] mb-[1rem] fill-current bg-primary-500 px-2 text-white rounded-md md:hidden"
    />
    <Nav />
  </div>
  <div class="w-full flex flex-col justify-center items-center">
    <ul class={classes.ul}>
      <li class={classes.li}>
        <Icon name="mdi:google-maps" class="text-md" /> Av Dr Luis Alberto de Herrera
        3101
      </li>
      <li class={classes.li}>
        <Icon name="mdi:instagram" class="text-md" /> @iglesiaelancla
      </li>
    </ul>
  </div>
</header>
