---
import type {
  BlogArchiveItem,
  BlogArticle,
  BlogCategory,
  BlogPopularItem,
  BlogSeriesItem,
} from 'src/data/blog';
import BlogArticleGrid from './BlogArticleGrid.astro';
import BlogCategories from './BlogCategories.astro';
import BlogExplore from './BlogExplore.astro';
import BlogFeatured from './BlogFeatured.astro';
import BlogHero from './BlogHero.astro';
import BlogMarquee from './BlogMarquee.astro';
import BlogNewsletter from './BlogNewsletter.astro';
import BlogSeries from './BlogSeries.astro';
import type { Locale } from 'src/i18n/config';

interface Props {
  articles: BlogArticle[];
  categories: BlogCategory[];
  featured: BlogArticle;
  marqueeItems: string[];
  series: BlogSeriesItem[];
  popular: BlogPopularItem[];
  tags: string[];
  archive: BlogArchiveItem[];
  copy: any;
  locale: Locale;
}

const {
  articles,
  categories,
  featured,
  marqueeItems,
  series,
  popular,
  tags,
  archive,
  copy,
  locale,
} = Astro.props;
---

<article class="blog-page">
  <BlogHero totalArticles={142} categoryCount={categories.length - 1} copy={copy.hero} locale={locale} />
  <BlogMarquee items={marqueeItems} />
  <BlogFeatured article={featured} copy={copy.featured} locale={locale} />
  <BlogCategories categories={categories} copy={copy.categories} />
  <BlogArticleGrid articles={articles} categories={categories} copy={copy.articles} locale={locale} />
  <BlogSeries series={series} copy={copy.series} locale={locale} />
  <BlogExplore
    popular={popular}
    tags={tags}
    archive={archive}
    author={featured.author}
    copy={copy.explore}
    locale={locale}
  />
  <BlogNewsletter copy={copy.newsletter} />
</article>
