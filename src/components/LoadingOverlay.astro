---
---

<div
  id="siteLoader"
  class="site-loader grain"
  role="status"
  aria-live="polite"
  aria-label="Cargando el sitio"
  data-site-loader
  transition:persist
>
  <div class="site-loader-grid grid-bg" aria-hidden="true"></div>

  <div class="ldr-top">
    <div class="ldr-brand">
      <div>
        <div class="kicker">Iglesia Bautista</div>
        <div class="mark">El Ancla</div>
      </div>
    </div>
    <div class="ldr-meta">
      <span><span class="dot"></span>Cargando</span>
      <span class="hide-sm">Montevideo · UY</span>
      <span id="ldrSession">SESS · 00:00</span>
    </div>
  </div>

  <div class="ldr-stage">
    <div class="ldr-glyph" aria-hidden="true">
      <svg viewBox="-40 -40 280 340" preserveAspectRatio="xMidYMid meet">
        <circle class="ring-track" cx="100" cy="130" r="155"></circle>
        <circle id="ringProg" class="ring-prog" cx="100" cy="130" r="155"></circle>

        <g id="ldrTicks"></g>

        <g transform="translate(0,254) scale(0.10101,-0.10101)">
          <path
            id="logoPath"
            class="logo-path"
            d="M915 2510 c-9 -10 -19 -41 -22 -67 -6 -67 -32 -320 -39 -369 l-5 -41 -85 -7 c-204 -17 -554 -85 -626 -122 -38 -20 -36 -48 7 -91 34 -34 38 -35 88 -29 29 3 75 10 102 16 64 12 484 35 491 27 4 -3 2 -82 -5 -174 -20 -302 -33 -733 -29 -976 2 -130 2 -237 1 -237 0 0 -37 64 -80 142 -169 303 -346 565 -438 646 -25 22 -71 52 -101 66 -62 30 -150 53 -160 43 -11 -10 33 -121 101 -258 246 -490 595 -913 871 -1052 l51 -26 20 22 c36 40 137 198 285 447 254 427 409 645 559 784 l71 66 -38 17 c-27 12 -66 18 -124 18 -75 0 -93 -4 -151 -31 -168 -80 -335 -308 -489 -671 -32 -74 -60 -136 -62 -139 -6 -5 -10 31 -38 336 -27 303 -40 551 -40 783 l0 199 143 -6 c215 -10 402 -25 504 -41 103 -17 132 -11 159 30 12 19 15 40 12 81 -5 64 -29 101 -79 126 -54 27 -262 41 -510 36 l-219 -5 6 66 c3 36 10 93 15 126 5 33 9 97 9 143 0 79 -2 85 -29 113 -36 36 -97 41 -126 9z"
          ></path>
        </g>
      </svg>
    </div>

    <div class="ldr-caption">
      <div class="verse">
        Tenemos esta esperanza como firme y segura <em>ancla del alma.</em>
      </div>
      <div class="ref">— Hebreos 6:19</div>
    </div>
  </div>

  <div class="ldr-bottom">
    <div class="ldr-progress">
      <div class="ldr-progress-row">
        <div class="ldr-percent">
          <span id="ldrPct">0</span><span class="pct-sym">%</span>
        </div>
        <div class="ldr-state">
          <div class="ldr-state-line">
            <span class="arrow">→</span>
            <span class="ldr-state-text" id="ldrStateText">Trazando la cruz</span>
          </div>
          <div class="ldr-state-sub" id="ldrStateSub">Inicializando · 0 / 4</div>
        </div>
      </div>

      <div class="ldr-bar">
        <div class="ldr-bar-fill" id="ldrBarFill"></div>
        <div class="ldr-bar-ticks" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>
</div>

<noscript>
  <style>
    .site-loader {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import { initLoadingOverlay } from 'src/scripts/loading';

  initLoadingOverlay();
</script>
