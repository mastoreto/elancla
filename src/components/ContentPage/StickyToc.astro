---
import type { ContentSection, ContentShortcut } from 'src/data/contentPages';

interface Props {
  sections: ContentSection[];
  shortcuts?: ContentShortcut[];
}

const { sections, shortcuts = [] } = Astro.props;
---

<aside class="lg:col-span-3 order-2 lg:order-1">
  <div class="lg:sticky lg:top-32">
    <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-ink/45 mb-4">[ Índice ]</div>
    <nav id="toc" class="flex flex-col" aria-label="Índice de página">
      {
        sections.map((section, index) => (
          <a href={`#${section.id}`} class="content-toc-link" data-target={section.id}>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            {section.tocLabel}
          </a>
        ))
      }
    </nav>

    {
      shortcuts.length > 0 && (
        <div class="hidden lg:block mt-10 pt-8 border-t border-ink/10">
          <div class="font-mono text-[10px] tracking-[0.22em] uppercase text-ink/45 mb-4">[ Atajos ]</div>
          <div class="flex flex-col gap-2">
            {shortcuts.map((shortcut) => (
              <a href={shortcut.href} class="font-ui text-[12.5px] text-ink/70 ulink w-fit">
                {shortcut.label}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</aside>
