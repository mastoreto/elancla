---
import type { ContentInlineText } from 'src/data/contentPages';

interface Props {
  value: ContentInlineText;
  emphasisClass?: string;
}

const { value, emphasisClass = 'italic text-primary font-normal' } = Astro.props;
---

{
  value.text ? (
    value.text
  ) : (
    <>
      {value.before}
      {value.emphasis && <em class={emphasisClass}>{value.emphasis}</em>}
      {value.after}
    </>
  )
}
