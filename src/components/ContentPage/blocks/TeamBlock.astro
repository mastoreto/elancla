---
import type { ContentTeamBlock } from 'src/data/contentPages';

interface Props {
  block: ContentTeamBlock;
}

const { block } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12 mt-12">
  {
    block.people.map((person) => (
      <article class="content-person-card flex flex-col">
        <div class="content-placeholder-img ratio-4-5 w-full" style={person.tint ? `--placeholder-tint: ${person.tint}` : undefined}>
          <span class="glyph">{person.initials}</span>
        </div>
        <div class="mt-5 font-mono text-[10px] tracking-[0.22em] uppercase text-primary">{person.role}</div>
        <h3 class="font-display text-2xl mt-2 font-medium">{person.name}</h3>
        <p class="font-ui text-[13.5px] text-ink/65 leading-relaxed mt-2">{person.bio}</p>
      </article>
    ))
  }
</div>
